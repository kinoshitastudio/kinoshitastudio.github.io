{
  "manifest_version": 3,
  "name": "ENOUGH",
  "version": "0.2.0",
  "description": "Hide social media metrics. Numbers don't define you.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.instagram.com/*",
        "https://www.threads.net/*",
        "https://threads.net/*",
        "https://www.threads.com/*",
        "https://threads.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://www.linkedin.com/*",
        "https://bsky.app/*",
        "https://note.com/*",
        "https://soundcloud.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ENOUGH",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
