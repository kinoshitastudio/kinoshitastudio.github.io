      <div class="row"><label>揺れ</label><input type="range" data-p="sway" min="0" max="100" step="1" value="64"><span class="val"></span></div>
      <div class="row"><label>ふるえ</label><input type="range" data-p="twitch" min="0" max="100" step="1" value="52"><span class="val"></span></div>
