      <div class="tk-count" id="tk-count">—</div>
      <div class="mod">クリック＝選ぶ／ダブルクリック＝ミュート<br>下のエンジンは選んだトラックにかかる</div>
    </div>
  </div>

  <!-- 04 SHIFT -->
  <div class="unit" data-unit="shift">
    <div class="unit-head">
      <span class="led"></span><span class="unit-idx">04</span>
      <span class="unit-name">SHIFT</span><span class="unit-jp" id="shift-tk">漢字</span>
    </div>
    <div class="unit-body">
      <div class="row"><label>沈む</label><input type="range" data-t="sink" min="-100" max="100" step="1" value="0"><span class="val"></span></div>
      <div class="row"><label>開く</label><input type="range" data-t="burst" min="-100" max="100" step="1" value="0"><span class="val"></span></div>
