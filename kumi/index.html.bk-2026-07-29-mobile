<script type="module">
import * as THREE from 'three';

/* ═══════════════════════════════════════════════════════════
   組 KUMI — 日本語は3つの層でできている

   読むとき、脳は無意識に漢字だけ拾って意味を取り、かなで文法を
   繋いでいる。その層分けを、目に見える3トラックにする。
   日本語でしか成立しない。

   CHAIN : AUDIO → TEXT → SORT → SHIFT → BLEED → TAPE → TINT
   05〜07 は HORI から持ち出した段（版の契約さえ守れば中身を問わない）

   ⭐ 版の契約（HORI から拡張）
      R = インク量 / G,B = 法線xy / A = トラックID
      A を足したことで TINT がトラックごとに色を変えられる
   ═══════════════════════════════════════════════════════════ */

const DEFAULT_TEXT =
`あのイーハトーヴォのすきとおった風、夏でも底に冷たさをもつ青いそら、うつくしい森で飾られたモリーオ市、郊外のぎらぎらひかる草の波。`;

/* ── PARAMS ─────────────────────────────────────────────── */
const P = {
  amount:65, smoothing:70,
  font:1, size:17, tracking:4, leading:128, vertical:0,
  breath:78, sway:64, twitch:52, lean:60, rate:45,
  spread:26, decay:85, feed:100, flip:0, cycles:0, pulse:30,
  levels:9, grain:24, bias:50, invert:0,
  tintMode:1, hue:196, sat:76, vivid:72, shift:50, bg:40, bgsat:0,
};
const ON = { audio:false, text:true, sort:true, shift:true, iki:true,
             bleed:false, tape:true, tint:false };

/* ── TRACKS — 日本語の層。ここがこのプロダクトの本体 ────────
   漢字=意味を運ぶ / かな=文法を繋ぐ / カナ=外から来た異物 / その他=約物・英数
   ──────────────────────────────────────────────────────── */
const TRACKS = [
  { id:0, name:'漢字' }, { id:1, name:'かな' },
  { id:2, name:'カナ' }, { id:3, name:'その他' },
];
// トラックごとに同じツマミを別々に持つ（P と同じで、ここはベース値）
// ⭐ 初期値で既に3層が剥がれている。回せば「1行の文が3枚の地層でできている」のが
//    一目で見える。ここが伝わらないとこのプロダクトは何も言っていないのと同じ。
const T = [
  { sink: 30, jitter: 0, rot:0, scale:112, wave: 6, burst: 0, speed:26 },  // 漢字 — 手前に立つ。意味を運ぶ層
  { sink:  0, jitter: 0, rot:0, scale: 94, wave:12, burst: 0, speed:44 },  // かな — 真ん中を流れる。文法を繋ぐ層
  { sink:-32, jitter: 4, rot:0, scale:104, wave:20, burst: 0, speed:66 },  // カナ — 奥で浮つく。外から来た異物
  { sink:-10, jitter: 0, rot:0, scale: 78, wave: 0, burst: 0, speed:35 },  // その他 — 約物。沈めて黙らせる
];
const MUTE = [false, false, false, false];
let SEL = 0;

/* 文字をどの層に振るか — これが SORT の中身 */
function trackOf(ch){
  const c = ch.codePointAt(0);
  if((c>=0x4E00&&c<=0x9FFF)||(c>=0x3400&&c<=0x4DBF)||c===0x3005) return 0; // 漢字
  if(c>=0x3041&&c<=0x309F) return 1;                                        // ひらがな
  if((c>=0x30A0&&c<=0x30FF)||(c>=0xFF66&&c<=0xFF9F)) return 2;              // カタカナ
  return 3;                                                                 // 約物・英数
}

/* ── MOD — 音が叩いた量。P/T はベース、M は offset ────────── */
const M = { tk:[0,0,0,0], kick:0, spread:0, flip:0, spin:0 };

/* ── ENGINE DESCRIPTORS ─────────────────────────────────────
   受け取るのは常に同じ鞄 U = {ink, bleed, post}。
   HORI と同じ規約。ENGINES に1エントリ足せばエンジンが増える。
   ──────────────────────────────────────────────────────── */
const ENGINES = [
  { id:'audio', jp:'鳴る',
    apply(){ analyse(); },
    bypass(){ M.tk = [0,0,0,0]; M.kick = M.spread = M.flip = M.spin = 0; } },

  { id:'text', jp:'流す',
    apply(){ /* レイアウト時に読まれる（geometry 側） */ },
    bypass(){} },

  { id:'sort', jp:'分ける',
    apply(U){ for(let i=0;i<4;i++) U.ink.uMute.value[i] = MUTE[i] ? 1 : 0; },
    bypass(U){ for(let i=0;i<4;i++) U.ink.uMute.value[i] = 0; } },

  { id:'shift', jp:'揺らす',
    apply(U){
      for(let i=0;i<4;i++){
        const t = T[i], m = M.tk[i];
        U.ink.uSink.value[i]   = t.sink   / 100 * 900  + m * 620;
        U.ink.uJitter.value[i] = t.jitter / 100 * 520  + m * 460;
        U.ink.uRot.value[i]    = t.rot    / 100 * 6.28 + m * 3.4;
        U.ink.uScale.value[i]  = t.scale  / 100        + m * 1.6;
        U.ink.uWave.value[i]   = t.wave   / 100 * 420  + m * 380;
        U.ink.uBurst.value[i]  = t.burst  / 100 * 900  + m * 700;
        U.ink.uSpeed.value[i]  = t.speed  / 100 * 3;
      }
    },
    bypass(U){
      for(let i=0;i<4;i++){
        U.ink.uSink.value[i] = 0; U.ink.uJitter.value[i] = 0;
        U.ink.uRot.value[i] = 0;  U.ink.uScale.value[i] = 1;
        U.ink.uWave.value[i] = 0; U.ink.uBurst.value[i] = 0;
      }
    } },

  { id:'iki', jp:'生きる',
    apply(U){
      U.ink.uBreath.value = (P.breath / 100) * 0.9 + M.kick * (P.amount/100) * 0.8;
      U.ink.uSway.value   = (P.sway   / 100) * 34  + M.tk[1] * 40;
      U.ink.uTwitch.value = (P.twitch / 100) * 90  + M.kick * (P.amount/100) * 70;
      U.ink.uLean.value   = (P.lean   / 100) * 0.7;
      U.ink.uRate.value   = P.rate / 100 * 2.4;
    },
    bypass(U){
      U.ink.uBreath.value = 0; U.ink.uSway.value = 0;
      U.ink.uTwitch.value = 0; U.ink.uLean.value = 0;
    } },

  // ── ここから下は HORI から持ち出した段。中身を問わない ──
  { id:'bleed', jp:'滲む',
    apply(U){
      U.bleed.uSpread.value = Math.max(P.spread + M.spread, 0) / 100 * 3.0;
      U.bleed.uDecay.value  = 0.975 + P.decay / 100 * 0.025;
      U.bleed.uFeed.value   = P.feed / 100;
      U.post.uFlip.value    = Math.min(Math.max(P.flip + M.flip, 0), 100) / 100;
      U.post.uCycles.value  = P.cycles / 10;
      U.post.uPulse.value   = P.pulse / 100 * 4;
    },
    bypass(U){ U.post.uFlip.value = 0; U.post.uCycles.value = 0; } },

  { id:'tape', jp:'通す',
    apply(U){
      U.post.uLevels.value = P.levels;
      U.post.uGrain.value  = P.grain / 100;
      U.post.uBias.value   = (P.bias - 50) / 100;
      U.post.uInvert.value = P.invert;
    },
    bypass(U){
      U.post.uLevels.value = 0; U.post.uGrain.value = 0;
      U.post.uBias.value = 0; U.post.uInvert.value = P.invert;
    } },

  { id:'tint', jp:'差す',
    apply(U){
      U.post.uTintMode.value = P.tintMode;
      U.post.uHue.value      = P.hue / 360;
      U.post.uSat.value      = P.sat / 100;
      U.post.uVal.value      = 0.34 + P.vivid / 100 * 0.66;
      U.post.uShift.value    = P.shift / 100 * 2.0;
      U.post.uBg.value       = P.bg / 360;
      U.post.uBgSat.value    = P.bgsat / 100;
    },
    bypass(U){
      U.post.uTintMode.value = 0; U.post.uSat.value = 0; U.post.uBgSat.value = 0;
    } },
];

