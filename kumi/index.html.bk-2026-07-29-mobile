function placeCamera(){
  cam.az += (cam.tAz - cam.az) * 0.12;
  cam.el += (cam.tEl - cam.el) * 0.12;
  cam.zoom += (cam.tZoom - cam.zoom) * 0.12;
  if(Math.abs(camera.zoom - cam.zoom) > 1e-4){
    camera.zoom = cam.zoom; camera.updateProjectionMatrix();
  }
  camera.position.set(
    cam.dist * Math.cos(cam.el) * Math.sin(cam.az),
    cam.dist * Math.sin(cam.el),
    cam.dist * Math.cos(cam.el) * Math.cos(cam.az));
  camera.lookAt(0, 0, 0);
}

/* ── GLYPH ATLAS — 字形をテクスチャに焼く ────────────────── */
const FONTS = ['"Zen Kaku Gothic New"', '"Shippori Mincho"', '"Zen Old Mincho"'];
const CELL = 96;
let atlasTex = null, atlasMap = new Map(), atlasCols = 0;

function buildAtlas(chars){
  const list = [...new Set(chars)].filter(c => c.trim().length);
  atlasCols = Math.ceil(Math.sqrt(list.length)) || 1;
  const rows = Math.ceil(list.length / atlasCols) || 1;
  const cv = document.createElement('canvas');
  cv.width = atlasCols * CELL; cv.height = rows * CELL;
  const g = cv.getContext('2d');
  g.fillStyle = '#000'; g.fillRect(0, 0, cv.width, cv.height);
  g.fillStyle = '#fff';
  g.textAlign = 'center'; g.textBaseline = 'middle';
  g.font = `500 ${CELL * 0.78}px ${FONTS[P.font]}, sans-serif`;

  atlasMap = new Map();
  list.forEach((ch, i) => {
    const cx = (i % atlasCols) * CELL, cy = Math.floor(i / atlasCols) * CELL;
    g.fillText(ch, cx + CELL/2, cy + CELL/2);
    atlasMap.set(ch, i);
  });

  if(atlasTex) atlasTex.dispose();
  atlasTex = new THREE.CanvasTexture(cv);
  atlasTex.minFilter = THREE.LinearFilter;
  atlasTex.magFilter = THREE.LinearFilter;
  atlasTex.generateMipmaps = false;
  atlasTex.flipY = false;              // ⚠️ これを切らないと別の字が貼られる
  inkUniforms.tAtlas.value = atlasTex;
  inkUniforms.uAtlasGrid.value.set(atlasCols, rows);
}

/* ── INK — 字形を版に焼く ───────────────────────────────── */
const inkUniforms = {
  tAtlas:     { value:null },
  uAtlasGrid: { value:new THREE.Vector2(1,1) },
  uTime:      { value:0 },
  uSink:      { value:[0,0,0,0] },
  uJitter:    { value:[0,0,0,0] },
  uRot:       { value:[0,0,0,0] },
  uScale:     { value:[1,1,1,1] },
  uWave:      { value:[0,0,0,0] },
  uBurst:     { value:[0,0,0,0] },
  uBreath:    { value:0 },
  uSway:      { value:0 },
  uTwitch:    { value:0 },
  uRate:      { value:1 },
  uLean:      { value:0 },
  uSpeed:     { value:[1,1,1,1] },
  uMute:      { value:[0,0,0,0] },
};

const inkMaterial = new THREE.ShaderMaterial({
  uniforms: inkUniforms,
  side: THREE.DoubleSide,
  transparent: false,
  vertexShader:`
    attribute vec3  aCenter;   // その字の据わる場所
    attribute vec2  aCorner;   // 四隅（-.5..+.5）— UV にも使うので生のまま
    attribute float aSize;     // その字の大きさ
    attribute float aTrack;    // どの層の字か
    attribute float aIndex;    // 何文字目か（位相をずらす種）
    attribute vec2  aCell;     // アトラスのどこか

    uniform float uTime;
    uniform float uSink[4], uJitter[4], uRot[4], uScale[4], uWave[4], uSpeed[4], uMute[4], uBurst[4];
    uniform float uBreath, uSway, uTwitch, uRate, uLean;
    uniform vec2  uAtlasGrid;

    varying vec2  vUv;
    varying float vTrack;
    varying float vMute;

    float hash(float n){ return fract(sin(n * 78.233) * 43758.5453); }

    /* ── 息 ────────────────────────────────────────────────
       生き物に見えないのは、全部が同じ周期で同じ速さで、永遠に
       同じ形を繰り返すから。だから：
       - 周期を互いに割り切れない比で重ねる（二度と同じ形に戻らない）
       - 一字ごとに位相をずらす（個体差）
       - たまに一字だけびくっとさせる（ためらい・不随意）
       ────────────────────────────────────────────────── */
    float breathe(float seed, float t){
      float ph = hash(seed) * 6.2831853;
      return sin(t * 0.91 + ph) * 0.54
           + sin(t * 0.413 + ph * 1.7) * 0.31
           + sin(t * 0.2371 + ph * 2.9) * 0.15;   // 0.91 : 0.413 : 0.2371 は割り切れない
    }
    float twitch(float seed, float t){
      float slot = floor(t * 0.7 + hash(seed * 5.7) * 10.0);
      float fire = step(0.93, hash(slot * 1.7 + seed * 13.0));   // ほとんどの字は動かない
      float k = fract(t * 0.7 + hash(seed * 5.7) * 10.0);
      return fire * exp(-k * 9.0) * (hash(slot + seed) - 0.5);   // びくっ → すぐ収まる
    }

    void main(){
      int t = int(aTrack + 0.5);
      float sink   = uSink[t];
      float jitter = uJitter[t];
      float rot    = uRot[t];
      float scale  = max(uScale[t], 0.02);
      float wave   = uWave[t];
      float speed  = uSpeed[t];
      vMute  = uMute[t];
      vTrack = aTrack;

      // 四隅を回して太らせる
      float a = rot + (hash(aIndex) - 0.5) * jitter * 0.06;
      float c = cos(a), s = sin(a);
      vec2 q = aCorner * aSize * scale;
      vec2 r = vec2(q.x * c - q.y * s, q.x * s + q.y * c);

      vec3 pos = aCenter + vec3(r, 0.0);

      // ── 息 — ここから下が「生きている」の実体 ──
      float tt = uTime * uRate;
      float b  = breathe(aIndex * 2.3, tt);

      // 呼吸 — 一字ごとに違う位相で膨らんで縮む
      pos.xy += r * b * uBreath;

      // 揺れ — 止まっていられない。周期が噛み合わないので同じ形に戻らない
      pos.x += breathe(aIndex * 7.1 + 3.0, tt * 0.6) * uSway;
      pos.y += breathe(aIndex * 11.3 + 9.0, tt * 0.6) * uSway;
      pos.z += breathe(aIndex * 4.7 + 1.0, tt * 0.4) * uSway * 0.7;

      // ふるえ — たまに一字だけびくっとして、すぐ収まる
      float tw = twitch(aIndex, tt);
      pos.x += tw * uTwitch;
      pos.y += twitch(aIndex + 100.0, tt) * uTwitch;

      // 傾ぐ — 息に合わせて上体が振れる。生き物は真っ直ぐ立っていない
      float ln = b * uLean;
      float lc = cos(ln), ls = sin(ln);
      vec2 rr = vec2(r.x * lc - r.y * ls, r.x * ls + r.y * lc);
      pos.xy += (rr - r);

      // 散る — 字ごとに違う方へ
      pos.x += (hash(aIndex * 1.7) - 0.5) * jitter;
      pos.y += (hash(aIndex * 3.1) - 0.5) * jitter;

      // 開く — 組の真ん中から放射状に押し出す。層ごとに違う速さで広がる
      float burst = uBurst[t];
      if(abs(burst) > 0.001){
        vec2 dir = length(aCenter.xy) > 1.0 ? normalize(aCenter.xy) : vec2(0.0, 1.0);
        pos.xy += dir * burst;
      }

      // 沈む — その層ごと奥へ / 手前へ
      pos.z += sink;

      // 波 — 行に沿ってうねる。層ごとに位相が違うので、同じ拍でバラバラに動く
      pos.z += sin(aCenter.x * 0.012 + aIndex * 0.25 + uTime * speed + aTrack * 2.1) * wave;

      // aCorner.y は上が +。テクスチャの V は上から下なので反転して数える
      vUv = vec2(aCell.x + aCorner.x + 0.5,
                 aCell.y + (0.5 - aCorner.y)) / uAtlasGrid;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
  `,
  fragmentShader:`
    precision highp float;
    uniform sampler2D tAtlas;
    varying vec2  vUv;
    varying float vTrack;
    varying float vMute;
    void main(){
      if(vMute > 0.5) discard;
      float ink = texture2D(tAtlas, vUv).r;
      if(ink < 0.04) discard;
      // ⭐ 版の契約：R = インク量 / GB = 法線xy / A = トラックID
      gl_FragColor = vec4(ink, 0.5, 0.5, (vTrack + 0.5) / 4.0);
    }
  `
});

/* ── LAYOUT — 文字を置く（TEXT の中身） ─────────────────── */
let mesh = null;
function layout(){
  const text = document.getElementById('src-text').value || '';
  const chars = [...text].filter(c => c !== '\n');
  if(!atlasTex || [...new Set(chars)].some(c => c.trim() && !atlasMap.has(c))) buildAtlas(chars);

  const size = P.size * 2.2;
  const adv  = size + P.tracking * 0.9;
  const lead = size * (P.leading / 100);
  const vert = P.vertical > 0.5;
  const perLine = Math.max(Math.floor(1100 / adv), 4);

  const cen=[], cor=[], siz=[], trk=[], idx=[], cel=[], ind=[];
  let n = 0, col = 0, line = 0;

  for(const ch of text){
    if(ch === '\n'){ line++; col = 0; continue; }
    if(!ch.trim()){ col++; continue; }
    const ai = atlasMap.get(ch); if(ai === undefined) continue;

    if(col >= perLine){ line++; col = 0; }
    // 横組は右へ流れて下へ折り返す。縦組は下へ流れて左へ折り返す（日本語の作法）
    const x = vert ? -line * lead : (col * adv - perLine * adv / 2);
    const y = vert ? (perLine * adv / 2 - col * adv) : -line * lead;

    const base = cen.length / 3;
    const C = [[-0.5,0.5],[0.5,0.5],[0.5,-0.5],[-0.5,-0.5]];
    for(const [ox, oy] of C){
      cen.push(x, y, 0);
      cor.push(ox, oy);
      siz.push(size);
      trk.push(trackOf(ch));
      idx.push(n);
      cel.push(ai % atlasCols, Math.floor(ai / atlasCols));
    }
    ind.push(base, base+1, base+2, base, base+2, base+3);
    n++; col++;
  }

  // ⭐ 組版を原点中心に寄せる（縦センタリング）。横組は原点が上端に来て、
  //    原点中心のカメラだと組版が画面の下半分に寄る＝それを防ぐ。
  if(n){
    let ymin=Infinity, ymax=-Infinity, xmin=Infinity, xmax=-Infinity;
    for(let i=0;i<cen.length;i+=3){ const cx0=cen[i], cy0=cen[i+1];
      if(cy0<ymin)ymin=cy0; if(cy0>ymax)ymax=cy0; if(cx0<xmin)xmin=cx0; if(cx0>xmax)xmax=cx0; }
    const mx=(xmin+xmax)/2, my=(ymin+ymax)/2;
    for(let i=0;i<cen.length;i+=3){ cen[i]-=mx; cen[i+1]-=my; }
  }

  if(mesh){ scene.remove(mesh); mesh.geometry.dispose(); }
  if(!n){ mesh = null; countTracks(); return; }

  const g = new THREE.BufferGeometry();
  g.setAttribute('aCenter', new THREE.Float32BufferAttribute(cen, 3));
  g.setAttribute('aCorner', new THREE.Float32BufferAttribute(cor, 2));
  g.setAttribute('aSize',   new THREE.Float32BufferAttribute(siz, 1));
  g.setAttribute('aTrack',  new THREE.Float32BufferAttribute(trk, 1));
  g.setAttribute('aIndex',  new THREE.Float32BufferAttribute(idx, 1));
  g.setAttribute('aCell',   new THREE.Float32BufferAttribute(cel, 2));
  g.setAttribute('position', new THREE.Float32BufferAttribute(new Float32Array(cen.length), 3));
  g.setIndex(ind);
  g.computeBoundingSphere = () => { g.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 4000); };
  g.computeBoundingSphere();

  mesh = new THREE.Mesh(g, inkMaterial);
  mesh.frustumCulled = false;
  scene.add(mesh);
  countTracks();
}

function countTracks(){
  const text = document.getElementById('src-text').value || '';
  const c = [0,0,0,0];
  for(const ch of text) if(ch.trim()) c[trackOf(ch)]++;
  const tot = c.reduce((a,b)=>a+b,0) || 1;
  document.getElementById('tk-count').textContent =
    c.map((v,i)=>`${TRACKS[i].name} ${Math.round(v/tot*100)}%`).join(' / ');
}

/* ── BUFFERS / BLEED / TAPE — HORI と同じ ───────────────── */
const rtOpts = { minFilter:THREE.LinearFilter, magFilter:THREE.LinearFilter, type:THREE.HalfFloatType };
const rt  = new THREE.WebGLRenderTarget(1, 1, { ...rtOpts, depthBuffer:true });
let   rtA = new THREE.WebGLRenderTarget(1, 1, { ...rtOpts, depthBuffer:false });
let   rtB = new THREE.WebGLRenderTarget(1, 1, { ...rtOpts, depthBuffer:false });

const fsQuad = new THREE.PlaneGeometry(2, 2);
const fsCam  = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
const FS_VERT = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy,0.,1.); }`;

const bleedUniforms = {
  tPrev:{value:null}, tSrc:{value:rt.texture},
  uSpread:{value:.78}, uDecay:{value:.99}, uFeed:{value:1},
  uRes:{value:new THREE.Vector2(1,1)},
};
const bleedScene = new THREE.Scene();
bleedScene.add(new THREE.Mesh(fsQuad, new THREE.ShaderMaterial({
  uniforms: bleedUniforms, vertexShader: FS_VERT,
  fragmentShader:`
    precision highp float;
    uniform sampler2D tPrev, tSrc;
    uniform float uSpread, uDecay, uFeed;
    uniform vec2 uRes;
    varying vec2 vUv;
    void main(){
      vec2 px = 1.0 / uRes;
      // 一番濃い画素を A（トラックID）ごと連れてくる → 滲みが層の色を保ったまま広がる
      vec4 m = texture2D(tPrev, vUv);
      for(int i = 0; i < 8; i++){
        float a = float(i) * 0.7853981634;
        vec4 s = texture2D(tPrev, vUv + vec2(cos(a), sin(a)) * px * uSpread);
        if(s.r > m.r) m = s;
      }
      float b = (texture2D(tPrev, vUv + vec2( px.x,0.)).r + texture2D(tPrev, vUv + vec2(-px.x,0.)).r
               + texture2D(tPrev, vUv + vec2(0., px.y)).r + texture2D(tPrev, vUv + vec2(0.,-px.y)).r) * 0.25;
      float v = mix(m.r, max(m.r, b), 0.5) * uDecay;
      vec4 src = texture2D(tSrc, vUv);
      if(src.r * uFeed > v) gl_FragColor = vec4(clamp(src.r * uFeed,0.,1.), src.g, src.b, src.a);
      else                  gl_FragColor = vec4(clamp(v,0.,1.), m.g, m.b, m.a);
    }
  `
})));

const postUniforms = {
  tSrc:{value:rt.texture},
  uLevels:{value:9}, uGrain:{value:.24}, uBias:{value:0}, uInvert:{value:0},
  uFlip:{value:0}, uCycles:{value:0}, uPulse:{value:0}, uT:{value:0},
  uTintMode:{value:0}, uHue:{value:0}, uSat:{value:0}, uVal:{value:.9},
  uShift:{value:.5}, uBg:{value:0}, uBgSat:{value:0},
  uTime:{value:0}, uRes:{value:new THREE.Vector2(1,1)},
};
const postScene = new THREE.Scene();
postScene.add(new THREE.Mesh(fsQuad, new THREE.ShaderMaterial({
  uniforms: postUniforms, vertexShader: FS_VERT,
  fragmentShader:`
    precision highp float;
    uniform sampler2D tSrc;
    uniform float uLevels, uGrain, uBias, uInvert, uFlip, uCycles, uPulse, uT, uTime;
    uniform float uTintMode, uHue, uSat, uVal, uShift, uBg, uBgSat;
    uniform vec2 uRes;
    varying vec2 vUv;

    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
    vec3 hsv2rgb(vec3 c){
      vec3 p = abs(fract(c.xxx + vec3(0., .6666667, .3333333)) * 6. - 3.);
      return c.z * mix(vec3(1.), clamp(p - 1., 0., 1.), c.y);
    }

    void main(){
      vec4 s = texture2D(tSrc, vUv);
      float v = s.r;
      float track = s.a * 4.0 - 0.5;      // ⭐ 版が運んできた層
      float vIn = v, vRing = 0.0;

      if(uFlip > 0.001 && v > 0.015){
        float k;
        if(uCycles > 0.01){
          float w = 0.5 + 0.5 * sin(v * uCycles * 6.2831853 - uT * uPulse);
          k = smoothstep(uFlip, uFlip + 0.16, w);
        } else {
          k = smoothstep(uFlip, uFlip + 0.03, v);
        }
        v = mix(v, 1.0 - v, k); vRing = k;
      }

      v = clamp(v + uBias, 0.0, 1.0);
      if(uGrain > 0.001){
        v = clamp(v + (hash(floor(vUv * uRes * 0.7) + uTime) - 0.5) * uGrain * 0.34, 0., 1.);
      }
      if(uLevels >= 2.0) v = floor(v * uLevels + 0.5) / uLevels;
      v = clamp(v, 0.0, 1.0);

      vec3 paper = vec3(0.957,0.949,0.933), sumi = vec3(0.039);
      vec3 bg = uInvert > 0.5 ? sumi : paper;
      vec3 fg = uInvert > 0.5 ? paper : sumi;

      if(uTintMode > 0.5 && uSat > 0.001){
        float h = uHue;
        if(uTintMode > 2.5 && uTintMode < 3.5){
          h = uHue + (floor(vIn * max(uLevels,2.0)) / max(uLevels,2.0)) * uShift * 3.0;
        } else if(uTintMode > 3.5){
          // ⭐ TRACK — 漢字・かな・カナが別の色になる。A を足したから書ける段
          h = uHue + floor(track + 0.5) * uShift * 0.5;
        }
        h += vRing * 0.1;
        fg = mix(fg, hsv2rgb(vec3(fract(h), uSat, uVal)), uSat);
      }
      if(uBgSat > 0.001){
        bg = mix(bg, hsv2rgb(vec3(fract(uBg), uBgSat, uInvert > 0.5 ? 0.30 : 0.94)), uBgSat);
      }
      gl_FragColor = vec4(mix(bg, fg, v), 1.0);
    }
  `
})));

/* ── AUDIO — HORI と同じ。音は M だけを書く ─────────────── */
let actx=null, analyser=null, freq=null, audioEl=null, micStream=null, fileName='';
const env = { low:0, mid:0, high:0 };
const beat = { env:0, prev:0 };

function ensureCtx(){
  if(actx) return;
  actx = new (window.AudioContext || window.webkitAudioContext)();
  analyser = actx.createAnalyser();
  analyser.fftSize = 1024; analyser.smoothingTimeConstant = .55;
  freq = new Uint8Array(analyser.frequencyBinCount);
}

/* ── サンプルビート（合成・外部ファイル不要）── アップロードせず即・音に反応を試せる */
let demoTimer = null, demoMaster = null;
function startDemo(){
  ensureCtx(); actx.resume(); stopSource();
  demoMaster = actx.createGain(); demoMaster.gain.value = 0.9;
  demoMaster.connect(analyser); demoMaster.connect(actx.destination);
  const bpm = 122, step = 60 / bpm / 2;                 // 8分音符
  let next = actx.currentTime + 0.06, s = 0;
  const noise = (() => { const b = actx.createBuffer(1, actx.sampleRate*0.2, actx.sampleRate);
    const d = b.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1; return b; })();
  const kick = t => { const o=actx.createOscillator(), g=actx.createGain();
    o.frequency.setValueAtTime(150,t); o.frequency.exponentialRampToValueAtTime(45,t+0.12);
    g.gain.setValueAtTime(1,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.2);
    o.connect(g); g.connect(demoMaster); o.start(t); o.stop(t+0.22); };
  const hat = t => { const src=actx.createBufferSource(); src.buffer=noise;
    const hp=actx.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=7000;
    const g=actx.createGain(); g.gain.setValueAtTime(0.35,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.05);
    src.connect(hp); hp.connect(g); g.connect(demoMaster); src.start(t); src.stop(t+0.06); };
  const bass = (t,f) => { const o=actx.createOscillator(), g=actx.createGain();
    o.type='sawtooth'; o.frequency.value=f;
    const lp=actx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=520;
    g.gain.setValueAtTime(0.28,t); g.gain.exponentialRampToValueAtTime(0.001,t+step*0.9);
    o.connect(lp); lp.connect(g); g.connect(demoMaster); o.start(t); o.stop(t+step); };
  const line = [55,0,82.4,0,55,0,73.4,49];              // ベースの音程
  demoTimer = setInterval(() => {
    if(!actx) return;
    while(next < actx.currentTime + 0.12){
      const b = s % 8;
      if(b===0 || b===3 || b===6) kick(next);
      if(b%2===1) hat(next);
      if(line[b]) bass(next, line[b]);
      next += step; s++;
    }
  }, 25);
}
function stopDemo(){
  if(demoTimer){ clearInterval(demoTimer); demoTimer = null; }
  if(demoMaster){ try{ demoMaster.disconnect(); }catch(_){} demoMaster = null; }
}

async function useMic(){
  if(!navigator.mediaDevices?.getUserMedia) throw Object.assign(new Error(), {name:'NoMediaDevices'});
  ensureCtx(); await actx.resume(); stopSource();
  setSourceLabel('許可待ち…');
  micStream = await Promise.race([
    navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}}),
    new Promise((_,rej)=>setTimeout(()=>rej(Object.assign(new Error(),{name:'TimedOut'})), 8000)),
  ]);
  actx.createMediaStreamSource(micStream).connect(analyser);
  setSourceLabel('MIC');
}
function useFile(file){
  ensureCtx(); actx.resume(); stopSource();
  audioEl = new Audio(URL.createObjectURL(file));
  audioEl.loop = true;
  const src = actx.createMediaElementSource(audioEl);
  src.connect(analyser); src.connect(actx.destination);
  audioEl.play();
  fileName = file.name.replace(/\.[^.]+$/,'').slice(0,12).toUpperCase();
  setSourceLabel(fileName);
}
function stopSource(){
  stopDemo();
  if(audioEl){ audioEl.pause(); audioEl = null; }
  if(micStream){ micStream.getTracks().forEach(t=>t.stop()); micStream = null; }
}
function calmMod(){
  M.tk=[0,0,0,0]; M.kick=M.spread=M.flip=M.spin=0;
  env.low=env.mid=env.high=0; beat.env=0; meter(0,0,0);
}
function toggleAudio(){
  const b = document.getElementById('btn-stop');
  if(audioEl){
    if(audioEl.paused){ actx?.resume(); audioEl.play(); armAudio();
      setSourceLabel(fileName); b.textContent='STOP'; b.classList.remove('on'); }
    else { audioEl.pause(); calmMod(); setSourceLabel('停止中');
      b.textContent='PLAY'; b.classList.add('on'); }
    return;
  }
  if(micStream){ stopAudio(); return; }
  setSourceLabel('音源なし');
}
function stopAudio(){
  stopSource(); calmMod(); fileName='';
  setSourceLabel('鳴る');
  const b = document.getElementById('btn-stop'); if(b) b.textContent='STOP';
  srcBtn(null);
}
function armAudio(){
  document.querySelector('[data-unit=audio]').classList.remove('off');
  ON.audio = true;
}
function srcBtn(id){
  ['btn-beat','btn-mic','btn-file','btn-stop'].forEach(b =>
    document.getElementById(b).classList.toggle('on', b === id));
}
function setSourceLabel(t){
  const el = document.getElementById('src-label'); if(el) el.textContent = t;
}
const MET = {};
function meter(l,m,h){
  if(!MET.low){ MET.low=document.getElementById('m-low'); MET.mid=document.getElementById('m-mid');
                MET.high=document.getElementById('m-high'); if(!MET.low) return; }
  MET.low.style.setProperty('--v', l.toFixed(3));
  MET.mid.style.setProperty('--v', m.toFixed(3));
  MET.high.style.setProperty('--v', h.toFixed(3));
}
function bandAvg(a,b){
  const n = freq.length; let s=0, c=0;
  for(let i=Math.floor(n*a); i<Math.floor(n*b); i++){ s+=freq[i]; c++; }
  return c ? s/c/255 : 0;
}
function analyse(){
  if(!analyser){ calmMod(); return; }
  analyser.getByteFrequencyData(freq);
  const k = 0.06 + (1 - P.smoothing/100) * 0.5;
  const lo = bandAvg(0,.07), md = bandAvg(.07,.34), hi = bandAvg(.34,1);
  env.low += (lo-env.low)*k; env.mid += (md-env.mid)*k; env.high += (hi-env.high)*k;
  beat.prev = lo;
  beat.env = Math.max(beat.env * 0.88, Math.max(lo - beat.prev, 0) * 6);
  const A = P.amount/100, kick = Math.min(beat.env, 1);

  // ⭐ 帯域が層に対応する。漢字は低音、かなは中音、カナは高音。
  //    日本語の3層が、音の3帯域にそのまま乗る。
  M.tk[0] = env.low  * A;
  M.tk[1] = env.mid  * A;
  M.tk[2] = env.high * A;
  M.tk[3] = kick * A * 0.6;
  M.kick = kick; M.spin = env.high * A * 0.02;
  M.spread = env.mid * A * 60;
  M.flip = kick * A * 50;
  meter(env.low, env.mid, env.high);
}

/* ── CHAIN ──────────────────────────────────────────────── */
const U = { ink:inkUniforms, bleed:bleedUniforms, post:postUniforms };
function runChain(){ for(const e of ENGINES) (ON[e.id] ? e.apply : e.bypass).call(e, U); }
function clearBleed(){
  for(const t of [rtA, rtB]){ renderer.setRenderTarget(t); renderer.clear(true,false,false); }
  renderer.setRenderTarget(null);
}

/* ── LOOP ───────────────────────────────────────────────── */
let spin = false;
let projA = 1;
function applyProj(){   // 正投影の範囲。cam.px/py で上下左右にパンできる
  const s2 = VIEW.size / 2, a = projA;
  camera.left = -s2*a + cam.px; camera.right = s2*a + cam.px;
  camera.top = s2 + cam.py; camera.bottom = -s2 + cam.py;
  camera.updateProjectionMatrix();
}
function resize(){
  const el = renderer.domElement;
  const w = el.clientWidth || innerWidth, h = el.clientHeight || innerHeight, dpr = Math.min(devicePixelRatio, 2);
  renderer.setSize(w, h);
  projA = w / h; applyProj();
  rt.setSize(w*dpr, h*dpr); rtA.setSize(w*dpr, h*dpr); rtB.setSize(w*dpr, h*dpr);
  postUniforms.uRes.value.set(w*dpr, h*dpr);
  bleedUniforms.uRes.value.set(w*dpr, h*dpr);
  clearBleed();
}
addEventListener('resize', resize);
resize();

function frame(t){
  requestAnimationFrame(frame);
  runChain();
  if(spin) cam.tAz += 0.0028 + M.spin;
  placeCamera();
  inkUniforms.uTime.value  = t * 0.001;
  postUniforms.uT.value    = t * 0.001;
  postUniforms.uTime.value = Math.floor(t * 0.024);

  renderer.setRenderTarget(rt); renderer.clear(); renderer.render(scene, camera);

  if(ON.bleed){
    bleedUniforms.tPrev.value = rtA.texture;
    renderer.setRenderTarget(rtB); renderer.render(bleedScene, fsCam);
    const s = rtA; rtA = rtB; rtB = s;
    postUniforms.tSrc.value = rtA.texture;
  } else {
    postUniforms.tSrc.value = rt.texture;
  }
  renderer.setRenderTarget(null); renderer.render(postScene, postCam());
}
const postCam = () => fsCam;

/* ── INPUT ──────────────────────────────────────────────── */
const el = renderer.domElement;
let orbitPrev = null, pinchPrev = 0, panPrev = null, twoFinger = false;
el.addEventListener('pointerdown', e => {
  try{ el.setPointerCapture(e.pointerId); }catch(_){}
  orbitPrev = { x:e.clientX, y:e.clientY };
});
el.addEventListener('pointermove', e => {
  if(!orbitPrev || twoFinger) return;
  if(e.shiftKey){                 // Shift+ドラッグ＝上下左右にパン
    const w=el.clientWidth||innerWidth, h=el.clientHeight||innerHeight, s2=VIEW.size/2;
    cam.px -= (e.clientX - orbitPrev.x) * (2*s2*projA/w);
    cam.py += (e.clientY - orbitPrev.y) * (2*s2/h);
    applyProj();
  } else {
    cam.tAz -= (e.clientX - orbitPrev.x) * 0.006;
    cam.tEl = THREE.MathUtils.clamp(cam.tEl + (e.clientY - orbitPrev.y) * 0.006, -1.35, 1.35);
  }
  orbitPrev = { x:e.clientX, y:e.clientY };
});
const up = () => { orbitPrev = null; };
el.addEventListener('pointerup', up);
el.addEventListener('pointercancel', up);
el.addEventListener('touchend', e => { if(e.touches.length < 2){ twoFinger=false; panPrev=null; pinchPrev=0; } });
el.addEventListener('dblclick', () => { cam.px=0; cam.py=0; applyProj(); });   // ダブルクリックでパンを戻す
el.addEventListener('wheel', e => {
  e.preventDefault();
  cam.tZoom = THREE.MathUtils.clamp(cam.tZoom * (1 - e.deltaY * 0.0018), 0.06, 90);
}, { passive:false });
el.addEventListener('touchstart', e => {
  if(e.touches.length === 2){
    twoFinger = true; orbitPrev = null;
    pinchPrev = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,
                           e.touches[0].clientY - e.touches[1].clientY);
    panPrev = { x:(e.touches[0].clientX+e.touches[1].clientX)/2, y:(e.touches[0].clientY+e.touches[1].clientY)/2 };
  }
}, { passive:false });
el.addEventListener('touchmove', e => {
  if(e.touches.length === 2){
    e.preventDefault();
    const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,
                         e.touches[0].clientY - e.touches[1].clientY);
    const cx=(e.touches[0].clientX+e.touches[1].clientX)/2, cy=(e.touches[0].clientY+e.touches[1].clientY)/2;
    if(pinchPrev) cam.tZoom = THREE.MathUtils.clamp(cam.tZoom * (d/pinchPrev), 0.06, 90);
    if(panPrev){                    // 2本指ドラッグ＝上下左右にパン
      const w=el.clientWidth||innerWidth, h=el.clientHeight||innerHeight, s2=VIEW.size/2;
      cam.px -= (cx - panPrev.x) * (2*s2*projA/w);
      cam.py += (cy - panPrev.y) * (2*s2/h);
      applyProj();
    }
    pinchPrev = d; panPrev = { x:cx, y:cy };
  }
}, { passive:false });

/* ── UI ─────────────────────────────────────────────────── */
document.getElementById('src-text').value = DEFAULT_TEXT;

document.querySelectorAll('input[data-p]').forEach(r => {
  const val = r.parentElement.querySelector('.val');
  const sync = () => {
    P[r.dataset.p] = +r.value; val.textContent = r.value;
    if(['size','tracking','leading'].includes(r.dataset.p)) layout();
  };
  r.addEventListener('input', sync); sync();
});

// SHIFT のツマミは「選ばれている層」の値を読み書きする
const shiftRows = [...document.querySelectorAll('input[data-t]')];
function loadTrackUI(){
  shiftRows.forEach(r => {
    r.value = T[SEL][r.dataset.t];
    r.parentElement.querySelector('.val').textContent = r.value;
  });
  document.getElementById('shift-tk').textContent = TRACKS[SEL].name;
}
shiftRows.forEach(r => r.addEventListener('input', () => {
  T[SEL][r.dataset.t] = +r.value;
  r.parentElement.querySelector('.val').textContent = r.value;
}));

document.querySelectorAll('#tracks .tk').forEach(tk => {
  const i = +tk.dataset.tk;
  tk.addEventListener('click', () => {
    SEL = i;
    document.querySelectorAll('#tracks .tk').forEach(x => x.classList.remove('sel'));
    tk.classList.add('sel');
    loadTrackUI();
  });
  tk.addEventListener('dblclick', () => {
    MUTE[i] = !MUTE[i];
    tk.classList.toggle('muted', MUTE[i]);
  });
});
loadTrackUI();

document.querySelectorAll('.seg[data-seg]').forEach(seg => {
  seg.querySelectorAll('button').forEach(b => {
    b.addEventListener('click', () => {
      seg.querySelectorAll('button').forEach(x => x.classList.remove('on'));
      b.classList.add('on');
      P[seg.dataset.seg] = +b.dataset.v;
      if(seg.dataset.seg === 'font'){ atlasTex = null; layout(); }
      if(seg.dataset.seg === 'vertical') layout();
    });
  });
});

document.querySelectorAll('.unit-head').forEach(h => {
  h.addEventListener('click', () => {
    const u = h.parentElement;
    u.classList.toggle('off');
    ON[u.dataset.unit] = !u.classList.contains('off');
    if(u.dataset.unit === 'audio' && !ON.audio) stopAudio();
  });
});

let reflow;
document.getElementById('src-text').addEventListener('input', () => {
  clearTimeout(reflow); reflow = setTimeout(() => { atlasTex = null; layout(); }, 220);
});

document.getElementById('btn-spin').onclick = e => {
  spin = !spin;
  e.target.style.background = spin ? '#0a0a0a' : '';
  e.target.style.color = spin ? '#f4f2ee' : '';
};
document.getElementById('btn-png').onclick = () => {
  const a = document.createElement('a');
  a.download = `kumi_${Date.now()}.png`;
  a.href = renderer.domElement.toDataURL('image/png'); a.click();
};
let rec = null;
document.getElementById('btn-rec').onclick = e => {
  if(rec){ rec.stop(); rec = null; e.target.classList.remove('on'); e.target.textContent = 'REC'; return; }
  const mime = MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9' : 'video/webm';
  rec = new MediaRecorder(renderer.domElement.captureStream(60), { mimeType:mime, videoBitsPerSecond:12e6 });
  const chunks = [];
  rec.ondataavailable = ev => ev.data.size && chunks.push(ev.data);
  rec.onstop = () => {
    const a = document.createElement('a');
    a.download = `kumi_${Date.now()}.webm`;
    a.href = URL.createObjectURL(new Blob(chunks, {type:'video/webm'})); a.click();
  };
  rec.start(); e.target.classList.add('on'); e.target.textContent = 'STOP';
};

document.getElementById('btn-beat').onclick = e => {
  e.stopPropagation();
  if(demoTimer){ stopAudio(); }
  else { startDemo(); armAudio(); setSourceLabel('BEAT'); srcBtn('btn-beat'); }
};
document.getElementById('btn-mic').onclick = async e => {
  e.stopPropagation();
  try { await useMic(); armAudio(); srcBtn('btn-mic'); }
  catch(err){
    setSourceLabel({NotAllowedError:'マイク拒否', NotFoundError:'マイク無し',
      NotReadableError:'使用中', SecurityError:'要HTTPS'}[err.name] || err.name || 'MIC ERR');
    console.error('[KUMI] mic:', err);
  }
};
const filePick = document.createElement('input');
filePick.type = 'file'; filePick.accept = 'audio/*';
filePick.onchange = () => { if(filePick.files[0]){ useFile(filePick.files[0]); armAudio(); srcBtn('btn-file'); } };
document.getElementById('btn-file').onclick = e => { e.stopPropagation(); filePick.click(); };
document.getElementById('btn-stop').onclick = e => { e.stopPropagation(); toggleAudio(); };
addEventListener('dragover', e => e.preventDefault());
addEventListener('drop', e => {
  e.preventDefault();
  const f = [...e.dataTransfer.files].find(f => f.type.startsWith('audio'));
  if(f){ useFile(f); armAudio(); srcBtn('btn-file'); }
});

/* ── BOOT — 日本語フォントが乗ってから字形を焼く ─────────── */
(async () => {
  try {
    await Promise.all(FONTS.map(f => document.fonts.load(`500 80px ${f}`, '組漢字かなカナ')));
    await document.fonts.ready;
  } catch(_){}
  layout();
  requestAnimationFrame(frame);
  document.getElementById('boot').classList.add('gone');
})();
</script>
