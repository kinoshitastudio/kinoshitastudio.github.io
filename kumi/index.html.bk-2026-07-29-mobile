<style>
  :root{ --ink:#0a0a0a; --paper:#f4f2ee; --line:rgba(10,10,10,.14); }
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;overflow:hidden;background:var(--paper);}
  body{
    font-family:"Zen Kaku Gothic New",-apple-system,sans-serif;font-weight:300;
    color:var(--ink);-webkit-font-smoothing:antialiased;
    -webkit-tap-highlight-color:transparent;touch-action:none;
  }
  canvas{display:block;position:fixed;inset:0;width:100%;height:100%;}

  #title{position:fixed;top:22px;left:24px;z-index:10;pointer-events:none;
    mix-blend-mode:difference;color:#fff;}
  #title h1{font-size:26px;font-weight:400;letter-spacing:.24em;line-height:1;}
  #title p{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.3em;
    margin-top:9px;opacity:.5;}

  #home{position:fixed;top:26px;left:110px;z-index:10;
    font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.18em;
    color:var(--ink);text-decoration:none;opacity:.34;transition:opacity .25s;}
  #home:hover{opacity:1;}

  /* ── rack ── */
  #rack{
    position:fixed;top:22px;right:22px;z-index:20;width:236px;
    background:rgba(244,242,238,.86);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border:1px solid var(--line);
    max-height:calc(100vh - 44px);overflow-y:auto;overscroll-behavior:contain;
    scrollbar-width:thin;
  }
  #rack::-webkit-scrollbar{width:3px;}
  #rack::-webkit-scrollbar-thumb{background:rgba(10,10,10,.22);}
  .unit{border-bottom:1px solid var(--line);}
  .unit:last-child{border-bottom:none;}
  .unit-head{display:flex;align-items:center;gap:8px;padding:9px 12px;cursor:pointer;user-select:none;}
  .unit-head:hover{background:rgba(10,10,10,.03);}
  .led{width:5px;height:5px;flex:none;border-radius:50%;background:var(--ink);transition:opacity .18s;}
  .unit.off .led{opacity:.16;}
  .unit.off .unit-body{display:none;}
  .unit.off .unit-name{opacity:.38;}
  .unit-idx{font-family:"Space Mono",monospace;font-size:8px;opacity:.32;letter-spacing:.1em;}
  .unit-name{font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.18em;flex:1;}
  .unit-jp{font-size:10px;opacity:.4;letter-spacing:.08em;}
  .unit-body{padding:2px 12px 11px;}

  .row{display:flex;align-items:center;gap:9px;padding:3px 0;}
  .row label{font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.1em;
    opacity:.5;width:52px;flex:none;}
  .row input[type=range]{-webkit-appearance:none;appearance:none;flex:1;height:1px;
    background:var(--line);outline:none;cursor:pointer;}
  .row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:9px;height:9px;
    border-radius:50%;background:var(--ink);cursor:pointer;}
  .row input[type=range]::-moz-range-thumb{width:9px;height:9px;border:none;border-radius:50%;
    background:var(--ink);cursor:pointer;}
  .val{font-family:"Space Mono",monospace;font-size:8.5px;opacity:.42;width:26px;
    text-align:right;flex:none;}
  .seg{display:flex;margin:5px 0 2px;border:1px solid var(--line);}
  .seg button{flex:1;background:none;border:none;cursor:pointer;
    font-family:"Space Mono",monospace;font-size:8px;letter-spacing:.1em;
    padding:5px 0;color:var(--ink);opacity:.4;border-right:1px solid var(--line);}
  .seg button:last-child{border-right:none;}
  .seg button.on{opacity:1;background:var(--ink);color:var(--paper);}
  .mod{font-family:"Space Mono",monospace;font-size:7.5px;letter-spacing:.06em;
    line-height:1.8;opacity:.3;margin-top:7px;}
  .meters{display:flex;gap:3px;margin:7px 0 4px;height:2px;}
  .meters i{flex:1;background:var(--line);position:relative;overflow:hidden;}
  .meters i::after{content:"";position:absolute;inset:0;transform-origin:left;
    transform:scaleX(var(--v,0));background:var(--ink);}

  /* ── track selector ── */
  .tracks{display:flex;gap:4px;margin:6px 0 8px;}
  .tk{
    flex:1;border:1px solid var(--line);padding:7px 0 5px;text-align:center;
    cursor:pointer;transition:background .15s,opacity .15s;
  }
  .tk .g{font-size:15px;line-height:1;display:block;margin-bottom:4px;}
  .tk .n{font-family:"Space Mono",monospace;font-size:6.5px;letter-spacing:.08em;opacity:.5;}
  .tk.sel{background:var(--ink);color:var(--paper);}
  .tk.sel .n{opacity:.7;}
  .tk.muted{opacity:.22;}
  .tk-count{font-family:"Space Mono",monospace;font-size:7px;opacity:.35;
    text-align:right;letter-spacing:.05em;margin-bottom:6px;}

  textarea{
    width:100%;height:74px;resize:vertical;background:rgba(255,255,255,.4);
    border:1px solid var(--line);color:var(--ink);padding:7px 8px;
    font-family:"Zen Kaku Gothic New",sans-serif;font-size:10px;line-height:1.7;
    outline:none;margin:5px 0 2px;
  }
  textarea:focus{border-color:rgba(10,10,10,.4);}

  /* ── transport ── */
  #transport{position:fixed;bottom:22px;left:24px;z-index:10;display:flex;gap:7px;}
  #transport button{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.14em;
    padding:8px 13px;background:rgba(244,242,238,.86);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border:1px solid var(--line);color:var(--ink);cursor:pointer;
    transition:background .15s,color .15s;}
  #transport button:hover{background:var(--ink);color:var(--paper);}
  #transport button.rec{color:#b4241e;border-color:rgba(180,36,30,.4);}
  #transport button.rec.on{background:#b4241e;color:var(--paper);border-color:#b4241e;}

  #hint{position:fixed;bottom:58px;left:24px;z-index:10;
    font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.1em;
    line-height:1.9;opacity:.34;pointer-events:none;}

  #boot{position:fixed;inset:0;z-index:50;background:var(--paper);
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;
    transition:opacity .5s;}
  #boot.gone{opacity:0;pointer-events:none;}
  #boot .k{font-size:40px;font-weight:300;letter-spacing:.3em;text-indent:.3em;}
  #boot .s{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.3em;opacity:.4;}

  @media(max-width:760px){
    canvas{ top:0; height:58vh; height:58dvh; bottom:auto; inset:auto; left:0; right:0; }
    #rack{ top:58vh; top:58dvh; bottom:0; left:0; right:0; width:auto;
           max-height:42vh; max-height:42dvh; overflow-y:auto;
           border-left:none; border-top:1px solid var(--line);
           background:rgba(244,242,238,.97); }
    #transport{ bottom:auto; top:calc(58vh - 42px); top:calc(58dvh - 42px); left:8px; z-index:11; }
    #hint{ display:none; }
    #title{ top:10px; left:12px; }
    #home{ top:12px; left:auto; right:12px; }
  }
</style>
</head>
