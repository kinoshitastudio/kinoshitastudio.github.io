{
  "manifest_version": 3,
  "name": "MINAMO",
  "version": "0.1.0",
  "description": "A calm overview for when you have too many tabs.",
  "permissions": ["tabs", "tabGroups", "sidePanel", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open MINAMO — calm your tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "canvas/index.html"
  }
}
