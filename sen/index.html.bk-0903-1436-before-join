<!doctype html><html lang="ja"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>閃 SEN — 日本語を、速さで書く</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Zen+Old+Mincho:wght@700;900&family=Zen+Maru+Gothic:wght@700;900&display=swap" rel="stylesheet">
<style>
:root{ --paper:#f4f2ee; --ink:#1c1c1e; --grid:#e6e3dd; --fg:#fff; --mut:#7a7772; --hot:#c0392b; }
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--paper);color:var(--ink);
  font:14px/1.7 -apple-system,"Zen Kaku Gothic New","Hiragino Sans",sans-serif;
  display:flex;overflow:hidden}
#stage{flex:1;position:relative;overflow:hidden;background:var(--paper)}
#cv{position:absolute;left:0;top:0;transform-origin:0 0;box-shadow:0 6px 30px rgba(0,0,0,.10);background:#fff}
#modes{position:absolute;left:50%;top:14px;transform:translateX(-50%);z-index:5}
#zoom{position:absolute;left:16px;bottom:16px;display:flex;gap:6px;align-items:center;
  background:var(--fg);border-radius:10px;padding:6px 10px;box-shadow:0 2px 12px rgba(0,0,0,.08);z-index:5}
#zoom button{border:none;background:none;font:inherit;cursor:pointer;padding:2px 8px;border-radius:6px}
#zoom button:hover{background:var(--grid)}
#note{position:absolute;left:16px;bottom:64px;right:420px;color:var(--mut);font-size:12.5px;z-index:5}
#panel{width:400px;flex:0 0 auto;background:var(--fg);border-left:1px solid var(--grid);
  overflow-y:auto;padding:22px 22px 90px}
h1{font-size:19px;margin:0 0 4px;letter-spacing:.02em}
.lead{color:#3a3a3e;font-size:13px;margin:0 0 20px;line-height:1.75}
.sec{font-size:12px;color:var(--mut);letter-spacing:.06em;margin:22px 0 10px;
  padding-bottom:6px;border-bottom:1px solid var(--grid)}
.row{display:flex;justify-content:space-between;align-items:baseline;margin:14px 0 5px}
.n{font-weight:600;font-size:13px}
output{font-variant-numeric:tabular-nums;color:var(--mut);font-size:12.5px}
input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:3px;background:var(--grid);
  border-radius:2px;outline:none;margin:0}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:17px;height:17px;border-radius:50%;
  background:var(--ink);cursor:pointer;border:none}
textarea,input[type=text]{width:100%;border:1px solid var(--grid);border-radius:9px;background:var(--paper);
  padding:11px 12px;font:inherit;color:var(--ink);resize:vertical;outline:none}
textarea:focus{border-color:#bdb9b1}
.seg{display:flex;background:var(--paper);border-radius:10px;padding:3px;gap:3px;margin:8px 0}
.seg button{flex:1;border:none;background:none;font:inherit;font-size:12.5px;padding:7px 4px;
  border-radius:8px;cursor:pointer;color:var(--mut);white-space:nowrap}
.seg button.on{background:var(--fg);color:var(--ink);font-weight:700;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.btn{width:100%;border:1px solid var(--grid);background:var(--paper);border-radius:9px;
  padding:10px;font:inherit;font-size:13px;cursor:pointer;margin-top:8px}
.btn:hover{background:var(--grid)}
.btn.go{background:var(--ink);color:var(--fg);border-color:var(--ink);font-weight:700}
input[type=color]{width:100%;height:36px;border:1px solid var(--grid);border-radius:9px;
  background:var(--paper);padding:3px;cursor:pointer;margin-top:6px}
.hint{color:var(--mut);font-size:12px;line-height:1.7;margin:8px 0 0}
.hint b{color:var(--hot)}
.two{display:flex;gap:10px}
.two>*{flex:1}
</style></head><body>
<div id="stage">
  <div class="seg" id="modes" style="width:auto">
    <button data-v="run" class="on">走らせる</button>
    <button data-v="sheet">字見本</button>
  </div>
  <canvas id="cv"></canvas>
  <div id="note"></div>
  <div id="zoom"><button id="zo">−</button><span id="zVal">100%</span><button id="zi">＋</button><button id="bFit">合わせる</button></div>
</div>
<div id="panel">
  <h1>閃 SEN</h1>
  <p class="lead"><b>日本語を、速さで書く。</b><br>
  筆ではなく<b>ペン</b>。角は丸めず<b>折る</b>、払いは<b>まっすぐ長く</b>。<br>
  ひらがな・カタカナ・漢字を、打てばそのまま走る。</p>
  <div class="sec">① 何を書くか</div>
  <textarea id="tText" rows="2" placeholder="ファーストクラス">ファーストクラス</textarea>
  <p class="hint">かな・カタカナ・漢字をそのまま打つ。<b>変換中の字は触らない</b>ので、日本語入力が壊れない。</p>
  <div class="seg" id="segFam">
    <button data-v="kaku" class="on">角ゴ</button>
    <button data-v="min">明朝</button>
    <button data-v="maru">丸ゴ</button>
  </div>
  <p class="hint">骨（書き順の芯）は、この書体から起こす。<b>元の形が違えば走りも変わる。</b></p>

  <div class="sec">② 型 ── ひと当て</div>
  <div class="seg" id="segKata">
    <button data-v="c1" class="on">ファーストクラス</button>
    <button data-v="c2">ゴールデン</button>
    <button data-v="c3">白のペン</button>
  </div>

  <div class="sec">③ ペン ── 骨に着せる</div>
  <div class="row"><span class="n">太さ</span><output id="o_w">96</output></div>
  <input type="range" id="w" min="4" max="220" value="96">
  <div class="row"><span class="n">先の鋭さ（入り抜き）</span><output id="o_taper">62</output></div>
  <input type="range" id="taper" min="0" max="100" value="62">
  <div class="row"><span class="n">角（折る ⇄ 丸める）</span><output id="o_miter">52</output></div>
  <input type="range" id="miter" min="0" max="100" value="52">
  <div class="row"><span class="n">払い（終筆を伸ばす）</span><output id="o_sweep">80</output></div>
  <input type="range" id="sweep" min="0" max="100" value="80">
  <div class="row"><span class="n">払いの直線度</span><output id="o_straight">88</output></div>
  <input type="range" id="straight" min="0" max="100" value="88">
  <div class="row"><span class="n">線幅のムラ（速さ）</span><output id="o_vary">26</output></div>
  <input type="range" id="vary" min="0" max="100" value="26">
  <div class="row"><span class="n">震え（手のブレ）</span><output id="o_jit">7</output></div>
  <input type="range" id="jit" min="0" max="100" value="7">

  <div class="sec">④ 走り ── 版面の上をどう走るか</div>
  <div class="seg" id="segDir">
    <button data-v="h" class="on">横組</button>
    <button data-v="v">縦組</button>
  </div>
  <p class="hint">縦組は<b>送りの向きが下</b>になるだけ。走る角度はそのまま効く（看板の縦書きは右下へ流れる）。</p>
  <div class="row"><span class="n">大きさ（‰）</span><output id="o_size">150</output></div>
  <input type="range" id="size" min="40" max="900" value="150">
  <div class="row"><span class="n">字送り</span><output id="o_adv">80</output></div>
  <input type="range" id="adv" min="30" max="200" value="80">
  <div class="row"><span class="n">走る角度（斜体）</span><output id="o_ang">-22</output></div>
  <input type="range" id="ang" min="-80" max="80" value="-22">
  <div class="row"><span class="n">字幅（横に潰す）</span><output id="o_wide">62</output></div>
  <input type="range" id="wide" min="30" max="180" value="62">
  <div class="row"><span class="n">字高（縦に伸ばす）</span><output id="o_tall">130</output></div>
  <input type="range" id="tall" min="30" max="200" value="130">
  <div class="row"><span class="n">字ごとの傾きのばらつき</span><output id="o_jr">10</output></div>
  <input type="range" id="jr" min="0" max="100" value="10">
  <div class="row"><span class="n">よこ</span><output id="o_x">6</output></div>
  <input type="range" id="x" min="-20" max="120" value="6">
  <div class="row"><span class="n">たて</span><output id="o_y">46</output></div>
  <input type="range" id="y" min="-20" max="120" value="46">
  <div class="row"><span class="n">種（振り直す）</span><output id="o_seed">7</output></div>
  <input type="range" id="seed" min="1" max="99" value="7">

  <div class="sec">⑤ 色</div>
  <div class="seg" id="segGrad">
    <button data-v="0">単色</button>
    <button data-v="1" class="on">2色のグラデ</button>
  </div>
  <div class="two">
    <div><div class="row"><span class="n">はじめの色</span></div><input type="color" id="col" value="#ff3fb0"></div>
    <div id="wCol2"><div class="row"><span class="n">おわりの色</span></div><input type="color" id="col2" value="#6a2bd9"></div>
  </div>
  <div id="wGang"><div class="row"><span class="n">グラデの向き</span><output id="o_gang">14</output></div>
  <input type="range" id="gang" min="-90" max="90" value="14"></div>
  <p class="hint">グラデは<b>版面ぜんぶを1本</b>走る。字ごとに作ると、字の中で毎回はじめの色に戻って縞になる。</p>

  <div class="sec">⑥ ふち（袋文字）</div>
  <div class="seg" id="segEdge">
    <button data-v="0" class="on">なし</button>
    <button data-v="1">あり</button>
  </div>
  <div id="wEdge">
    <div class="row"><span class="n">ふちの太さ</span><output id="o_edgeW">6</output></div>
    <input type="range" id="edgeW" min="1" max="40" value="6">
    <div class="row"><span class="n">ふちの色</span></div><input type="color" id="edgeCol" value="#2a1c33">
  </div>
  <p class="hint">帯を1本ずつ縁取ると<b>中の継ぎ目まで線が出る</b>。だから「ふちの色で太らせて塗る → その上に字の色」の2枚組にしている。</p>

  <div class="sec">⑦ 版面</div>
  <div class="seg" id="segPage">
    <button data-v="1000,1500">たて</button>
    <button data-v="1500,1000" class="on">よこ</button>
    <button data-v="1200,1200">正方</button>
  </div>
  <div class="row"><span class="n">紙の色</span></div><input type="color" id="bg" value="#ffffff">

  <div class="sec">⑧ 出す</div>
  <div class="row"><span class="n">長辺（px）</span><output id="o_long">2400</output></div>
  <input type="range" id="long" min="600" max="6000" step="100" value="2400">
  <button class="btn go" id="ePNG">PNG で出す</button>
  <button class="btn" id="eSVG">SVG で出す</button>
  <p class="hint">SVG は<b>画面と同じ形</b>（ふちもグラデも入る）。⚠️ 震えは入るが、紙の地は入らない。</p>
</div>
<script>
const $ = id => document.getElementById(id);
const cv = $('cv'), cx = cv.getContext('2d');

/* ══════════════════════════════════════════════════════════════
   閃 SEN ── 日本語を、速さで書く
   芯＝【ペン】。筆（奔HON）とは別物。
     ・角は丸めず【折る】（留め継ぎ／マイター）
     ・払いは【まっすぐ長く】伸びる（速く払った跡）
     ・版面ぜんぶを1本のグラデが走る
   ⭐ 骨（書き順の芯）の起こし方だけは 奔HON と同じ細線化（Zhang-Suen）を使う。
     ＝ 骨の起こし方は道具の芯ではなく【土台】なので、共有してよい。
   ⚠️ HON は欧文ベース（手で書いた骨を持つ）。SEN は【日本語ベース】＝骨は必ず書体から起こす。
   ══════════════════════════════════════════════════════════════ */

const S = {
  text: 'ファーストクラス',
  fam: 'kaku',
  pen : { w:96, taper:62, miter:52, sweep:80, straight:88, vary:26, jit:7 },
  run : { size:150, adv:80, ang:-22, wide:62, tall:130, jr:10, x:6, y:46, seed:7,
          w:1500, h:1000 },
  col : { col:'#ff3fb0', col2:'#6a2bd9', grad:1, gang:14,
          edge:0, edgeW:6, edgeCol:'#2a1c33', bg:'#ffffff' },
  out : { long:2400 },
  view: 'run',
};

/* ══ 乱数（種から決まる＝同じ種なら1画素も同じ） ══ */
function rnd(seed){
  let s = (seed|0) || 1;
  s = Math.imul(s ^ 0x9e3779b9, 0x85ebca6b);
  s = (s ^ (s >>> 13)) | 0;
  const next = () => { s = (s*1664525 + 1013904223)|0; return ((s>>>8) & 0xffffff) / 0xffffff; };
  next(); next(); next();
  return next;
}

/* ══════════════════════════════════════════════════════════════
   ① 骨を起こす ── 書いた字を細らせて【1画素の芯】にする（Zhang-Suen）
   🔴 骨を手で書く道は漢字では現実的でない（常用漢字だけで2000字超）。
   ⭐ だから端末にある書体から起こす＝かな・カタカナ・漢字ぜんぶ通る。
   ⚠️ 交わる所（十字・T字）で道が分かれる＝分岐で切って1本ずつの線にする。
   ══════════════════════════════════════════════════════════════ */
const FAM = {
  min : '"Zen Old Mincho","Hiragino Mincho ProN",serif',
  kaku: '"Zen Kaku Gothic New","Hiragino Sans",sans-serif',
  maru: '"Zen Maru Gothic","Hiragino Maru Gothic ProN",sans-serif',
};
const boneCache = new Map();
function boneOf(ch){
  const key = ch + '|' + S.fam;
  if(boneCache.has(key)) return boneCache.get(key);
  const N = 128;
  const c = document.createElement('canvas'); c.width = c.height = N;
  const g = c.getContext('2d');
  g.fillStyle = '#fff'; g.fillRect(0,0,N,N);
  g.fillStyle = '#000';
  g.font = '700 ' + Math.round(N*0.78) + 'px ' + FAM[S.fam];
  g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillText(ch, N/2, N*0.52);
  const d = g.getImageData(0,0,N,N).data;
  const A = new Uint8Array(N*N);
  for(let i=0;i<N*N;i++) A[i] = d[i*4] < 128 ? 1 : 0;
  const at = (a,x,y) => (x<0||y<0||x>=N||y>=N) ? 0 : a[y*N+x];
  for(let pass=0; pass<40; pass++){
    let changed = 0;
    for(let sub=0; sub<2; sub++){
      const del = [];
      for(let y=1;y<N-1;y++) for(let x=1;x<N-1;x++){
        if(!at(A,x,y)) continue;
        const P = [at(A,x,y-1),at(A,x+1,y-1),at(A,x+1,y),at(A,x+1,y+1),
                   at(A,x,y+1),at(A,x-1,y+1),at(A,x-1,y),at(A,x-1,y-1)];
        const B = P.reduce((s,v)=>s+v,0);
        if(B < 2 || B > 6) continue;
        let Ac = 0; for(let i=0;i<8;i++) if(P[i]===0 && P[(i+1)%8]===1) Ac++;
        if(Ac !== 1) continue;
        if(sub === 0){ if(P[0]*P[2]*P[4] || P[2]*P[4]*P[6]) continue; }
        else         { if(P[0]*P[2]*P[6] || P[0]*P[4]*P[6]) continue; }
        del.push(y*N+x);
      }
      del.forEach(i => { A[i] = 0; }); changed += del.length;
    }
    if(!changed) break;
  }
  const nb = (x,y) => { const o=[];
    for(let dy=-1;dy<=1;dy++) for(let dx=-1;dx<=1;dx++){
      if(!dx && !dy) continue; if(at(A,x+dx,y+dy)) o.push([x+dx,y+dy]); }
    return o; };
  const used = new Set(), lines = [];
  const walk = (sx,sy) => {
    const line = [[sx,sy]]; used.add(sy*N+sx);
    let x = sx, y = sy;
    for(let step=0; step<4000; step++){
      const ns = nb(x,y).filter(([a,b]) => !used.has(b*N+a));
      if(ns.length !== 1) break;
      [x,y] = ns[0]; used.add(y*N+x); line.push([x,y]);
    }
    return line;
  };
  const starts = [];
  for(let y=0;y<N;y++) for(let x=0;x<N;x++) if(at(A,x,y) && nb(x,y).length !== 2) starts.push([x,y]);
  starts.forEach(([x,y]) => { if(!used.has(y*N+x)) { const l = walk(x,y); if(l.length>3) lines.push(l); } });
  for(let y=0;y<N;y++) for(let x=0;x<N;x++)
    if(at(A,x,y) && !used.has(y*N+x)){ const l = walk(x,y); if(l.length>3) lines.push(l); }
  const out = lines.map(l => {
    const keep = Math.max(1, Math.round(l.length/12));
    const t = l.filter((_,i) => i % keep === 0);
    if(t[t.length-1] !== l[l.length-1]) t.push(l[l.length-1]);
    return t.map(([x,y]) => [x/N, y/N]);
  }).filter(l => l.length >= 2);
  if(boneCache.size > 400) boneCache.clear();
  boneCache.set(key, out);
  return out;
}

function resample(pts, step){
  const out = [pts[0]];
  let carry = 0;
  for(let i=1;i<pts.length;i++){
    const a = out[out.length-1], b = pts[i];
    let d = Math.hypot(b[0]-a[0], b[1]-a[1]);
    let px = a[0], py = a[1];
    while(carry + d >= step){
      const t = (step - carry)/d;
      px = px + (b[0]-px)*t; py = py + (b[1]-py)*t;
      out.push([px,py]);
      d = Math.hypot(b[0]-px, b[1]-py); carry = 0;
    }
    carry += d;
  }
  const last = pts[pts.length-1];
  if(Math.hypot(last[0]-out[out.length-1][0], last[1]-out[out.length-1][1]) > 1e-6) out.push(last);
  return out;
}

/* ══════════════════════════════════════════════════════════════
   ② ペン ── 骨1本を、閉じた輪郭（帯）にする
   ⭐ 筆（奔HON）との違いは3つだけ。
     ① 角を【折る】＝前後の辺の法線を足して 1/cos(θ/2) で伸ばす（留め継ぎ）
     ② 払いを【まっすぐ】伸ばす＝終わりの何点かを均した向きで出る
     ③ 幅のムラは【曲がり具合】から出す（速いほど細い）
   ══════════════════════════════════════════════════════════════ */
function penOutline(pts, w, seed){
  const P = S.pen;
  /* ── 払い＝終筆だけ長く。⚠️ 入りと同じ長さだと「ただの延長」に見える ── */
  const ovIn  = w * 0.10;
  const ovOut = ovIn + (P.sweep/100) * w * 5.0;
  if(pts.length >= 2){
    const ext = (a,b,d0) => { const d = Math.hypot(b[0]-a[0], b[1]-a[1]) || 1;
      return [ a[0] + (a[0]-b[0])/d*d0, a[1] + (a[1]-b[1])/d*d0 ]; };
    /* ⭐ 直線度＝終わりの何点かを均した向きで伸ばす（骨が曲がっていても払いは直線） */
    const kStr = P.straight/100;
    let tail = pts[pts.length-2];
    if(kStr > 0 && pts.length >= 4){
      const back = Math.max(2, Math.round((pts.length-1) * (0.08 + 0.30*kStr)));
      const far = pts[Math.max(0, pts.length-1-back)];
      tail = [ pts[pts.length-2][0]*(1-kStr) + far[0]*kStr,
               pts[pts.length-2][1]*(1-kStr) + far[1]*kStr ];
    }
    pts = [ext(pts[0], pts[1], ovIn), ...pts, ext(pts[pts.length-1], tail, ovOut)];
  }
  const R = resample(pts, Math.max(2, w*0.22));
  const n = R.length;
  if(n < 2) return null;

  /* 震え＝道のりに沿ったなめらかな乱れ */
  const r = rnd(seed);
  const cell = 6, m = Math.ceil(n/cell)+2, nz = [];
  for(let i=0;i<m;i++) nz.push(r()*2-1);
  const wob = i => { const f=i/cell, k=f|0, t=f-k, s=t*t*(3-2*t);
    return (nz[k%m])*(1-s) + (nz[(k+1)%m])*s; };
  const amp = (P.jit/100) * w * 0.34;

  /* ── 幅のムラ＝【速さ】から。曲がる所は遅くて太り、まっすぐは速くて細る ── */
  const vk = P.vary/100, raw = new Array(n);
  for(let i=0;i<n;i++){
    const a = R[Math.max(0,i-1)], c = R[i], b = R[Math.min(n-1,i+1)];
    const a1 = Math.atan2(c[1]-a[1], c[0]-a[0]), a2 = Math.atan2(b[1]-c[1], b[0]-c[0]);
    let d = Math.abs(a2-a1); if(d > Math.PI) d = Math.PI*2 - d;
    const slow = Math.min(1, d/(Math.PI*0.55));
    raw[i] = 1 + vk*(slow*1.25 - 0.30 + wob(i+97)*0.50);
  }
  const vary = new Array(n);
  for(let i=0;i<n;i++){
    const a = raw[Math.max(0,i-1)], c = raw[i], b = raw[Math.min(n-1,i+1)];
    vary[i] = Math.max(0.16, (a + c*2 + b)/4);
  }

  const kM = P.miter/100, kT = P.taper/100;
  const L = [], Rt = [];
  for(let i=0;i<n;i++){
    const a = R[Math.max(0,i-1)], b = R[Math.min(n-1,i+1)];
    let nx = -(b[1]-a[1]), ny = (b[0]-a[0]);
    const len = Math.hypot(nx,ny) || 1; nx/=len; ny/=len;
    /* ⭐⭐ 角を【折る】── 前後の辺の法線を足して 1/cos(θ/2) で伸ばす。
       ⚠️ 鋭角では無限に伸びるので【留めの上限 5.5倍】で頭打ちにする。 */
    if(kM > 0 && i > 0 && i < n-1){
      const p0 = R[i-1], p1 = R[i], p2 = R[i+1];
      let n1x = -(p1[1]-p0[1]), n1y = (p1[0]-p0[0]); const l1 = Math.hypot(n1x,n1y)||1; n1x/=l1; n1y/=l1;
      let n2x = -(p2[1]-p1[1]), n2y = (p2[0]-p1[0]); const l2 = Math.hypot(n2x,n2y)||1; n2x/=l2; n2y/=l2;
      let mx = n1x+n2x, my = n1y+n2y; const ml = Math.hypot(mx,my);
      if(ml > 1e-4){
        mx/=ml; my/=ml;
        const cosHalf = Math.max(0.18, mx*n1x + my*n1y);
        const grow = Math.min(5.5, 1/cosHalf);
        let ax = nx*(1-kM) + mx*kM, ay = ny*(1-kM) + my*kM;
        const al = Math.hypot(ax,ay)||1;
        const keep = 1 + (grow-1)*kM;
        nx = ax/al*keep; ny = ay/al*keep;
      }
    }
    const t = i/(n-1);
    /* 入りは短く鈍く・抜きは長く鋭く（速く払った跡） */
    const eIn = Math.min(1, t*8), eOut = Math.min(1, (1-t)*2.0);
    const e = Math.min(eIn, eOut);
    const wid = w * vary[i] * (1 - kT*(1 - Math.pow(e, 0.80))) * 0.5;
    const cxp = R[i][0] + nx*wob(i)*amp, cyp = R[i][1] + ny*wob(i)*amp;
    L.push([cxp + nx*wid, cyp + ny*wid]);
    Rt.push([cxp - nx*wid, cyp - ny*wid]);
  }
  return L.concat(Rt.reverse());
}

/* 1字ぶんの輪郭（複数の帯） */
const glyphCache = new Map();
function glyph(ch, i){
  const P = S.pen;
  const key = ch + '|' + S.fam + '|' + [P.w,P.taper,P.miter,P.sweep,P.straight,P.vary,P.jit,S.run.seed,i].join(',');
  if(glyphCache.has(key)) return glyphCache.get(key);
  const bones = boneOf(ch);
  const out = [];
  bones.forEach((b, bi) => {
    const pts = b.map(p => [p[0]*1000, p[1]*1000]);
    const ring = penOutline(pts, P.w, S.run.seed*7919 + i*131 + bi*17);
    if(ring) out.push(ring);
  });
  if(glyphCache.size > 600) glyphCache.clear();
  glyphCache.set(key, out);
  return out;
}

/* ══════════════════════════════════════════════════════════════
   ③ 走らせる ── 版面の上に並べる（横組／縦組）
   ⭐ 縦組は「送りの向きが下」になるだけ。走る角度はそのまま効く。
   ⚠️ 縦組で角度を付けると【右下へ流れる】＝それが正しい（看板の縦書きはそう流れる）。
   ══════════════════════════════════════════════════════════════ */
function boardSize(){
  if(S.view === 'sheet'){ return [1400, 900]; }
  return [S.run.w, S.run.h];
}
function runChars(){ return [...S.text].filter(c => c !== '\n'); }

function place(){
  const R = S.run, chars = runChars(), n = chars.length;
  const [BW,BH] = boardSize();
  const size = BW * R.size/1000;
  const adv = size * R.adv/100;
  const rad = R.ang*Math.PI/180, ca = Math.cos(rad), sa = Math.sin(rad);
  const r = rnd(R.seed*31+5);
  const ox = BW * R.x/100, oy = BH * R.y/100;
  return chars.map((ch,i) => {
    const jr = (r()*2-1) * R.jr * 0.35;
    /* ⭐ 縦組＝送りの向きが【下】。横組＝【右】。角度はどちらにも効く。 */
    const dx = S.vert ? (i*adv*(-sa)) : (i*adv*ca);
    const dy = S.vert ? (i*adv*ca)    : (i*adv*sa);
    return { ch, i, x: ox + dx, y: oy + dy, rot: R.ang + jr, size };
  });
}

function drawGlyph(g, ch, x, y, size, rot, colFill, i, svg, M0){
  const rings = glyph(ch, i);
  if(!rings.length) return;
  const k = size/1000;
  g.save();
  g.translate(x, y);
  if(rot){ g.translate(size/2, size/2); g.rotate(rot*Math.PI/180); g.translate(-size/2, -size/2); }
  g.scale(k * S.run.wide/100, k * S.run.tall/100);
  g.beginPath();
  rings.forEach(r => { g.moveTo(r[0][0], r[0][1]);
    for(let j=1;j<r.length;j++) g.lineTo(r[j][0], r[j][1]); g.closePath(); });

  /* ⭐⭐ ふち（袋文字）── 帯を1本ずつ縁取ると【中の継ぎ目まで線が出る】。
     だから「ふちの色で stroke＋fill」→ その上に字の色、の2枚組にする＝外側だけに線が出る。 */
  if(S.col.edge){
    g.strokeStyle = S.col.edgeCol; g.fillStyle = S.col.edgeCol;
    g.lineJoin = 'round'; g.lineCap = 'round';
    g.lineWidth = (S.col.edgeW||6) * 2 / (k || 1);
    g.stroke(); g.fill();
  }
  /* ⭐⭐ グラデは【版面ぜんぶを1本】。字ごとに作ると字の中で縞になる。
     変形を掛ける前の行列を控えておき、盤の座標 → この字の座標 に直して端点を置く。 */
  let paint = colFill;
  if(!svg && S.col.grad && M0 && g.getTransform){
    try{
      const B2L = g.getTransform().inverse().multiply(M0);
      const [BW,BH] = boardSize();
      const rad = (S.col.gang||0)*Math.PI/180, rr = Math.hypot(BW,BH)/2;
      const a = new DOMPoint(BW/2 - Math.cos(rad)*rr, BH/2 - Math.sin(rad)*rr).matrixTransform(B2L);
      const b = new DOMPoint(BW/2 + Math.cos(rad)*rr, BH/2 + Math.sin(rad)*rr).matrixTransform(B2L);
      const gr = g.createLinearGradient(a.x, a.y, b.x, b.y);
      gr.addColorStop(0, S.col.col); gr.addColorStop(1, S.col.col2);
      paint = gr;
    }catch(e){}
  }
  g.fillStyle = paint;
  g.fill();   /* nonzero＝帯どうしが重なっても穴が空かない */
  g.restore();

  if(svg){
    const rd = rot*Math.PI/180, c = size/2;
    const tp = p => {
      let X = p[0]*k*(S.run.wide/100), Y = p[1]*k*(S.run.tall/100);
      if(rot){ const dx=X-c, dy=Y-c; X = c + dx*Math.cos(rd) - dy*Math.sin(rd); Y = c + dx*Math.sin(rd) + dy*Math.cos(rd); }
      return [(x+X).toFixed(1), (y+Y).toFixed(1)];
    };
    const d = rings.map(r => 'M' + r.map(p => tp(p).join(' ')).join('L') + 'Z').join('');
    if(S.col.edge)
      svg.push(`<path d="${d}" fill="${S.col.edgeCol}" stroke="${S.col.edgeCol}" stroke-width="${(S.col.edgeW||6)*2}" stroke-linejoin="round" stroke-linecap="round"/>`);
    svg.push(`<path d="${d}" fill="${S.col.grad ? 'url(#sg)' : S.col.col}"/>`);
  }
}

function paint(g, W, H, opt){
  const svg = (opt && opt.svg) ? [] : null;
  const [BW,BH] = boardSize(), k = W/BW;
  g.save(); g.scale(k,k);
  if(!svg){ g.clearRect(0,0,BW,BH); g.fillStyle = S.col.bg; g.fillRect(0,0,BW,BH); }
  const M0 = (!svg && g.getTransform) ? g.getTransform() : null;
  if(S.view === 'sheet'){
    const chars = [...'あいうえおカキクケコさしすせそ愛光風時夜明街道'];
    const cols = 9, cell = 140;
    chars.forEach((ch,i) => {
      const cxp = 60 + (i%cols)*cell, cyp = 70 + Math.floor(i/cols)*cell;
      drawGlyph(g, ch, cxp, cyp, 110, 0, S.col.col, i, svg, M0);
    });
  } else {
    place().forEach(p => drawGlyph(g, p.ch, p.x, p.y, p.size, p.rot, S.col.col, p.i, svg, M0));
  }
  g.restore();
  return svg;
}

/* ══ 盤 ══ */
let Z=1, PX=0, PY=0, rafId=0;
function layout(){
  const [W,H] = boardSize(), dpr = Math.min(2, devicePixelRatio||1);
  cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
  cv.style.width = W+'px'; cv.style.height = H+'px';
  cx.setTransform(dpr,0,0,dpr,0,0); place2();
}
function place2(){ cv.style.transform = `translate(${PX}px,${PY}px) scale(${Z})`;
  $('zVal').textContent = Math.round(Z*100)+'%'; }
function fit(){
  const st = $('stage').getBoundingClientRect(), [W,H] = boardSize();
  Z = Math.min((st.width-80)/W, (st.height-140)/H);
  PX = (st.width - W*Z)/2; PY = (st.height - H*Z)/2 + 10; place2();
}
function draw(){ if(rafId) return; rafId = requestAnimationFrame(() => { rafId = 0; render(); }); }
function render(){
  const [W,H] = boardSize();
  paint(cx, W, H, {});
  const n = runChars().length;
  $('note').textContent = S.view === 'sheet'
    ? '字見本 ── 書体から骨を起こして書いた（かな・カタカナ・漢字）'
    : `${n}字を走らせた ── 骨は【${$('segFam').querySelector('.on')?.textContent||'角ゴ'}】から起こしている（${S.vert?'縦組':'横組'}）`;
}

/* ══ つまみ ══ */
function bindRange(id, get, set){
  const el = $(id), o = $('o_'+id); if(!el) return;
  el.addEventListener('input', e => { set(+e.target.value); if(o) o.textContent = e.target.value; draw(); });
}
[['w','pen'],['taper','pen'],['miter','pen'],['sweep','pen'],['straight','pen'],['vary','pen'],['jit','pen']]
  .forEach(([id,grp]) => bindRange(id, null, v => { S[grp][id] = v; glyphCache.clear(); }));
[['size','run'],['adv','run'],['ang','run'],['wide','run'],['tall','run'],['jr','run'],['x','run'],['y','run']]
  .forEach(([id,grp]) => bindRange(id, null, v => { S[grp][id] = v; }));
bindRange('seed', null, v => { S.run.seed = v; glyphCache.clear(); });
bindRange('gang', null, v => { S.col.gang = v; });
bindRange('edgeW', null, v => { S.col.edgeW = v; });
bindRange('long', null, v => { S.out.long = v; });

/* ⚠️⚠️ 日本語入力（IME）を壊さない ──
   変換中に値を書き換えると、打っている途中の字が消える／勝手に確定する。
   ⭐ compositionstart〜end の間は【一切触らない】。end のあとで1回だけ読む。 */
let composing = false;
const tt = $('tText');
tt.addEventListener('compositionstart', () => { composing = true; });
tt.addEventListener('compositionend', () => { composing = false; S.text = tt.value; draw(); });
tt.addEventListener('input', () => { if(composing) return; S.text = tt.value; draw(); });

function segOn(id, v){
  document.querySelectorAll('#'+id+' button').forEach(b =>
    b.classList.toggle('on', String(b.dataset.v) === String(v)));
}
document.querySelectorAll('#segFam button').forEach(b => b.onclick = () => {
  S.fam = b.dataset.v; segOn('segFam', S.fam); boneCache.clear(); glyphCache.clear(); draw(); });
document.querySelectorAll('#modes button').forEach(b => b.onclick = () => {
  S.view = b.dataset.v; segOn('modes', S.view); layout(); fit(); draw(); });
document.querySelectorAll('#segGrad button').forEach(b => b.onclick = () => {
  S.col.grad = +b.dataset.v; segOn('segGrad', S.col.grad); colUI(); draw(); });
document.querySelectorAll('#segEdge button').forEach(b => b.onclick = () => {
  S.col.edge = +b.dataset.v; segOn('segEdge', S.col.edge); colUI(); draw(); });
document.querySelectorAll('#segPage button').forEach(b => b.onclick = () => {
  const [w,h] = b.dataset.v.split(',').map(Number);
  S.run.w = w; S.run.h = h; segOn('segPage', b.dataset.v); layout(); fit(); draw(); });
document.querySelectorAll('#segDir button').forEach(b => b.onclick = () => {
  S.vert = b.dataset.v === 'v'; segOn('segDir', b.dataset.v); draw(); });
function colUI(){
  $('wCol2').style.display = S.col.grad ? '' : 'none';
  $('wGang').style.display = S.col.grad ? '' : 'none';
  $('wEdge').style.display = S.col.edge ? '' : 'none';
}
$('col').addEventListener('input', e => { S.col.col = e.target.value; draw(); });
$('col2').addEventListener('input', e => { S.col.col2 = e.target.value; draw(); });
$('edgeCol').addEventListener('input', e => { S.col.edgeCol = e.target.value; draw(); });
$('bg').addEventListener('input', e => { S.col.bg = e.target.value; draw(); });

/* ══⭐⭐ 型 ── ひと当て。⚠️ 打った字と書体は変えない（組んだものが消えない） ══ */
const KATA = {
  c1:{ pen:{w:96,taper:62,miter:52,sweep:80,straight:88,vary:26,jit:7},
       run:{size:150,adv:80,ang:-22,wide:62,tall:130,jr:10,x:6,y:46},
       col:{col:'#ff3fb0',col2:'#6a2bd9',grad:1,gang:14,edge:0,edgeW:6,edgeCol:'#2a1c33',bg:'#ffffff'} },
  c2:{ pen:{w:82,taper:70,miter:44,sweep:88,straight:92,vary:32,jit:9},
       run:{size:145,adv:82,ang:-18,wide:60,tall:138,jr:14,x:6,y:48},
       col:{col:'#ffffff',col2:'#ffffff',grad:0,gang:0,edge:1,edgeW:5,edgeCol:'#2a1c33',bg:'#3b2340'} },
  c3:{ pen:{w:64,taper:78,miter:66,sweep:92,straight:94,vary:22,jit:5},
       run:{size:150,adv:78,ang:-26,wide:56,tall:142,jr:8,x:6,y:48},
       col:{col:'#ffffff',col2:'#ffffff',grad:0,gang:0,edge:0,edgeW:6,edgeCol:'#2a1c33',bg:'#5a1f2a'} },
};
document.querySelectorAll('#segKata button').forEach(b => b.onclick = () => {
  const k = KATA[b.dataset.v]; if(!k) return;
  Object.assign(S.pen, k.pen); Object.assign(S.run, k.run); Object.assign(S.col, k.col);
  segOn('segKata', b.dataset.v);
  glyphCache.clear(); syncAll(); draw();
});

/* ══ 出す ══ */
function dl(blob, name){ const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 4000); }
$('ePNG').onclick = () => {
  const [BW,BH] = boardSize(), k = S.out.long / Math.max(BW,BH);
  const c = document.createElement('canvas');
  c.width = Math.round(BW*k); c.height = Math.round(BH*k);
  paint(c.getContext('2d'), c.width, c.height, {});
  c.toBlob(b => dl(b, 'sen.png'), 'image/png');
};
$('eSVG').onclick = () => {
  const [W,H] = boardSize();
  const body = paint(document.createElement('canvas').getContext('2d'), W, H, { svg:true });
  const rad = (S.col.gang||0)*Math.PI/180, rr = Math.hypot(W,H)/2;
  const defs = S.col.grad
    ? `<defs><linearGradient id="sg" gradientUnits="userSpaceOnUse"`
      + ` x1="${(W/2-Math.cos(rad)*rr).toFixed(1)}" y1="${(H/2-Math.sin(rad)*rr).toFixed(1)}"`
      + ` x2="${(W/2+Math.cos(rad)*rr).toFixed(1)}" y2="${(H/2+Math.sin(rad)*rr).toFixed(1)}">`
      + `<stop offset="0" stop-color="${S.col.col}"/><stop offset="1" stop-color="${S.col.col2}"/>`
      + `</linearGradient></defs>` : '';
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`
    + defs + `<g id="sen">${body.join('')}</g></svg>`;
  dl(new Blob([svg],{type:'image/svg+xml'}), 'sen.svg');
};

function syncAll(){
  ['w','taper','miter','sweep','straight','vary','jit'].forEach(id => {
    const e=$(id), o=$('o_'+id); if(e){ e.value = S.pen[id]; if(o) o.textContent = S.pen[id]; } });
  ['size','adv','ang','wide','tall','jr','x','y','seed'].forEach(id => {
    const e=$(id), o=$('o_'+id); if(e){ e.value = S.run[id]; if(o) o.textContent = S.run[id]; } });
  $('col').value = S.col.col; $('col2').value = S.col.col2;
  $('edgeCol').value = S.col.edgeCol; $('bg').value = S.col.bg;
  $('gang').value = S.col.gang; $('o_gang').textContent = S.col.gang;
  $('edgeW').value = S.col.edgeW; $('o_edgeW').textContent = S.col.edgeW;
  segOn('segGrad', S.col.grad); segOn('segEdge', S.col.edge);
  segOn('segPage', S.run.w+','+S.run.h); segOn('segDir', S.vert?'v':'h');
  colUI();
}
$('zi').onclick = () => { Z = Math.min(4, Z*1.2); place2(); };
$('zo').onclick = () => { Z = Math.max(.05, Z/1.2); place2(); };
$('bFit').onclick = fit;
addEventListener('resize', () => { fit(); });
S.vert = false;
syncAll(); layout(); fit(); draw();
</script></body></html>
