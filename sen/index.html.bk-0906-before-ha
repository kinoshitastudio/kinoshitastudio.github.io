                'ぁ':'あ','ぃ':'い','ぅ':'う','ぇ':'え','ぉ':'お','っ':'つ','ゃ':'や','ゅ':'ゆ','ょ':'よ','ゎ':'わ' };

const boneCache = new Map();
/* ⭐⭐ 骨の出どころ ── かなは【手で持った骨】／漢字は【書体から起こす】
   ⚠️ 字ごとに出どころが違ってよい（どちらも「骨」であることは同じ）。 */
function boneOf(ch){
  /* 小書き＝親の骨を縮めて右下へ寄せる */
  if(SMALL[ch]){
    const b = boneOf(SMALL[ch]);
    return b.map(l => l.map(([x,y]) => [x*0.62+0.30, y*0.62+0.34]));
  }
  /* 濁点・半濁点＝NFD で base＋印に割る（ガ＝カ＋゛） */
  const d = ch.normalize('NFD');
  if(d.length === 2 && MARK[d[1]]){
    const base = boneOf(d[0]);
    return base.map(l => l.map(([x,y]) => [x*0.90, y*0.94+0.04])).concat(MARK[d[1]]);
  }
  if(KANA[ch]) return KANA[ch];
  return boneFromFont(ch);
}
function boneFromFont(ch){
  const key = ch + '|' + S.fam;
  if(boneCache.has(key)) return boneCache.get(key);
  const N = 128;
  const c = document.createElement('canvas'); c.width = c.height = N;
  const g = c.getContext('2d');
  g.fillStyle = '#fff'; g.fillRect(0,0,N,N);
  g.fillStyle = '#000';
  g.font = '700 ' + Math.round(N*0.78) + 'px ' + FAM[S.fam];
  g.textAlign = 'center'; g.textBaseline = 'middle';
  g.fillText(ch, N/2, N*0.52);
  const d = g.getImageData(0,0,N,N).data;
  const A = new Uint8Array(N*N);
  for(let i=0;i<N*N;i++) A[i] = d[i*4] < 128 ? 1 : 0;
  const at = (a,x,y) => (x<0||y<0||x>=N||y>=N) ? 0 : a[y*N+x];
  for(let pass=0; pass<40; pass++){
    let changed = 0;
    for(let sub=0; sub<2; sub++){
      const del = [];
      for(let y=1;y<N-1;y++) for(let x=1;x<N-1;x++){
        if(!at(A,x,y)) continue;
        const P = [at(A,x,y-1),at(A,x+1,y-1),at(A,x+1,y),at(A,x+1,y+1),
                   at(A,x,y+1),at(A,x-1,y+1),at(A,x-1,y),at(A,x-1,y-1)];
        const B = P.reduce((s,v)=>s+v,0);
        if(B < 2 || B > 6) continue;
        let Ac = 0; for(let i=0;i<8;i++) if(P[i]===0 && P[(i+1)%8]===1) Ac++;
        if(Ac !== 1) continue;
        if(sub === 0){ if(P[0]*P[2]*P[4] || P[2]*P[4]*P[6]) continue; }
        else         { if(P[0]*P[2]*P[6] || P[0]*P[4]*P[6]) continue; }
        del.push(y*N+x);
      }
      del.forEach(i => { A[i] = 0; }); changed += del.length;
    }
    if(!changed) break;
  }
  const nb = (x,y) => { const o=[];
    for(let dy=-1;dy<=1;dy++) for(let dx=-1;dx<=1;dx++){
      if(!dx && !dy) continue; if(at(A,x+dx,y+dy)) o.push([x+dx,y+dy]); }
    return o; };
  const used = new Set(), lines = [];
  const walk = (sx,sy) => {
    const line = [[sx,sy]]; used.add(sy*N+sx);
    let x = sx, y = sy;
    for(let step=0; step<4000; step++){
      const ns = nb(x,y).filter(([a,b]) => !used.has(b*N+a));
      if(ns.length !== 1) break;
      [x,y] = ns[0]; used.add(y*N+x); line.push([x,y]);
    }
    return line;
  };
  const starts = [];
  for(let y=0;y<N;y++) for(let x=0;x<N;x++) if(at(A,x,y) && nb(x,y).length !== 2) starts.push([x,y]);
  starts.forEach(([x,y]) => { if(!used.has(y*N+x)) { const l = walk(x,y); if(l.length>3) lines.push(l); } });
  for(let y=0;y<N;y++) for(let x=0;x<N;x++)
    if(at(A,x,y) && !used.has(y*N+x)){ const l = walk(x,y); if(l.length>3) lines.push(l); }
  let out = lines.map(l => {
    const keep = Math.max(1, Math.round(l.length/12));
    const t = l.filter((_,i) => i % keep === 0);
    if(t[t.length-1] !== l[l.length-1]) t.push(l[l.length-1]);
    return t.map(([x,y]) => [x/N, y/N]);
  }).filter(l => l.length >= 2);

  /* ══⭐⭐ ここが芯 ── 細線化の骨は【交差点で切れて細切れ】になる ══
     🔴 そのまま筆を着せると、参考のような「1本で長く続く線」にならず、
        短い棘の集まりに見える（2026-09-03 木下＝「全然違うくないか？」）。
     ⭐ だから起こしたあとで
        ① 短すぎる破片を捨てる（交差点のヒゲ）
        ② 端どうしが近く、向きも揃っている線を【1本に繋ぐ】
        ③ 書き順らしい順（上→左）に並べ替える
     ⚠️ ②は向きを見ないと、まったく違う画どうしが繋がって字が壊れる。 */
  const LEN = l => { let d=0; for(let i=1;i<l.length;i++) d+=Math.hypot(l[i][0]-l[i-1][0], l[i][1]-l[i-1][1]); return d; };
  out = out.filter(l => LEN(l) > 0.035);                    /* ① ヒゲを捨てる */
  const dirOf = (l, atEnd) => {                              /* 端での向き */
    const a = atEnd ? l[l.length-1] : l[0];
    const b = atEnd ? l[Math.max(0,l.length-3)] : l[Math.min(l.length-1,2)];
    const dx = a[0]-b[0], dy = a[1]-b[1], m = Math.hypot(dx,dy)||1;
    return [dx/m, dy/m];
  };
  const TOL = 0.085;                                         /* この距離までなら繋ぐ */
  for(let pass=0; pass<40; pass++){
    let joined = false;
    outer:
    for(let i=0;i<out.length;i++) for(let j=0;j<out.length;j++){
      if(i===j) continue;
      const A = out[i], B = out[j];
      const ea = A[A.length-1], sb = B[0];
      const d = Math.hypot(ea[0]-sb[0], ea[1]-sb[1]);
      if(d > TOL) continue;
      const da = dirOf(A,true), db = dirOf(B,false);
      /* ⚠️ 向きが揃っているものだけ繋ぐ（内積 > 0.15 ＝ 80度以内） */
      if(da[0]*(-db[0]) + da[1]*(-db[1]) < 0.15 && d > 0.02) continue;
      out[i] = A.concat(B.slice(1)); out.splice(j,1); joined = true; break outer;
    }
    if(!joined) break;
  }
  /* ③ 書き順らしい順（上のもの → 左のもの） */
  out.sort((a,b) => (a[0][1]+a[0][0]*0.35) - (b[0][1]+b[0][0]*0.35));
  if(boneCache.size > 400) boneCache.clear();
  boneCache.set(key, out);
  return out;
}

function resample(pts, step){
  const out = [pts[0]];
  let carry = 0;
  for(let i=1;i<pts.length;i++){
    const a = out[out.length-1], b = pts[i];
    let d = Math.hypot(b[0]-a[0], b[1]-a[1]);
    let px = a[0], py = a[1];
    while(carry + d >= step){
      const t = (step - carry)/d;
      px = px + (b[0]-px)*t; py = py + (b[1]-py)*t;
      out.push([px,py]);
      d = Math.hypot(b[0]-px, b[1]-py); carry = 0;
    }
    carry += d;
  }
  const last = pts[pts.length-1];
  if(Math.hypot(last[0]-out[out.length-1][0], last[1]-out[out.length-1][1]) > 1e-6) out.push(last);
  return out;
}

/* ══════════════════════════════════════════════════════════════
   ② ペン ── 骨1本を、閉じた輪郭（帯）にする
   ⭐ 筆（奔HON）との違いは3つだけ。
     ① 角を【折る】＝前後の辺の法線を足して 1/cos(θ/2) で伸ばす（留め継ぎ）
     ② 払いを【まっすぐ】伸ばす＝終わりの何点かを均した向きで出る
     ③ 幅のムラは【曲がり具合】から出す（速いほど細い）
   ══════════════════════════════════════════════════════════════ */
/* ══════════════════════════════════════════════════════════════
   ⭐⭐⭐ 手書きの芯 ── 調べて分かった4つ（2026-09-03）
   木下＝「まだだな、筆記体　手書きだ」

   ① 骨は【折れ線】のままでは絶対に手書きにならない。人の手は角を作らない。
     → Catmull-Rom スプラインで骨を通る【滑らかな曲線】にする（G1連続）。
       出典：Catmull-Rom を使った手書きの平滑化は筆記評価の研究でも標準
       https://vestnik.ku.edu.kz/jour/article/view/2282

   ② 【2/3乗則】── 手は曲がる所で遅くなる。v = α·κ^(-1/3)（κ＝曲率）。
     描画・眼球・歩行、さらに【想像した軌跡】にまで出る、運動計画そのものの法則。
     https://www.jneurosci.org/content/22/18/8201
     → 速さから幅を出す＝速い所は細く、曲がる所は太い。これが手書きの見え方の正体。

   ③ 【シグマ・ログノーマル】（Plamondon の運動学理論）── 1画の速さは
     ログノーマル（山が前寄りの非対称な山）。書き始めはゆっくり、すぐ速くなり、
     終わりへ長く尾を引く。だから【終筆が長く細く伸びる】。
     https://www.researchgate.net/publication/318431706

   ④ 日本語の手書きロゴは【右上がり】。角度を付けると動きが出る。
     同じ字が2回出たら同じに見せない。
     https://wkwkdesign.com/japanese-handwritten-font/ ／ Adobe の手描きロゴ指南
   ══════════════════════════════════════════════════════════════ */

/* ⭐ Catmull-Rom ── 骨の点を【通る】滑らかな曲線にする。
   ⚠️ ベジェと違い制御点を通るので、骨の形が保たれる。 */
function spline(pts, per){
  if(pts.length < 2) return pts;
  if(pts.length === 2){
    const out=[]; for(let i=0;i<=per;i++){ const t=i/per;
      out.push([pts[0][0]+(pts[1][0]-pts[0][0])*t, pts[0][1]+(pts[1][1]-pts[0][1])*t]); }
    return out;
  }
  const P = [pts[0], ...pts, pts[pts.length-1]];   /* 両端を伸ばす */
  const out = [];
  for(let i=1;i<P.length-2;i++){
    const p0=P[i-1], p1=P[i], p2=P[i+1], p3=P[i+2];
    for(let j=0;j<per;j++){
      const t=j/per, t2=t*t, t3=t2*t;
      out.push([
        0.5*((2*p1[0]) + (-p0[0]+p2[0])*t + (2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2 + (-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3),
        0.5*((2*p1[1]) + (-p0[1]+p2[1])*t + (2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2 + (-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)
      ]);
    }
  }
  out.push(P[P.length-2]);
  return out;
}
/* ⭐ 曲率（3点から外接円の半径の逆数） */
function curvature(a,b,c){
  const ax=a[0],ay=a[1],bx=b[0],by=b[1],cx=c[0],cy=c[1];
  const A = Math.hypot(bx-ax,by-ay), B = Math.hypot(cx-bx,cy-by), C = Math.hypot(cx-ax,cy-ay);
  const area2 = Math.abs((bx-ax)*(cy-ay) - (cx-ax)*(by-ay));
  if(A*B*C < 1e-9) return 0;
  return 2*area2/(A*B*C);            /* κ = 4S/(abc) ×… の形。0＝直線 */
}
/* ⭐ ログノーマルの速さ（Plamondon）── 前寄りの山。t は 0〜1 */
function lognormalV(t, mu, sig){
  const x = Math.max(1e-4, Math.min(1-1e-4, t));
  const z = (Math.log(x) - mu) / sig;
  return Math.exp(-0.5*z*z) / (x*sig);
}

/* ⭐ 角を丸める（続け書きにする）。⚠️ 筆を着せる【前】に掛ける */
function chaikin(pts, k, times){
  if(k <= 0 || pts.length < 3) return pts;
  let P = pts;
  for(let t=0;t<times;t++){
    const out = [P[0]];
    for(let i=0;i<P.length-1;i++){
      const a = P[i], b = P[i+1];
      out.push([ a[0] + (b[0]-a[0])*(0.25*k), a[1] + (b[1]-a[1])*(0.25*k) ]);
      out.push([ a[0] + (b[0]-a[0])*(1-0.25*k), a[1] + (b[1]-a[1])*(1-0.25*k) ]);
    }
    out.push(P[P.length-1]);
    P = out;
  }
  return P;
}
function penOutline(pts, w, seed){
  const P = S.pen;
  /* ⭐⭐① まず【スプラインで滑らかにする】。ここを飛ばすと何をしても折れ線に見える。 */
  pts = spline(pts, Math.max(3, Math.round(4 + (P.round/100)*10)));
  pts = chaikin(pts, P.round/100 * 0.5, 1);
  /* ── 払い＝終筆だけ長く。⚠️ 入りと同じ長さだと「ただの延長」に見える ── */
  const ovIn  = w * 0.10;
  /* ⚠️ ペンの伸ばし量（w×5）を筆に使うと、払いが全部【下に垂れる】。
     筆は毛が持ち上がって離れるので、伸びる長さはずっと短い。 */
  const ovOut = ovIn + (P.sweep/100) * w * ((P.tool==='fude') ? 1.5 : 5.0);
  if(pts.length >= 2){
    const ext = (a,b,d0) => { const d = Math.hypot(b[0]-a[0], b[1]-a[1]) || 1;
      return [ a[0] + (a[0]-b[0])/d*d0, a[1] + (a[1]-b[1])/d*d0 ]; };
    /* ⭐ 直線度＝終わりの何点かを均した向きで伸ばす（骨が曲がっていても払いは直線） */
    const kStr = P.straight/100;
    let tail = pts[pts.length-2];
    if(kStr > 0 && pts.length >= 4){
      const back = Math.max(2, Math.round((pts.length-1) * (0.08 + 0.30*kStr)));
      const far = pts[Math.max(0, pts.length-1-back)];
      tail = [ pts[pts.length-2][0]*(1-kStr) + far[0]*kStr,
               pts[pts.length-2][1]*(1-kStr) + far[1]*kStr ];
    }
    pts = [ext(pts[0], pts[1], ovIn), ...pts, ext(pts[pts.length-1], tail, ovOut)];
  }
  const R = resample(pts, Math.max(1.5, w*0.10));   /* ⚠️ 粗いとスプラインの滑らかさが死ぬ */
  const n = R.length;
  if(n < 2) return null;

  /* 震え＝道のりに沿ったなめらかな乱れ */
  const r = rnd(seed);
  const cell = 6, m = Math.ceil(n/cell)+2, nz = [];
  for(let i=0;i<m;i++) nz.push(r()*2-1);
  const wob = i => { const f=i/cell, k=f|0, t=f-k, s=t*t*(3-2*t);
    return (nz[k%m])*(1-s) + (nz[(k+1)%m])*s; };
  const amp = (P.jit/100) * w * 0.34;

  /* ══⭐⭐② 2/3乗則 ＋ ③ログノーマル ══
     ⭐ 速さ v = α·κ^(-1/3)（曲がるほど遅い）。そこに1画ぶんのログノーマルを掛ける。
       → 書き始めゆっくり・中ほど速い・終わりへ長い尾。
     ⭐ 幅は【速さの逆】。速い所は細く、遅い所（＝曲がる所・書き始め）は太い。
     ⚠️ 曲率をそのまま使うと1コマで跳ぶので、あとで隣どうしを均す。 */
  const isF = (P.tool === 'fude');
  const vk = (isF ? P.fvary : P.vary)/100, raw = new Array(n);
  const vs = new Array(n);
  const mu = -0.9, sig = 0.55;                  /* 山が前寄り＝速く立ち上がって長く尾を引く */
  let lnMax = 0;
  for(let i=0;i<n;i++) lnMax = Math.max(lnMax, lognormalV(i/(n-1||1), mu, sig));
  for(let i=0;i<n;i++){
    const a = R[Math.max(0,i-1)], c = R[i], b = R[Math.min(n-1,i+1)];
    const kap = curvature(a,c,b) * w;           /* 太さで正規化＝大きさによらない */
    const vCurv = Math.pow(1 + kap*6, -1/3);    /* 2/3乗則（κ→∞ で v→0） */
    const vLog  = lognormalV(i/(n-1||1), mu, sig) / (lnMax||1);
    const v = Math.max(0.06, vCurv * (0.35 + 0.65*vLog));
    vs[i] = v;
    /* 幅＝速さの逆（速い＝細い）。vk で効き具合 */
    raw[i] = 1 + vk*((1/Math.max(0.25,v) - 1.0)*0.55 - 0.18 + wob(i+97)*0.35);
  }
  /* ══⭐⭐ 筆 ── ペンとの違いは【振れ幅】。ペンは 1〜1.4倍しか変わらない。
     筆は「いちばん遅い所を満幅」にして、速い所を比で細らせる＝針まで行く。
     ⚠️ 乱数ではなく速さの比。だから同じ骨なら同じ所が細る（筆に見える）。 */
  if(isF){
    /* ⚠️ 最初これを「いちばん遅い1点だけ満幅」の式にしたら、字が全部針になった。
       ⭐ 速さの【幅ぜんぶ】を 満幅→毛先 に割り当てる。だから太い所は必ず太い。 */
    let vmin = Infinity, vmax = 0;
    for(let i=0;i<n;i++){ if(vs[i]<vmin) vmin=vs[i]; if(vs[i]>vmax) vmax=vs[i]; }
    const span = Math.max(1e-6, vmax - vmin);
    const thin = Math.pow(0.10, vk);          /* つまみ0＝一定、100＝10%まで細る */
    for(let i=0;i<n;i++){
      const u = (vs[i] - vmin) / span;        /* 0＝いちばん遅い（太い）／1＝いちばん速い（細い） */
      raw[i] = (1 - (1-thin)*Math.pow(u, 0.85)) * (1 + wob(i+97)*0.08*vk);
    }
  }
  /* ⚠️ 筆は1コマで太さが跳ばない＝3回均す */
  let vv = raw.slice();
  for(let pass=0; pass<3; pass++){
    const t = vv.slice();
    for(let i=0;i<n;i++){
      const a = t[Math.max(0,i-1)], c = t[i], b = t[Math.min(n-1,i+1)];
      vv[i] = (a + c*2 + b)/4;
    }
  }
  const vary = vv.map(x => Math.max(isF ? 0.015 : 0.14, x));   /* ⭐ 筆は 1.5% まで細れる＝毛先 */

  const kM = P.miter/100, kT = P.taper/100;
  const L = [], Rt = [];
  for(let i=0;i<n;i++){
    const a = R[Math.max(0,i-1)], b = R[Math.min(n-1,i+1)];
    let nx = -(b[1]-a[1]), ny = (b[0]-a[0]);
    const len = Math.hypot(nx,ny) || 1; nx/=len; ny/=len;
    /* ⭐⭐ 角を【折る】── 前後の辺の法線を足して 1/cos(θ/2) で伸ばす。
       ⚠️ 鋭角では無限に伸びるので【留めの上限 5.5倍】で頭打ちにする。 */
    if(kM > 0 && !isF && i > 0 && i < n-1){   /* ⭐ 角を折るのはペンだけ。筆は毛が回るので丸まる */
      const p0 = R[i-1], p1 = R[i], p2 = R[i+1];
      let n1x = -(p1[1]-p0[1]), n1y = (p1[0]-p0[0]); const l1 = Math.hypot(n1x,n1y)||1; n1x/=l1; n1y/=l1;
      let n2x = -(p2[1]-p1[1]), n2y = (p2[0]-p1[0]); const l2 = Math.hypot(n2x,n2y)||1; n2x/=l2; n2y/=l2;
      let mx = n1x+n2x, my = n1y+n2y; const ml = Math.hypot(mx,my);
      if(ml > 1e-4){
        mx/=ml; my/=ml;
        const cosHalf = Math.max(0.18, mx*n1x + my*n1y);
        const grow = Math.min(5.5, 1/cosHalf);
        let ax = nx*(1-kM) + mx*kM, ay = ny*(1-kM) + my*kM;
        const al = Math.hypot(ax,ay)||1;
        const keep = 1 + (grow-1)*kM;
        nx = ax/al*keep; ny = ay/al*keep;
      }
    }
    const t = i/(n-1);
    /* 入りは短く鈍く・抜きは長く鋭く（速く払った跡） */
    let wid;
    if(isF){
      /* ══⭐⭐ 筆の入り抜き ── 左右で全く違う ══
         入り＝【打ち込み】。押し当てるので短くて鈍い。
         抜き＝【払い】。持ち上げながら走るので長く、先は毛1本まで行く。
         🔴 ここが参考と一番違っていた所。ペンは先が 38% で止まっていた。 */
      const kF = P.ftaper/100;
      const eIn  = Math.min(1, t*6.0);
      const eOut = Math.min(1, (1-t)*1.15);
      const tipIn  = 0.42 + 0.30*(1-kF);            /* 入りは鈍い */
      const tipOut = 0.28*(1-kF)*(1-kF);            /* 抜きは針（つまみ100で 0） */
      const sIn  = tipIn  + (1-tipIn )*Math.pow(eIn , 0.50);
      const sOut = tipOut + (1-tipOut)*Math.pow(eOut, 1.70);
      wid = w * vary[i] * Math.min(sIn, sOut) * 0.5;
    } else {
      const eIn = Math.min(1, t*8), eOut = Math.min(1, (1-t)*2.0);
      const e = Math.min(eIn, eOut);
      wid = w * vary[i] * (1 - kT*(1 - Math.pow(e, 0.80))) * 0.5;
    }
    const cxp = R[i][0] + nx*wob(i)*amp, cyp = R[i][1] + ny*wob(i)*amp;
    L.push([cxp + nx*wid, cyp + ny*wid]);
    Rt.push([cxp - nx*wid, cyp - ny*wid]);
  }
  return L.concat(Rt.reverse());
}

/* 1字ぶんの輪郭（複数の帯） */
const glyphCache = new Map();
const glyphEnds = new Map();
function glyphKey(ch, i){
  const P = S.pen;
  return ch + '|' + S.fam + '|' + [P.w,P.taper,P.miter,P.round,P.link,P.sweep,P.straight,P.vary,P.jit,P.warp,S.run.seed,i].join(',');
}
/* ══⭐⭐ 連綿 ── 字と字を【細い渡り】でつなぐ ══
   ⭐ 参考が「一筆で書いた」ように見えるのは、字の中だけでなく
     【字をまたいで】宙を通った跡が残っているから。
   ⚠️ 両端は 0 まで絞る。太いまま繋ぐと「棒でつないだ」ようにしか見えない。 */
function renmenRing(a, b, w, bow){
  const dx = b[0]-a[0], dy = b[1]-a[1], d = Math.hypot(dx,dy);
  if(d < 1e-3) return null;
  const nx = -dy/d, ny = dx/d, N = 26, L = [], R = [];
  for(let i=0;i<=N;i++){
    const t = i/N, sn = Math.sin(t*Math.PI);
    const cx = a[0] + dx*t + nx*bow*d*sn, cy = a[1] + dy*t + ny*bow*d*sn;
    const wid = w * 0.5 * Math.pow(sn, 0.62);
    L.push([cx + nx*wid, cy + ny*wid]);
    R.push([cx - nx*wid, cy - ny*wid]);
  }
  return L.concat(R.reverse());
}
function glyph(ch, i){
  const P = S.pen;
  const key = ch + '|' + S.fam + '|' + [P.w,P.taper,P.miter,P.round,P.link,P.sweep,P.straight,P.vary,P.jit,P.warp,S.run.seed,i].join(',');
  if(glyphCache.has(key)) return glyphCache.get(key);
  let bones = boneOf(ch);
  /* ══⭐⭐ 続け書き ── 画と画を【細い線】で繋ぐ ══
     ⭐ 参考は「一筆で書いた」ように見える。前の画の終わりから次の画の始まりへ、
       宙を通った跡（渡り）が薄く残っている＝それが続け書き。
     ⚠️ 全部繋ぐと字が読めなくなるので、【近い所だけ】繋ぐ。 */
  const kLink = P.link/100;
  if(kLink > 0 && bones.length > 1){
    const merged = [];
    let cur = bones[0].slice();
    for(let bi=1; bi<bones.length; bi++){
      const prev = cur[cur.length-1], next = bones[bi][0];
      const d = Math.hypot(prev[0]-next[0], prev[1]-next[1]);
      /* 繋ぐ距離の上限＝つまみで決まる（0.10〜0.55） */
      if(d < 0.10 + 0.45*kLink){ cur = cur.concat(bones[bi]); }
      else { merged.push(cur); cur = bones[bi].slice(); }
    }
    merged.push(cur); bones = merged;
  }
  /* ══⭐⭐ 手書き感 ── 骨【そのもの】を崩す ══ 2026-09-03 木下＝「日本語の手書き感全然できてない」
     🔴 筆の側（幅・入り抜き）だけ触っても手書きにはならない。
       人は【骨をそのまま書かない】＝ 端が伸びる・中がふくらむ・全体が少し流れる。
     ⭐ だから骨の点を、字ごとに違う向きへ寄せる（種で決まる＝同じ種なら同じ字）。 */
  const kW = P.warp/100;
  if(kW > 0){
    const rw = rnd(S.run.seed*104729 + i*7919 + 13);
    const g1 = rw()*2-1, g2 = rw()*2-1, g3 = rw()*2-1;   /* 字ごとの癖 */
    bones = bones.map((l, li) => {
      const r2 = rnd(S.run.seed*31 + i*997 + li*61);
      const a1 = r2()*2-1, a2 = r2()*2-1;
      const L = l.length;
      return l.map(([x,y], pi) => {
        const t = L>1 ? pi/(L-1) : 0;
        /* ① 全体が少し流れる（字ごとの癖） */
        let nx = x + kW*0.055*g1*(y-0.5)*2 + kW*0.030*g2;
        let ny = y + kW*0.045*g3*(x-0.5)*2;
        /* ② 中がふくらむ（真ん中ほど外へ） */
        const bulge = Math.sin(t*Math.PI);
        nx += kW*0.048*a1*bulge;
        ny += kW*0.040*a2*bulge;
        /* ③ 端が伸びる（書き始めと書き終わりが強く出る） */
        const edge = (t<0.2 ? (0.2-t)/0.2 : t>0.8 ? (t-0.8)/0.2 : 0);
        nx += kW*0.035*a2*edge;
        ny += kW*0.030*a1*edge;
        return [nx, ny];
      });
    });
  }
  /* ⭐ 連綿のために、この字の【書き始め】と【書き終わり】を控える（骨の座標のまま） */
  const first = bones[0], last = bones[bones.length-1];
  glyphEnds.set(key, {
    a: [first[0][0]*1000, first[0][1]*1000],
    b: [last[last.length-1][0]*1000, last[last.length-1][1]*1000] });
  const out = [];
  bones.forEach((b, bi) => {
    const pts = b.map(p => [p[0]*1000, p[1]*1000]);
    const ring = penOutline(pts, (P.tool==='fude' ? P.fw : P.w), S.run.seed*7919 + i*131 + bi*17);
    if(ring) out.push(ring);
  });
  if(glyphCache.size > 600){ glyphCache.clear(); glyphEnds.clear(); }
  glyphCache.set(key, out);
  return out;
}

/* ══════════════════════════════════════════════════════════════
   ③ 走らせる ── 版面の上に並べる（横組／縦組）
   ⭐ 縦組は「送りの向きが下」になるだけ。走る角度はそのまま効く。
   ⚠️ 縦組で角度を付けると【右下へ流れる】＝それが正しい（看板の縦書きはそう流れる）。
   ══════════════════════════════════════════════════════════════ */
function boardSize(){
  if(S.view === 'sheet'){ return [1400, 900]; }
  return [S.run.w, S.run.h];
}
function runChars(){ return [...S.text].filter(c => c !== '\n'); }

function place(){
  const R = S.run, chars = runChars(), n = chars.length;
  const [BW,BH] = boardSize();
  const size = BW * R.size/1000;
  const adv = size * R.adv/100;
  const rad = R.ang*Math.PI/180, ca = Math.cos(rad), sa = Math.sin(rad);
  const r = rnd(R.seed*31+5);
  const ox = BW * R.x/100, oy = BH * R.y/100;
  return chars.map((ch,i) => {
    const jr = (r()*2-1) * R.jr * 0.35;
    /* ⭐ 縦組＝送りの向きが【下】。横組＝【右】。行の傾きはどちらにも効く。 */
    const dx = S.vert ? (i*adv*(-sa)) : (i*adv*ca);
    const dy = S.vert ? (i*adv*ca)    : (i*adv*sa);
    /* ══🔴🔴 ここが「向きが違う」の正体 ══ 2026-09-03 木下＝「全然だめだむきも違うし」
       ⚠️ 前は【行の傾き】と【字の傾き】を1本のつまみでやっていた。
         ＝ 行を右上がりにすると、字まで一緒に転ぶ。
       ⭐ 実際の手書きは「行は右上がりだが、字は立っている」。
         参考のプレイボールは行がほぼ水平で字が立つ／ファーストクラスは行が上がり字も倒れる。
         ＝ 別々に持てば、どちらも作れる。 */
    return { ch, i, x: ox + dx, y: oy + dy, rot: R.slant + jr, size };
  });
}

function drawGlyph(g, ch, x, y, size, rot, colFill, i, svg, M0){
  const rings = glyph(ch, i);
  if(!rings.length) return;
  const k = size/1000;
  g.save();
  g.translate(x, y);
  if(rot){ g.translate(size/2, size/2); g.rotate(rot*Math.PI/180); g.translate(-size/2, -size/2); }
  g.scale(k * S.run.wide/100, k * S.run.tall/100);
  g.beginPath();
  rings.forEach(r => { g.moveTo(r[0][0], r[0][1]);
    for(let j=1;j<r.length;j++) g.lineTo(r[j][0], r[j][1]); g.closePath(); });

  /* ⭐⭐ ふち（袋文字）── 帯を1本ずつ縁取ると【中の継ぎ目まで線が出る】。
     だから「ふちの色で stroke＋fill」→ その上に字の色、の2枚組にする＝外側だけに線が出る。 */
  if(S.col.edge){
    g.strokeStyle = S.col.edgeCol; g.fillStyle = S.col.edgeCol;
    g.lineJoin = 'round'; g.lineCap = 'round';
    g.lineWidth = (S.col.edgeW||6) * 2 / (k || 1);
    g.stroke(); g.fill();
  }
  /* ⭐⭐ グラデは【版面ぜんぶを1本】。字ごとに作ると字の中で縞になる。
     変形を掛ける前の行列を控えておき、盤の座標 → この字の座標 に直して端点を置く。 */
  let paint = colFill;
  if(!svg && S.col.grad && M0 && g.getTransform){
    try{
      const B2L = g.getTransform().inverse().multiply(M0);
      const [BW,BH] = boardSize();
      const rad = (S.col.gang||0)*Math.PI/180, rr = Math.hypot(BW,BH)/2;
      const a = new DOMPoint(BW/2 - Math.cos(rad)*rr, BH/2 - Math.sin(rad)*rr).matrixTransform(B2L);
      const b = new DOMPoint(BW/2 + Math.cos(rad)*rr, BH/2 + Math.sin(rad)*rr).matrixTransform(B2L);
      const gr = g.createLinearGradient(a.x, a.y, b.x, b.y);
      gr.addColorStop(0, S.col.col); gr.addColorStop(1, S.col.col2);
      paint = gr;
    }catch(e){}
  }
  g.fillStyle = paint;
  g.fill();   /* nonzero＝帯どうしが重なっても穴が空かない */
  g.restore();

  if(svg){
    const rd = rot*Math.PI/180, c = size/2;
    const tp = p => {
      let X = p[0]*k*(S.run.wide/100), Y = p[1]*k*(S.run.tall/100);
      if(rot){ const dx=X-c, dy=Y-c; X = c + dx*Math.cos(rd) - dy*Math.sin(rd); Y = c + dx*Math.sin(rd) + dy*Math.cos(rd); }
      return [(x+X).toFixed(1), (y+Y).toFixed(1)];
    };
    const d = rings.map(r => 'M' + r.map(p => tp(p).join(' ')).join('L') + 'Z').join('');
    if(S.col.edge)
      svg.push(`<path d="${d}" fill="${S.col.edgeCol}" stroke="${S.col.edgeCol}" stroke-width="${(S.col.edgeW||6)*2}" stroke-linejoin="round" stroke-linecap="round"/>`);
    svg.push(`<path d="${d}" fill="${S.col.grad ? 'url(#sg)' : S.col.col}"/>`);
  }
}

/* ══⭐⭐ 手で置いた骨を、打った字と【同じ筆】に通す ══
   ⭐ 太さは字の大きさに合わせる＝太さのつまみの意味が「打つ」時と揃う。
   ⚠️ warp（骨をゆがめる）は掛けない。手で置いた骨には、もう人のゆらぎが入っている。
     （[[手書きは点が置けない]]＝崩し量は「元がどこから来たか」で変える） */
function drawnRings(){
  const P = S.pen, out = [];
  const w = (P.tool === 'fude' ? P.fw : P.w) * (S.run.size/1000);
  S.draw.forEach((st, i) => {
    if(st.length < 2) return;
    const ring = penOutline(st.map(p => [p[0], p[1]]), w, 9176 + i*131);
    if(ring) out.push(ring);
  });
  /* 連綿＝画と画のあいだ（打つ時と同じ考え方） */
  if(P.tool === 'fude' && P.renmen > 0){
    const kR = P.renmen/100;
    for(let i=0;i<S.draw.length-1;i++){
      const a = S.draw[i], b = S.draw[i+1];
      if(a.length < 2 || b.length < 2) continue;
      const A = a[a.length-1], B = b[0];
      const d = Math.hypot(B[0]-A[0], B[1]-A[1]);
      if(d > S.run.size * (0.30 + 1.60*kR)) continue;
      const rw = rnd(7717 + i*613);
      const ring = renmenRing(A, B, w * (0.10 + 0.26*kR), (P.bow/100)*0.42*(rw()*2-1));
      if(ring) out.push(ring);
    }
  }
  return out;
}

function paint(g, W, H, opt){
  const svg = (opt && opt.svg) ? [] : null;
  const [BW,BH] = boardSize(), k = W/BW;
  g.save(); g.scale(k,k);
  if(!svg){ g.clearRect(0,0,BW,BH); g.fillStyle = S.col.bg; g.fillRect(0,0,BW,BH); }
  const M0 = (!svg && g.getTransform) ? g.getTransform() : null;
  if(S.view === 'sheet'){
    const chars = [...'あいうえおカキクケコさしすせそ愛光風時夜明街道'];
    const cols = 9, cell = 140;
    chars.forEach((ch,i) => {
      const cxp = 60 + (i%cols)*cell, cyp = 70 + Math.floor(i/cols)*cell;
      drawGlyph(g, ch, cxp, cyp, 110, 0, S.col.col, i, svg, M0);
    });
  } else {
    const PL = place();
    /* ⭐ 先に渡りを描く（字がその上に乗る）。筆のときだけ。 */
    if((S.mode !== 'draw' || S.typed === 'solid') && S.pen.tool === 'fude' && S.pen.renmen > 0){
      const toBoard = (p, q) => {
        const k = q.size/1000, c = q.size/2, rd = (q.rot||0)*Math.PI/180;
        let X = p[0]*k*(S.run.wide/100), Y = p[1]*k*(S.run.tall/100);
        if(q.rot){ const ax=X-c, ay=Y-c;
          X = c + ax*Math.cos(rd) - ay*Math.sin(rd); Y = c + ax*Math.sin(rd) + ay*Math.cos(rd); }
        return [q.x+X, q.y+Y];
      };
      const kR = S.pen.renmen/100, rings = [];
      for(let i=0;i<PL.length-1;i++){
        const p0 = PL[i], p1 = PL[i+1];
        glyph(p0.ch, p0.i); glyph(p1.ch, p1.i);          /* 控えを作らせる */
        const e0 = glyphEnds.get(glyphKey(p0.ch, p0.i));
        const e1 = glyphEnds.get(glyphKey(p1.ch, p1.i));
        if(!e0 || !e1) continue;
        const A = toBoard(e0.b, p0), B = toBoard(e1.a, p1);
        const d = Math.hypot(B[0]-A[0], B[1]-A[1]);
        /* ⚠️ 遠すぎる所を繋ぐと字が読めなくなる。つなぐ距離はつまみで決まる */
        if(d > p0.size * (0.30 + 1.60*kR)) continue;
        /* ⚠️ 上限は当てずっぽうで決めない。実測＝隣り合う字の間は 0.64〜1.40×字の大きさ
           （フ→ァ 247／ー→ス 144／ス→ト 315、字の大きさ 225）。
           一度 0.20+0.70kR にしたら上限 136 になり【1本も繋がらなかった】。 */
        const rw = rnd(S.run.seed*7717 + i*613);
        const bow = (S.pen.bow/100) * 0.42 * (rw()*2-1);
        const ring = renmenRing(A, B, (S.pen.fw) * (p0.size/1000) * (0.10 + 0.26*kR), bow);
        if(ring) rings.push(ring);
      }
      if(rings.length){
        g.beginPath();
        rings.forEach(r => { g.moveTo(r[0][0], r[0][1]);
          for(let j=1;j<r.length;j++) g.lineTo(r[j][0], r[j][1]); g.closePath(); });
        g.fillStyle = S.col.col; g.fill();
        if(svg) svg.push('<path d="' + rings.map(r =>
          'M' + r.map(p => p[0].toFixed(1)+' '+p[1].toFixed(1)).join('L') + 'Z').join('') +
          '" fill="' + (S.col.grad ? 'url(#sg)' : S.col.col) + '"/>');
      }
    }
    /* ⭐ 打った字は【消さない】。出し方だけ選ぶ。
       solid＝そのまま作品の一部／guide＝薄く下に敷く（なぞる下敷き）／hide＝隠す
       ⚠️ 薄い下敷きは書き出しに入れない（下敷きだから） */
    const tp = (S.mode === 'draw') ? S.typed : 'solid';
    if(tp === 'solid'){
      PL.forEach(p => drawGlyph(g, p.ch, p.x, p.y, p.size, p.rot, S.col.col, p.i, svg, M0));
    } else if(tp === 'guide' && !svg){
      g.save(); g.globalAlpha = 0.16;
      PL.forEach(p => drawGlyph(g, p.ch, p.x, p.y, p.size, p.rot, S.col.col, p.i, null, M0));
      g.restore();
    }
    /* 手で置いた骨は、いつでも濃く出る（足される） */
    if(S.draw.length){
      const dr = drawnRings();
      if(dr.length){
        g.beginPath();
        dr.forEach(r => { g.moveTo(r[0][0], r[0][1]);
          for(let j=1;j<r.length;j++) g.lineTo(r[j][0], r[j][1]); g.closePath(); });
        g.fillStyle = S.col.col; g.fill();
        if(svg) svg.push('<path d="' + dr.map(r =>
          'M' + r.map(p => p[0].toFixed(1)+' '+p[1].toFixed(1)).join('L') + 'Z').join('') +
          '" fill="' + (S.col.grad ? 'url(#sg)' : S.col.col) + '"/>');
      }
    }
  }
  g.restore();
  return svg;
}

/* ══ 盤 ══ */
let Z=1, PX=0, PY=0, rafId=0;
function layout(){
  const [W,H] = boardSize(), dpr = Math.min(2, devicePixelRatio||1);
  cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr);
  cv.style.width = W+'px'; cv.style.height = H+'px';
  cx.setTransform(dpr,0,0,dpr,0,0); place2();
}
function place2(){ cv.style.transform = `translate(${PX}px,${PY}px) scale(${Z})`;
  $('zVal').textContent = Math.round(Z*100)+'%'; }
function fit(){
  const st = $('stage').getBoundingClientRect(), [W,H] = boardSize();
  Z = Math.min((st.width-80)/W, (st.height-140)/H);
  PX = (st.width - W*Z)/2; PY = (st.height - H*Z)/2 + 10; place2();
}
function draw(){ if(rafId) return; rafId = requestAnimationFrame(() => { rafId = 0; render(); }); }
/* ══⭐ 掴み手は【paint の外】で描く ══
   書き出しは別の canvas に paint() を呼ぶので、ここで描いた物は PNG/SVG に焼き付かない。
   （[[見せるだけの画は別の層に]]） */
function drawHandles(g){
  if(S.mode !== 'draw' || S.hand !== 'edit') return;
  const [BW] = boardSize(), r = Math.max(BW*0.006, 9/Math.max(0.05, Z));   /* ⭐ 引いて見ても指で見える */
  S.draw.forEach((st, i) => {
    if(st.length < 2) return;
    const on = (i === S.sel);
    g.beginPath(); g.moveTo(st[0][0], st[0][1]);
    for(let j=1;j<st.length;j++) g.lineTo(st[j][0], st[j][1]);
    g.strokeStyle = on ? 'rgba(255,106,52,.95)' : 'rgba(255,106,52,.35)';
    g.lineWidth = Math.max(1, BW*0.0015); g.stroke();
    if(!on) return;
    st.forEach((p, j) => {
      g.beginPath(); g.arc(p[0], p[1], r, 0, 6.2832);
      g.fillStyle = (j===0) ? '#ff6a34' : '#fff';
      g.fill(); g.strokeStyle = '#ff6a34'; g.lineWidth = Math.max(1, BW*0.0016); g.stroke();
    });
  });
}

function render(){
  const [W,H] = boardSize();
  paint(cx, W, H, {});
  drawHandles(cx);
  const n = runChars().length;
  if(S.mode === 'draw'){ return; }      /* ⭐ なぞっている間の表示は syncNote が持つ */
  $('note').textContent = S.view === 'sheet'
    ? '字見本 ── 書体から骨を起こして書いた（かな・カタカナ・漢字）'
    : (() => {
        const cs = runChars();
        const hand = cs.filter(c => KANA[c] || SMALL[c] || (c.normalize('NFD').length===2 && MARK[c.normalize('NFD')[1]])).length;
        const auto = cs.length - hand;
        return `${cs.length}字（${S.vert?'縦組':'横組'}）── かな ${hand}字は【手で持った骨】`
             + (auto ? `／漢字など ${auto}字は【${$('segFam').querySelector('.on')?.textContent||'角ゴ'}から起こした骨】` : '');
      })();
}

