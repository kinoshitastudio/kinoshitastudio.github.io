  </div>
  <p class="hint">帯を1本ずつ縁取ると<b>中の継ぎ目まで線が出る</b>。だから「ふちの色で太らせて塗る → その上に字の色」の2枚組にしている。</p>

  <div class="sec">⑦ 版面</div>
  <div class="seg" id="segPage">
    <button data-v="1000,1500">たて</button>
    <button data-v="1500,1000" class="on">よこ</button>
    <button data-v="1200,1200">正方</button>
  </div>
  <div class="row"><span class="n">紙の色</span></div><input type="color" id="bg" value="#ffffff">

  <div class="sec">⑧ 出す</div>
  <div class="row"><span class="n">長辺（px）</span><output id="o_long">2400</output></div>
  <input type="range" id="long" min="600" max="6000" step="100" value="2400">
  <button class="btn go" id="ePNG">PNG で出す</button>
  <button class="btn" id="eSVG">SVG で出す</button>
  <p class="hint">SVG は<b>画面と同じ形</b>（ふちもグラデも入る）。⚠️ 震えは入るが、紙の地は入らない。</p>
</div>
<script>
const $ = id => document.getElementById(id);
const cv = $('cv'), cx = cv.getContext('2d');

/* ══════════════════════════════════════════════════════════════
   閃 SEN ── 日本語を、速さで書く
   芯＝【ペン】。筆（奔HON）とは別物。
     ・角は丸めず【折る】（留め継ぎ／マイター）
     ・払いは【まっすぐ長く】伸びる（速く払った跡）
     ・版面ぜんぶを1本のグラデが走る
   ⭐ 骨（書き順の芯）の起こし方だけは 奔HON と同じ細線化（Zhang-Suen）を使う。
     ＝ 骨の起こし方は道具の芯ではなく【土台】なので、共有してよい。
   ⚠️ HON は欧文ベース（手で書いた骨を持つ）。SEN は【日本語ベース】＝骨は必ず書体から起こす。
   ══════════════════════════════════════════════════════════════ */

const S = {
  text: 'ファーストクラス',
  fam: 'kaku',
  pen : { tool:'fude', w:96, taper:62, miter:22, round:74, link:62, sweep:80, straight:88, vary:26, jit:7, warp:52,
          fw:88, fvary:74, ftaper:86, renmen:58, bow:26 },
  run : { size:150, adv:80, ang:-10, slant:-8, wide:62, tall:130, jr:10, x:6, y:46, seed:7,
          w:1500, h:1000 },
  col : { col:'#ff3fb0', col2:'#6a2bd9', grad:1, gang:14,
          edge:0, edgeW:6, edgeCol:'#2a1c33', bg:'#ffffff' },
  out : { long:2400 },
  view: 'run',
  mode : 'type',      /* type＝打つ／draw＝手で置く */
  hand : 'pen',       /* draw の中で pen＝引く／edit＝直す（HA と同じ2本立て） */
  typed: 'guide',     /* 打った字の出し方 solid＝濃く／guide＝薄く敷く／hide＝隠す */
  draw : [],          /* 手で置いた骨。盤の座標のまま持つ */
  sel  : -1,          /* 直す時に選んでいる画 */
};

/* ══ 乱数（種から決まる＝同じ種なら1画素も同じ） ══ */
function rnd(seed){
  let s = (seed|0) || 1;
  s = Math.imul(s ^ 0x9e3779b9, 0x85ebca6b);
  s = (s ^ (s >>> 13)) | 0;
