          }
        ]
      },
      {
        "type": "text",
        "name": "Wordmark",
        "stretch": true,
        "text": "Process Arts",
        "fill": "@colors.navy",
        "align": "center",
        "font": { "family": "Inter", "size": 56, "weight": 700, "letterSpacing": -1.8 }
