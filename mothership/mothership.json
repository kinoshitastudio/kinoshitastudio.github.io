            ]
          },
          {
            "type": "frame",
            "name": "Legend Line",
            "fill": "#00000000",
            "layout": { "mode": "horizontal", "gap": 14, "padding": 0, "align": "center", "justify": "start" },
            "children": [
              { "type": "ellipse", "name": "dot", "w": 14, "h": 14, "fill": "@colors.blue" },
              { "type": "text", "name": "t", "text": "線 ＝ プロセス（つなぐ営み）", "fill": "@colors.navy", "align": "left", "font": { "family": "Noto Sans JP", "size": 19, "weight": 600, "lineHeight": 30 } }
            ]
          },
          {
            "type": "frame",
            "name": "Legend Center",
            "fill": "#00000000",
            "layout": { "mode": "horizontal", "gap": 14, "padding": 0, "align": "center", "justify": "start" },
            "children": [
              { "type": "ellipse", "name": "dot", "w": 14, "h": 14, "fill": "@colors.navy" },
              { "type": "text", "name": "t", "text": "中央 ＝ 価値創造", "fill": "@colors.navy", "align": "left", "font": { "family": "Noto Sans JP", "size": 19, "weight": 600, "lineHeight": 30 } }
            ]
          },
          {
            "type": "rect", "name": "rule", "w": 64, "h": 2, "fill": "@colors.faint"
          },
          {
            "type": "text",
            "name": "Closing",
            "text": "つまり、価値は一人からは生まれない。\n点と点が線で結ばれ、その交わる中央で価値が立ち上がる。\nProcess Arts は、その「関係性のプロセス」そのものを名前にした。",
            "fill": "@colors.steel",
            "align": "left",
            "font": { "family": "Noto Sans JP", "size": 16, "weight": 400, "lineHeight": 30 }
          }
        ]
