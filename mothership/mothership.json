{
  "name": "Process Arts — Logo Concept 06",
  "font": "Inter",
  "tokens": {
    "colors": {
      "navy": "#16243d",
      "blue": "#2f6db0",
      "sky": "#5aa8e0",
      "steel": "#7d8aa0",
      "paper": "#ffffff",
      "mist": "#eef2f7",
      "faint": "#c7d0dc"
    }
  },
  "root": {
