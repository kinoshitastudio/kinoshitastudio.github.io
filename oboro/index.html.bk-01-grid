<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>朦 OBORO — 写真を帯に変える / 木下スタジオ</title>
<meta name="description" content="朦 OBORO は、写真から色を採って帯のグラデーションに変える道具。写真が残る部分と帯になった部分が同居し、輪郭が溶けて曖昧な形になる。木下スタジオ（滋賀・木下貴博）制作。">
<link rel="canonical" href="https://kinoshita.studio/oboro/">
<meta property="og:title" content="朦 OBORO — 写真を帯に変える">
<meta property="og:description" content="写真から色を採って帯のグラデーションに変える。輪郭が溶けて、写真が曖昧な形になる。">
<meta property="og:url" content="https://kinoshita.studio/oboro/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="木下スタジオ">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0a0a0a; --paper:#f4f2ee;
    --line:rgba(60,60,67,.16);
    --fill:rgba(120,120,128,.13);
    --fill2:rgba(120,120,128,.30);
    --capsule:#ffffff;
    --glass:rgba(242,242,247,.82);
    --dim:rgba(60,60,67,.62);
    --shadow:0 10px 30px rgba(0,0,0,.13), 0 1px 2px rgba(0,0,0,.07);
    --r:10px;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;overflow:hidden;background:#8a8a8a;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Hiragino Sans","Zen Kaku Gothic New",sans-serif;
    color:var(--ink); -webkit-font-smoothing:antialiased;
  }
  /* ── 板（写真を置く所）── */
  #stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:40px;}
  #cv{max-width:100%;max-height:100%;box-shadow:0 20px 60px rgba(0,0,0,.35);cursor:crosshair;
      touch-action:none;background:#fff;}
  #drop{position:fixed;inset:0;z-index:40;display:none;align-items:center;justify-content:center;
        background:rgba(10,10,10,.55);color:#fff;font-size:15px;letter-spacing:.08em;}
  #drop.on{display:flex;}

  /* ── 右パネル ── */
  #panel{
    position:fixed;top:16px;right:16px;z-index:20;width:264px;
    background:var(--glass);border:.5px solid var(--line);border-radius:16px;
    box-shadow:var(--shadow);padding:14px 14px 20px;
    max-height:calc(100vh - 32px);overflow-y:auto;
    -webkit-backdrop-filter:blur(30px) saturate(180%);backdrop-filter:blur(30px) saturate(180%);
  }
  h2{
    position:sticky;top:-14px;z-index:3;
    margin:20px -14px 8px;padding:7px 14px 6px;
    background:var(--glass);border-bottom:.5px solid var(--line);
    -webkit-backdrop-filter:blur(30px) saturate(180%);backdrop-filter:blur(30px) saturate(180%);
    font-size:11px;font-weight:590;letter-spacing:.06em;color:var(--dim);
  }
  h2:first-child{margin-top:-14px;}
  .row{display:flex;align-items:center;gap:10px;padding:3px 0;font-size:12.5px;}
  .row label{width:66px;flex:none;color:var(--ink);}
  .val{font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:11px;color:var(--dim);
       width:34px;text-align:right;flex:none;font-variant-numeric:tabular-nums;}
  input[type=range]{-webkit-appearance:none;appearance:none;flex:1;background:none;height:26px;outline:none;}
  input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:var(--fill);}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;margin-top:-8px;
    border-radius:50%;background:var(--ink);border:none;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.28);}
  .seg{display:flex;background:var(--fill2);border-radius:9px;padding:2px;gap:2px;margin:6px 0 10px;}
  .seg button{flex:1;border:none;border-radius:7px;background:none;cursor:pointer;
    font-family:inherit;font-size:11.5px;font-weight:450;color:var(--ink);opacity:.55;padding:6px 0;transition:.16s;}
  .seg button.on{opacity:1;background:var(--capsule);font-weight:640;
    box-shadow:0 1px 4px rgba(0,0,0,.24),0 0 0 .5px rgba(0,0,0,.10);}
  .btn{width:100%;background:var(--fill);border:none;border-radius:var(--r);color:var(--ink);
    font-family:inherit;font-size:12px;font-weight:500;padding:11px 0;margin:3px 0;cursor:pointer;transition:.14s;}
  .btn:hover{background:rgba(120,120,128,.24);}
  .btn:active{transform:scale(.985);opacity:.8;}
  .btn.pri{background:var(--ink);color:var(--paper);font-weight:590;}
  .mod{font-size:10.5px;line-height:1.7;color:var(--dim);margin-top:8px;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
  #hud{position:fixed;left:18px;top:16px;z-index:20;font-family:ui-monospace,"SF Mono",Menlo,monospace;
       font-size:8.5px;letter-spacing:.14em;color:#fff;opacity:.55;line-height:2;}
  #hud a{color:inherit;text-decoration:none;border-bottom:.5px solid rgba(255,255,255,.3);}

  @media(max-width:820px){
    #stage{inset:0 0 46vh 0;padding:16px;}
    #panel{top:auto;bottom:0;left:0;right:0;width:auto;max-height:46vh;
           border-radius:16px 16px 0 0;border:none;border-top:.5px solid var(--line);
           background:rgba(242,242,247,.94);}
    #hud{top:10px;left:12px;}
    /* ⚠️ 指では入力欄そのものに高さが要る（1px だと点にしか当たらない） */
    input[type=range]{height:40px;}
    input[type=range]::-webkit-slider-thumb{width:24px;height:24px;margin-top:-10px;}
    .seg button{padding:11px 0;min-height:38px;}
    .btn{padding:13px 0;min-height:40px;}
  }
</style>
</head>
<body>

<div id="hud">朦 OBORO — 写真を帯に変える<br><a href="/">← KINOSHITA STUDIO</a></div>
<div id="stage"><canvas id="cv"></canvas></div>
<div id="drop">写真をここに落とす</div>

<div id="panel">
  <h2>写真</h2>
  <button class="btn pri" id="bLoad">写真を読み込む</button>
  <input type="file" id="file" accept="image/*" style="display:none">
  <div class="mod">ドラッグ＆ドロップでも置ける</div>

  <h2>割る</h2>
  <div class="row"><label>よこ</label><input type="range" id="gx" min="1" max="80" value="18"><span class="val"></span></div>
  <div class="row"><label>たて</label><input type="range" id="gy" min="1" max="80" value="10"><span class="val"></span></div>
  <div class="mod">⭐ たてとよこで割り方を変えると、写真が<b>帯に潰れる</b><br>
    よこ 44 × たて 2 のように極端にすると、色だけが残る</div>

  <h2>色</h2>
  <div class="row"><label>色数</label><input type="range" id="steps" min="2" max="64" value="16"><span class="val"></span></div>
  <div class="row"><label>寄せる</label><input type="range" id="bias" min="0" max="100" value="0"><span class="val"></span></div>
  <div class="mod">色数を絞るほど、写真から<b>抜き出した色</b>だけが残る</div>

  <h2>帯</h2>
  <div class="seg" id="dir">
    <button data-v="x" class="on">よこに流す</button>
    <button data-v="y">たてに流す</button>
  </div>
  <div class="row"><label>にじみ</label><input type="range" id="soft" min="0" max="100" value="55"><span class="val"></span></div>
  <div class="row"><label>のび</label><input type="range" id="reach" min="100" max="400" value="160"><span class="val"></span></div>
  <div class="mod">⭐ <b>のび</b>＝帯がマスを越えて伸びる。参考にした手作業の帯は横に長い</div>

  <h2>どこまで</h2>
  <div class="row"><label>進み</label><input type="range" id="fill" min="0" max="100" value="100"><span class="val"></span></div>
  <div class="seg" id="order">
    <button data-v="rand" class="on">ばらばら</button>
    <button data-v="dark">暗い順</button>
    <button data-v="light">明るい順</button>
  </div>
  <div class="mod">⭐ <b>進み</b>を途中で止めると、<b>写真と帯が同居する</b><br>
    手でやっていたのはこれ。順番を変えると別のものが出る</div>

  <h2>書き出し</h2>
  <div class="grid2">
    <button class="btn" id="bPNG">PNG</button>
    <button class="btn" id="bSVG">SVG</button>
  </div>
  <div class="mod">⭐ SVG は帯が<b>矩形＋グラデ</b>で出る＝Illustrator / Figma で1枚ずつ触れる</div>
</div>

<script>
/* ══════════════════════════════════════════════════════════════
   朦 OBORO — 写真から色を採って、帯のグラデーションに変える
   ⭐ 2024 の gradation-ui（写真の中央1本の色を読んで横に流す）の続き。
      あれは1次元だった。ここでは【たて・よこで別々に割る】ので、
      同じ写真から帯にも、色の粒にもなる。
   ⭐⭐ 芯＝【写真が残る部分と、帯になった部分が同居する】こと。
      木下が手作業でやっていて「大変でやめた」のがそこ。
   ══════════════════════════════════════════════════════════════ */
const cv  = document.getElementById('cv');
const ctx = cv.getContext('2d', { willReadFrequently:true });
let img = null;          // 元の写真
let src = null;          // 元の画素（読み取り用）
let cells = [];          // 割ったマス（色つき）

const P = { gx:18, gy:10, steps:16, bias:0, dir:'x', soft:55, reach:160, fill:100, order:'rand' };

/* ── 写真を読む ────────────────────────────────────────── */
function loadImage(srcUrl){
  const im = new Image();
  im.crossOrigin = 'anonymous';
  im.onload = () => {
    img = im;
    // ⚠️ 大きすぎる写真は読み取りが重い。長辺 1600 に収めてから使う
    const M = 1600, k = Math.min(1, M / Math.max(im.width, im.height));
    cv.width  = Math.round(im.width  * k);
    cv.height = Math.round(im.height * k);
    ctx.drawImage(im, 0, 0, cv.width, cv.height);
    src = ctx.getImageData(0, 0, cv.width, cv.height);
    build(); draw();
  };
  im.src = srcUrl;
}

/* ── 割る ── マスごとの平均色を採る ─────────────────────
   ⭐ 2024 版は「中央の縦1本」だけを読んでいた。ここは面で読む。 */
function build(){
  if(!src) return;
  const { width:W, height:H, data:d } = src;
  const nx = P.gx, ny = P.gy;
  cells = [];
  for(let j=0;j<ny;j++){
    for(let i=0;i<nx;i++){
      const x0 = Math.floor(i*W/nx), x1 = Math.floor((i+1)*W/nx);
      const y0 = Math.floor(j*H/ny), y1 = Math.floor((j+1)*H/ny);
      let r=0,g=0,b=0,n=0;
      // ⚠️ 全画素を足すと重い。マスの中を間引いて読む（見た目は変わらない）
      const sx = Math.max(1, Math.floor((x1-x0)/12)), sy = Math.max(1, Math.floor((y1-y0)/12));
      for(let y=y0;y<y1;y+=sy) for(let x=x0;x<x1;x+=sx){
        const p = (y*W+x)*4; r+=d[p]; g+=d[p+1]; b+=d[p+2]; n++;
      }
      if(!n) n = 1;
      const c = [r/n, g/n, b/n];
      cells.push({ i, j, x0, y0, x1, y1, c, lum: (c[0]*.299 + c[1]*.587 + c[2]*.114) });
    }
  }
  // ⭐ 塗る順番。⚠️ 毎回変わると「進み」を動かすたびに別物になるので、種を固定して混ぜる
  cells.forEach((c,k) => { c.seed = ((k*2654435761) % 4294967296) / 4294967296; });
}

/* ── 色を絞る ── 写真から抜き出した色だけを残す ───────── */
function quant(c){
  const s = Math.max(2, P.steps);
  const b = P.bias / 100;
  return c.map(v => {
    let t = v / 255;
    // ⚠️ 寄せる＝明暗の端に寄せる。上げると色が飛んで版画のようになる
    t = t + (t - 0.5) * b;
    t = Math.max(0, Math.min(1, t));
    return Math.round(Math.round(t * (s-1)) / (s-1) * 255);
  });
}
const css = c => `rgb(${c[0]|0},${c[1]|0},${c[2]|0})`;

/* ── 描く ── 写真の上に帯を重ねる ───────────────────────
   ⭐ ここが芯。全部塗らない＝写真と帯が同居する。 */
function draw(){
  if(!img) return;
  ctx.clearRect(0,0,cv.width,cv.height);
  ctx.drawImage(img, 0, 0, cv.width, cv.height);     // まず写真

  const list = order(cells);
  const upto = Math.round(list.length * P.fill / 100);
  for(let k=0;k<upto;k++) band(list[k]);
}

function order(cs){
  const a = cs.slice();
  if(P.order === 'dark')  a.sort((p,q) => p.lum - q.lum);
  else if(P.order === 'light') a.sort((p,q) => q.lum - p.lum);
  else a.sort((p,q) => p.seed - q.seed);
  return a;
}

/* 帯ひとつ ── そのマスの色から、隣の色へ渡るグラデを引く */
function band(c){
  if(!c) return;
  const horiz = P.dir === 'x';
  const reach = P.reach / 100;
  const w = (c.x1 - c.x0), h = (c.y1 - c.y0);
  // ⭐ のび＝マスを越えて伸びる。手作業の帯が横に長かったのを効かせる
  const bw = horiz ? w * reach : w;
  const bh = horiz ? h : h * reach;
  const x = horiz ? c.x0 - (bw - w)/2 : c.x0;
  const y = horiz ? c.y0 : c.y0 - (bh - h)/2;

  const a = quant(c.c);
  const nb = neighbor(c);                    // 隣のマス＝渡る先の色
  const b = quant(nb ? nb.c : c.c);

  const g = horiz ? ctx.createLinearGradient(x, 0, x+bw, 0)
                  : ctx.createLinearGradient(0, y, 0, y+bh);
  const s = P.soft / 100;                    // にじみ＝端をどれだけ溶かすか
  g.addColorStop(0, css(a));
  g.addColorStop(Math.max(0.001, 0.5 - s*0.5), css(a));
  g.addColorStop(Math.min(0.999, 0.5 + s*0.5), css(b));
  g.addColorStop(1, css(b));
  ctx.fillStyle = g;
  ctx.fillRect(x, y, bw, bh);
}
function neighbor(c){
  const i = P.dir === 'x' ? c.i + 1 : c.i;
  const j = P.dir === 'x' ? c.j : c.j + 1;
  return cells.find(o => o.i === i && o.j === j) || null;
}

/* ── つまみ ───────────────────────────────────────────── */
function bind(id, key, after){
  const r = document.getElementById(id);
  const v = r.parentElement.querySelector('.val');
  const sync = () => { P[key] = +r.value; if(v) v.textContent = r.value; if(after) after(); draw(); };
  r.addEventListener('input', sync); sync();
}
bind('gx','gx',build); bind('gy','gy',build);
bind('steps','steps'); bind('bias','bias');
bind('soft','soft');   bind('reach','reach'); bind('fill','fill');
document.querySelectorAll('.seg').forEach(seg => {
  seg.querySelectorAll('button').forEach(b => {
    b.addEventListener('click', () => {
      seg.querySelectorAll('button').forEach(x => x.classList.remove('on'));
      b.classList.add('on');
      P[seg.id === 'dir' ? 'dir' : 'order'] = b.dataset.v;
      draw();
    });
  });
});

/* ── 読み込み（ボタン・ドロップ）─────────────────────── */
document.getElementById('bLoad').onclick = () => document.getElementById('file').click();
document.getElementById('file').addEventListener('change', e => {
  const f = e.target.files[0]; if(!f) return;
  loadImage(URL.createObjectURL(f));
  e.target.value = '';
});
const dropEl = document.getElementById('drop');
addEventListener('dragover', e => { e.preventDefault(); dropEl.classList.add('on'); });
addEventListener('dragleave', e => { if(e.relatedTarget === null) dropEl.classList.remove('on'); });
addEventListener('drop', e => {
  e.preventDefault(); dropEl.classList.remove('on');
  const f = [...e.dataTransfer.files].find(x => x.type.startsWith('image/'));
  if(f) loadImage(URL.createObjectURL(f));
});

/* ── 書き出し ─────────────────────────────────────────── */
const dl = (blob, name) => {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
};
document.getElementById('bPNG').onclick = () => {
  cv.toBlob(b => dl(b, `oboro_${Date.now()}.png`), 'image/png');
};
/* ⭐ SVG ── 帯は【矩形＋linearGradient】なので、そのままベクターで出せる。
   ⚠️ 元の写真は入れない（帯だけ）。写真ごと出したいときは PNG。 */
document.getElementById('bSVG').onclick = () => {
  const list = order(cells);
  const upto = Math.round(list.length * P.fill / 100);
  const horiz = P.dir === 'x', reach = P.reach/100, s = P.soft/100;
  let defs = '', body = '';
  for(let k=0;k<upto;k++){
    const c = list[k]; if(!c) continue;
    const w = c.x1-c.x0, h = c.y1-c.y0;
    const bw = horiz ? w*reach : w, bh = horiz ? h : h*reach;
    const x = horiz ? c.x0-(bw-w)/2 : c.x0, y = horiz ? c.y0 : c.y0-(bh-h)/2;
    const a = quant(c.c), nb = neighbor(c), b = quant(nb ? nb.c : c.c);
    const id = 'g'+k;
    defs += `<linearGradient id="${id}" x1="${horiz?0:0}" y1="${horiz?0:0}" x2="${horiz?1:0}" y2="${horiz?0:1}">`
          + `<stop offset="0" stop-color="${css(a)}"/>`
          + `<stop offset="${Math.max(0.001,0.5-s*0.5).toFixed(3)}" stop-color="${css(a)}"/>`
          + `<stop offset="${Math.min(0.999,0.5+s*0.5).toFixed(3)}" stop-color="${css(b)}"/>`
          + `<stop offset="1" stop-color="${css(b)}"/></linearGradient>`;
    body += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" fill="url(#${id})"/>`;
  }
  const svg = `<?xml version="1.0" encoding="UTF-8"?>\n`
    + `<svg xmlns="http://www.w3.org/2000/svg" width="${cv.width}" height="${cv.height}" `
    + `viewBox="0 0 ${cv.width} ${cv.height}"><defs>${defs}</defs>${body}</svg>`;
  dl(new Blob([svg], {type:'image/svg+xml'}), `oboro_${Date.now()}.svg`);
};

/* ── 最初の1枚（同梱の写真）────────────────────────────── */
loadImage('5.jpg');
</script>
</body>
</html>
