<body>

<div id="hud">朦 OBORO — 写真を帯に変える<br><a href="/">← KINOSHITA STUDIO</a></div>
<div id="stage"><canvas id="cv"></canvas></div>
<div id="drop">写真をここに落とす</div>

<div id="panel">
  <h2>写真</h2>
  <button class="btn pri" id="bLoad">写真を読み込む</button>
  <input type="file" id="file" accept="image/*" style="display:none">
  <div class="mod">ドラッグ＆ドロップでも置ける</div>

  <h2>割る</h2>
  <div class="row"><label>段</label><input type="range" id="rows" min="1" max="60" value="14"><span class="val"></span></div>
  <div class="row"><label>粗い</label><input type="range" id="minx" min="1" max="60" value="2"><span class="val"></span></div>
  <div class="row"><label>細かい</label><input type="range" id="maxx" min="2" max="80" value="44"><span class="val"></span></div>
  <div class="row"><label>ばらつき</label><input type="range" id="vary" min="0" max="100" value="60"><span class="val"></span></div>
  <div class="row"><label>ひき直す</label><input type="range" id="seed" min="1" max="99" value="7"><span class="val"></span></div>
  <div class="mod">⭐⭐ <b>行ごとに割る数が変わる</b>（粗い〜細かいの間）＝参考の「グリッド 2-44」。<br>
    ⚠️ 全部同じ数で割ると<b>格子がそのまま見えて</b>ただのモザイクになる。ここが芯<br>
    ばらつき＝帯の幅と高さを揃えない／ひき直す＝別の引き方を出す</div>

  <h2>色</h2>
  <div class="row"><label>色数</label><input type="range" id="steps" min="2" max="64" value="16"><span class="val"></span></div>
  <div class="row"><label>寄せる</label><input type="range" id="bias" min="0" max="100" value="0"><span class="val"></span></div>
  <div class="mod">色数を絞るほど、写真から<b>抜き出した色</b>だけが残る</div>

  <h2>帯</h2>
  <div class="seg" id="dir">
    <button data-v="x" class="on">よこに流す</button>
    <button data-v="y">たてに流す</button>
  </div>
  <div class="row"><label>にじみ</label><input type="range" id="soft" min="0" max="100" value="55"><span class="val"></span></div>
  <div class="row"><label>のび</label><input type="range" id="reach" min="100" max="400" value="160"><span class="val"></span></div>
  <div class="mod">⭐ <b>のび</b>＝帯がマスを越えて伸びる。参考にした手作業の帯は横に長い</div>

  <h2>引く</h2>
  <div class="row"><label>抜き</label><input type="range" id="drop" min="0" max="90" value="0"><span class="val"></span></div>
  <div class="mod">⭐ 帯を<b>消して</b>、下の写真を覗かせる。⚠️ 上にノイズを足すのではなく<b>引く</b><br>
    ⭐ 音が鳴っていると、どの帯が消えるかが揺れる</div>

  <h2>光</h2>
  <div class="row"><label>明るさ</label><input type="range" id="expo" min="-60" max="90" value="0"><span class="val"></span></div>
  <div class="row"><label>濃さ</label><input type="range" id="sat" min="0" max="200" value="100"><span class="val"></span></div>
  <div class="mod">⭐ <b>明るい写真ほど帯が生きる</b>。暗い写真は先にここで持ち上げる</div>

  <h2>音</h2>
  <div class="grid2">
    <button class="btn" id="bMic">マイク</button>
    <button class="btn" id="bSnd">音を読む</button>
  </div>
  <input type="file" id="sfile" accept="audio/*" style="display:none">
  <div class="row"><label>効き</label><input type="range" id="amount" min="0" max="100" value="60"><span class="val"></span></div>
  <div class="mod" id="sndnote">⭐ 低音＝どこまで進むか／中音＝帯ののび／高音＝色数<br>
    ⚠️ 設定そのものは書き換えない＝<b>音を止めれば元に戻る</b></div>

  <h2>どこまで</h2>
  <div class="row"><label>進み</label><input type="range" id="fill" min="0" max="100" value="100"><span class="val"></span></div>
  <div class="seg" id="order">
    <button data-v="rand" class="on">ばらばら</button>
    <button data-v="dark">暗い順</button>
    <button data-v="light">明るい順</button>
  </div>
  <div class="mod">⭐ <b>進み</b>を途中で止めると、<b>写真と帯が同居する</b><br>
    手でやっていたのはこれ。順番を変えると別のものが出る</div>

  <h2>書き出し</h2>
  <div class="grid2">
    <button class="btn" id="bPNG">PNG</button>
    <button class="btn" id="bSVG">SVG</button>
  </div>
  <div class="mod">⭐ SVG は帯が<b>矩形＋グラデ</b>で出る＝Illustrator / Figma で1枚ずつ触れる</div>
</div>

<script>
/* ══════════════════════════════════════════════════════════════
   朦 OBORO — 写真から色を採って、帯のグラデーションに変える
   ⭐ 2024 の gradation-ui（写真の中央1本の色を読んで横に流す）の続き。
      あれは1次元だった。ここでは【たて・よこで別々に割る】ので、
      同じ写真から帯にも、色の粒にもなる。
   ⭐⭐ 芯＝【写真が残る部分と、帯になった部分が同居する】こと。
      木下が手作業でやっていて「大変でやめた」のがそこ。
   ══════════════════════════════════════════════════════════════ */
const cv  = document.getElementById('cv');
const ctx = cv.getContext('2d', { willReadFrequently:true });
let img = null;          // 元の写真
let src = null;          // 元の画素（読み取り用）
let cells = [];          // 割ったマス（色つき）

const P = { rows:14, minx:2, maxx:44, vary:60, seed:7, steps:16, bias:0, dir:'x', soft:55, reach:160,
            fill:100, order:'rand',
            /* ⭐ 引き算＝帯を消して写真を覗かせる。⭐ 音＝どの帯が消えるかが揺れる */
            drop:0, expo:0, sat:100, amount:60 };
const M = { low:0, mid:0, high:0, kick:0 };   // 音の量（0〜1）

/* ── 写真を読む ────────────────────────────────────────── */
function loadImage(srcUrl){
  const im = new Image();
  im.crossOrigin = 'anonymous';
  im.onload = () => {
    img = im;
    // ⚠️ 大きすぎる写真は読み取りが重い。長辺 1600 に収めてから使う
    const M = 1600, k = Math.min(1, M / Math.max(im.width, im.height));
    cv.width  = Math.round(im.width  * k);
    cv.height = Math.round(im.height * k);
    ctx.drawImage(im, 0, 0, cv.width, cv.height);
    src = ctx.getImageData(0, 0, cv.width, cv.height);
    makeBase();
    build(); draw();
  };
  im.src = srcUrl;
}

/* ── 割る ── マスごとの平均色を採る ─────────────────────
   ⭐ 2024 版は「中央の縦1本」だけを読んでいた。ここは面で読む。 */
function build(){
  if(!src) return;
  const { width:W, height:H, data:d } = src;
  cells = [];
  // ⭐⭐ 行ごとに【分割数を変える】。参考の「グリッド 2-44」＝粗い行と細かい行が混ざる。
  //   ⚠️ 全体を同じ数で割ると【格子がそのまま見える】＝ただのモザイクになり、
  //     参考画像の「帯に潰れた」状態にならない。ここが芯。
  const rows = Math.max(1, P.rows);
  let y = 0;
  for(let j=0;j<rows;j++){
    // 行の高さもばらす（帯の太さが揃わない＝手で置いたように見える）
    const hj = rnd(j*7.1) ;
    const rh = Math.max(2, Math.round(H/rows * (1 - P.vary/100*0.6 + hj * P.vary/100*1.2)));
    const y0 = y, y1 = Math.min(H, y + rh);
    y = y1;
    if(y0 >= H) break;
    // ⭐ この行を何本の帯に割るか＝粗い〜細かいの間で行ごとに変わる
    const t  = rnd(j*3.3);
    const nx = Math.round(P.minx + (P.maxx - P.minx) * t);
    let x = 0;
    for(let i=0;i<nx;i++){
      // 帯の幅もばらす＝等分にしない（等分だと格子に見える）
      const wj = rnd(j*11.7 + i*5.3);
      const bw = Math.max(2, Math.round(W/nx * (1 - P.vary/100*0.5 + wj * P.vary/100)));
      const x0 = x, x1 = Math.min(W, x + bw);
      x = x1;
      if(x0 >= W) break;
      let r=0,g=0,b=0,n=0;
      const sx = Math.max(1, Math.floor((x1-x0)/10)), sy = Math.max(1, Math.floor((y1-y0)/10));
      for(let yy=y0;yy<y1;yy+=sy) for(let xx=x0;xx<x1;xx+=sx){
        const q = (yy*W+xx)*4; r+=d[q]; g+=d[q+1]; b+=d[q+2]; n++;
      }
      if(!n) n = 1;
      let c = [r/n, g/n, b/n];
      /* ⭐ 光 ── 木下＝「明るい方が生えるね」。暗い写真でも帯が立つように、
         採った色の側で持ち上げる。⚠️ 写真そのものは変えない（下に覗く写真は元のまま）。 */
      if(P.expo !== 0 || P.sat !== 100){
        const e = 1 + P.expo/100, sa = P.sat/100;
        const l = (c[0]*.299 + c[1]*.587 + c[2]*.114);
        c = c.map(v => Math.max(0, Math.min(255, (l + (v - l) * sa) * e)));
      }
      cells.push({ i, j, x0, y0, x1, y1, c, row:j, lum:(c[0]*.299+c[1]*.587+c[2]*.114) });
    }
  }
  cells.forEach((c,k) => { c.seed = rnd(k*1.37); });
}
/* ⚠️ 乱数は種を固定する。毎回変わると、つまみを動かすたびに別物になって
   「さっきの方がよかった」に戻せない（偶然の装置でも、戻れることは要る）。 */
function rnd(n){ const x = Math.sin(n * 127.1 + P.seed * 311.7) * 43758.5453; return x - Math.floor(x); }

/* ── 色を絞る ── 写真から抜き出した色だけを残す ───────── */
function quant(c, st){
  const s = Math.max(2, st || P.steps);
  const b = P.bias / 100;
  return c.map(v => {
    let t = v / 255;
    // ⚠️ 寄せる＝明暗の端に寄せる。上げると色が飛んで版画のようになる
    t = t + (t - 0.5) * b;
    t = Math.max(0, Math.min(1, t));
    return Math.round(Math.round(t * (s-1)) / (s-1) * 255);
  });
}
const css = c => `rgb(${c[0]|0},${c[1]|0},${c[2]|0})`;

/* ── 描く ── 写真の上に帯を重ねる ───────────────────────
   ⭐ ここが芯。全部塗らない＝写真と帯が同居する。 */
/* ⭐ 写真は【一度だけ】別の canvas に描いておく。
   ⚠️ つまみを動かすたびに元画像を drawImage すると、大きな写真でそこが重い。 */
let base = null;
function makeBase(){
  base = document.createElement('canvas');
  base.width = cv.width; base.height = cv.height;
  base.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);
}

/* ⭐ 音で揺れる量。⚠️ P そのものは書き換えない＝音を止めれば元の設定に戻る
   （書き換えると、鳴らしたあと設定が変わってしまって戻せない）。 */
function mod(){
  const a = P.amount / 100;
  return {
    fill:  Math.max(0, Math.min(100, P.fill  + M.low  * a * 45)),
    steps: Math.max(2, Math.round(P.steps - M.high * a * P.steps * 0.6)),
    reach: P.reach + M.mid * a * 160,
  };
}

function draw(){
  if(!img) return;
  if(!base || base.width !== cv.width) makeBase();
  ctx.clearRect(0,0,cv.width,cv.height);
  ctx.drawImage(base, 0, 0);                          // まず写真（焼いてあるもの）

  const m = mod();
  const list = order(cells);
  const upto = Math.round(list.length * m.fill / 100);
  for(let k=0;k<upto;k++) band(list[k], m);
}

function order(cs){
  const a = cs.slice();
  if(P.order === 'dark')  a.sort((p,q) => p.lum - q.lum);
  else if(P.order === 'light') a.sort((p,q) => q.lum - p.lum);
  else a.sort((p,q) => p.seed - q.seed);
  return a;
}

/* 帯ひとつ ── そのマスの色から、隣の色へ渡るグラデを引く */
function band(c, m){
  if(!c) return;
  m = m || mod();
  /* ⭐⭐ 引き算 ── 帯を消して、下の写真を覗かせる（木下＝「ここから引き算として
     ノイズを入れることになる」）。⚠️ 上にノイズを足すのではなく【帯を抜く】。
     ⭐ 音が鳴っていると、どの帯が消えるかが揺れる＝同じ設定でも毎回ちがう。 */
  if(P.drop > 0){
    const n = rnd(c.x0 * 0.37 + c.y0 * 0.11 + c.row * 2.3);
    const shake = (M.low + M.mid + M.high) / 3 * (P.amount/100);
    if(n < P.drop/100 * (1 + shake * 0.8)) return;      // この帯は刷らない
  }
  const horiz = P.dir === 'x';
  const reach = m.reach / 100;
  const w = (c.x1 - c.x0), h = (c.y1 - c.y0);
  // ⭐ のび＝マスを越えて伸びる。手作業の帯が横に長かったのを効かせる
  const bw = horiz ? w * reach : w;
  const bh = horiz ? h : h * reach;
  const x = horiz ? c.x0 - (bw - w)/2 : c.x0;
  const y = horiz ? c.y0 : c.y0 - (bh - h)/2;

  const a = quant(c.c, m.steps);
  const nb = neighbor(c);                    // 隣のマス＝渡る先の色
  const b = quant(nb ? nb.c : c.c, m.steps);

  const g = horiz ? ctx.createLinearGradient(x, 0, x+bw, 0)
                  : ctx.createLinearGradient(0, y, 0, y+bh);
  const s = P.soft / 100;                    // にじみ＝端をどれだけ溶かすか
  g.addColorStop(0, css(a));
  g.addColorStop(Math.max(0.001, 0.5 - s*0.5), css(a));
  g.addColorStop(Math.min(0.999, 0.5 + s*0.5), css(b));
  g.addColorStop(1, css(b));
  ctx.fillStyle = g;
  ctx.fillRect(x, y, bw, bh);
}
function neighbor(c){
  // ⭐ 隣＝同じ行の次の帯。行ごとに本数が違うので、行の中で探す
  if(P.dir === 'x') return cells.find(o => o.row === c.row && o.i === c.i + 1) || null;
  return cells.find(o => o.row === c.row + 1 && o.x0 <= c.x0 && o.x1 > c.x0) || null;
}

/* ── つまみ ───────────────────────────────────────────── */
/* ⭐⭐ つまみを滑らかにする。
   🔴 前は input のたびに【全マスを作り直して即描画】していたので、
      大きな写真ではスライダーが飛び飛びになった（木下＝「なめらかに調整できるように」）。
   ⭐ 直し方は2つ
     ① 割り直しが要るのは【段・粗い・細かい・ばらつき・ひき直す】だけ。
        色や帯や進みは【割り直さず塗り直すだけ】で足りる。
     ② 描画は次のフレームに1回だけまとめる（input は1操作で何度も飛んでくる）。
   ⚠️ SAKUJI で粒を軽くしたときと同じ手（42ms→12ms になった）。 */
let _need = 0, _raf = 0;          // _need: 1=塗り直し 2=割り直し
function invalidate(level){
  _need = Math.max(_need, level);
  if(_raf) return;
  _raf = requestAnimationFrame(() => {
    _raf = 0;
    if(_need >= 2) build();
    _need = 0;
    draw();
  });
}
function bind(id, key, heavy){
  const r = document.getElementById(id);
  const v = r.parentElement.querySelector('.val');
  const sync = () => {
    P[key] = +r.value;
    if(v) v.textContent = r.value;
    invalidate(heavy ? 2 : 1);
  };
  r.addEventListener('input', sync);
  P[key] = +r.value; if(v) v.textContent = r.value;   // ⚠️ 初期表示だけ。ここでは描かない
}
bind('rows','rows',true); bind('minx','minx',true); bind('maxx','maxx',true);
bind('vary','vary',true); bind('seed','seed',true);
bind('steps','steps'); bind('bias','bias');
bind('soft','soft');   bind('reach','reach'); bind('fill','fill');
bind('drop','drop');   bind('amount','amount');
bind('expo','expo',true); bind('sat','sat',true);   // ⚠️ 光は色を採り直すので割り直し

document.querySelectorAll('.seg').forEach(seg => {
  seg.querySelectorAll('button').forEach(b => {
    b.addEventListener('click', () => {
      seg.querySelectorAll('button').forEach(x => x.classList.remove('on'));
      b.classList.add('on');
      P[seg.id === 'dir' ? 'dir' : 'order'] = b.dataset.v;
      invalidate(1);
    });
  });
});

/* ── 読み込み（ボタン・ドロップ）─────────────────────── */
document.getElementById('bLoad').onclick = () => document.getElementById('file').click();
document.getElementById('file').addEventListener('change', e => {
  const f = e.target.files[0]; if(!f) return;
  loadImage(URL.createObjectURL(f));
  e.target.value = '';
});
const dropEl = document.getElementById('drop');
addEventListener('dragover', e => { e.preventDefault(); dropEl.classList.add('on'); });
addEventListener('dragleave', e => { if(e.relatedTarget === null) dropEl.classList.remove('on'); });
addEventListener('drop', e => {
  e.preventDefault(); dropEl.classList.remove('on');
  const f = [...e.dataTransfer.files].find(x => x.type.startsWith('image/'));
  if(f) loadImage(URL.createObjectURL(f));
});

/* ── 書き出し ─────────────────────────────────────────── */
const dl = (blob, name) => {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
};
document.getElementById('bPNG').onclick = () => {
  cv.toBlob(b => dl(b, `oboro_${Date.now()}.png`), 'image/png');
};
/* ⭐ SVG ── 帯は【矩形＋linearGradient】なので、そのままベクターで出せる。
   ⚠️ 元の写真は入れない（帯だけ）。写真ごと出したいときは PNG。 */
document.getElementById('bSVG').onclick = () => {
  const list = order(cells);
  const upto = Math.round(list.length * P.fill / 100);
  const horiz = P.dir === 'x', reach = P.reach/100, s = P.soft/100;
  let defs = '', body = '';
  for(let k=0;k<upto;k++){
    const c = list[k]; if(!c) continue;
    const w = c.x1-c.x0, h = c.y1-c.y0;
    const bw = horiz ? w*reach : w, bh = horiz ? h : h*reach;
    const x = horiz ? c.x0-(bw-w)/2 : c.x0, y = horiz ? c.y0 : c.y0-(bh-h)/2;
    const a = quant(c.c), nb = neighbor(c), b = quant(nb ? nb.c : c.c);
    const id = 'g'+k;
    defs += `<linearGradient id="${id}" x1="${horiz?0:0}" y1="${horiz?0:0}" x2="${horiz?1:0}" y2="${horiz?0:1}">`
          + `<stop offset="0" stop-color="${css(a)}"/>`
          + `<stop offset="${Math.max(0.001,0.5-s*0.5).toFixed(3)}" stop-color="${css(a)}"/>`
          + `<stop offset="${Math.min(0.999,0.5+s*0.5).toFixed(3)}" stop-color="${css(b)}"/>`
          + `<stop offset="1" stop-color="${css(b)}"/></linearGradient>`;
    body += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" fill="url(#${id})"/>`;
  }
  const svg = `<?xml version="1.0" encoding="UTF-8"?>\n`
    + `<svg xmlns="http://www.w3.org/2000/svg" width="${cv.width}" height="${cv.height}" `
    + `viewBox="0 0 ${cv.width} ${cv.height}"><defs>${defs}</defs>${body}</svg>`;
  dl(new Blob([svg], {type:'image/svg+xml'}), `oboro_${Date.now()}.svg`);
};

/* ── 音 ────────────────────────────────────────────────
   ⭐ KUMI と同じ作り（AnalyserNode で低音・中音・高音を採る）。
   ⚠️ P は書き換えず M（音の量）だけ動かす＝音を止めれば元の設定に戻る。 */
let actx=null, analyser=null, freq=null, playing=null;
function audioReady(){
  if(actx) return;
  actx = new (window.AudioContext || window.webkitAudioContext)();
  analyser = actx.createAnalyser();
  analyser.fftSize = 1024; analyser.smoothingTimeConstant = 0.6;
  freq = new Uint8Array(analyser.frequencyBinCount);
  tick();
}
function bandAvg(a, b){
  const n = freq.length, i0 = Math.floor(n*a), i1 = Math.max(i0+1, Math.floor(n*b));
  let s = 0; for(let i=i0;i<i1;i++) s += freq[i];
  return s / (i1-i0) / 255;
}
function tick(){
  requestAnimationFrame(tick);
  if(!analyser) return;
  analyser.getByteFrequencyData(freq);
  const k = 0.25;
  M.low  += (bandAvg(0,.07)  - M.low ) * k;
  M.mid  += (bandAvg(.07,.34) - M.mid ) * k;
  M.high += (bandAvg(.34,1)   - M.high) * k;
  // ⚠️ 音が鳴っている間だけ描き直す（止まっていれば描かない＝無駄に回さない）
  if(P.amount > 0 && (M.low + M.mid + M.high) > 0.01) invalidate(1);
}
document.getElementById('bMic').onclick = async () => {
  try{
    audioReady();
    const st = await navigator.mediaDevices.getUserMedia({ audio:true });
    actx.createMediaStreamSource(st).connect(analyser);
    document.getElementById('sndnote').innerHTML = '⭐ マイクが入った。音を出すと帯が揺れる';
  }catch(e){ document.getElementById('sndnote').textContent = 'マイクが使えなかった：' + e.message; }
};
document.getElementById('bSnd').onclick = () => document.getElementById('sfile').click();
document.getElementById('sfile').addEventListener('change', e => {
  const f = e.target.files[0]; if(!f) return;
  audioReady();
  if(playing) playing.pause();
  playing = new Audio(URL.createObjectURL(f));
  playing.loop = true;
  const srcNode = actx.createMediaElementSource(playing);
  srcNode.connect(analyser); srcNode.connect(actx.destination);
  playing.play();
  document.getElementById('sndnote').innerHTML = '⭐ 鳴っている（もう一度押すと別の音に差し替え）';
  e.target.value = '';
});

