<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>連 REN — 作品を1本にする</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;700;900&display=swap" rel="stylesheet">

<style>
  :root{
    --paper:#f4f2ee; --ink:#0a0a0a; --line:rgba(0,0,0,.12);
    --fill:rgba(0,0,0,.05); --fill2:rgba(0,0,0,.08);
    --glass:rgba(244,242,238,.82); --capsule:#fff; --r:11px;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;overflow:hidden;background:var(--paper);color:var(--ink);
    font-family:"Space Mono",monospace;overscroll-behavior:none;
    width:100%;max-width:100%;overflow-x:hidden;}

  #stage{position:fixed;left:0;top:0;right:290px;bottom:var(--tlh);display:flex;
    align-items:center;justify-content:center;padding:24px;}
  #view{max-width:100%;max-height:100%;box-shadow:0 2px 24px rgba(0,0,0,.14);background:#000;}

  #rack{position:fixed;top:0;right:0;bottom:var(--tlh);width:290px;z-index:10;
    overflow-y:auto;overflow-x:hidden;touch-action:pan-y;overscroll-behavior:contain;
    background:var(--glass);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
    border-left:1px solid var(--line);padding:10px;}
  .unit{margin-bottom:8px;max-width:100%;background:var(--capsule);border-radius:var(--r);
    overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.06),0 0 0 .5px rgba(0,0,0,.05);}
  .unit-head{display:flex;align-items:center;gap:7px;padding:11px 12px;cursor:pointer;user-select:none;}
  .led{width:6px;height:6px;border-radius:50%;background:var(--ink);flex:none;}
  .unit.off .led{background:rgba(0,0,0,.18);}
  .unit.off .unit-body{display:none;}
  .unit-idx{font-size:9px;opacity:.35;letter-spacing:.1em;}
  .unit-name{font-size:11px;letter-spacing:.14em;font-weight:700;}
  .unit-jp{font-size:10px;opacity:.5;letter-spacing:.08em;margin-left:auto;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  .unit-body{padding:2px 12px 12px;}

  .row{display:flex;align-items:center;gap:9px;padding:3px 0;min-width:0;max-width:100%;}
  .row label{font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.1em;
    opacity:.5;width:62px;flex:none;}
  .row label i{display:block;font-style:normal;letter-spacing:0;font-size:9.5px;opacity:.95;
    margin-top:1px;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  input[type=range]{flex:1 1 0;min-width:0;-webkit-appearance:none;height:26px;
    background:none;touch-action:none;}
  input[type=range]::-webkit-slider-runnable-track{height:3px;background:currentColor;opacity:.22;border-radius:2px;}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;
    margin-top:-6px;border-radius:50%;background:currentColor;}
  .val{font-size:9px;opacity:.45;width:34px;text-align:right;flex:none;}

  .seg{display:flex;background:var(--fill2);border-radius:9px;padding:2px;gap:2px;
    margin:6px 0 8px;min-width:0;max-width:100%;}
  .seg button{flex:1 1 auto;white-space:nowrap;border:none;border-radius:7px;background:none;
    cursor:pointer;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;
    font-size:11px;color:var(--ink);opacity:.5;padding:7px 0;transition:.16s;touch-action:manipulation;}
  .seg button.on{opacity:1;background:var(--capsule);font-weight:700;box-shadow:0 1px 4px rgba(0,0,0,.18);}
  .btn{width:100%;background:var(--fill);border:none;border-radius:var(--r);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;font-size:12px;
    padding:10px 0;cursor:pointer;margin-top:4px;touch-action:manipulation;}
  .btn.on{background:#0a0a0a;color:#f4f2ee;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
  .mod{font-size:9.5px;line-height:1.75;opacity:.62;margin:6px 0 2px;
    word-break:break-word;overflow-wrap:anywhere;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;display:none;}
  body.help .mod{display:block;}
  /* ⚠️ .mod は help の時しか出ない。押した結果は【いつでも見えないと無反応に見える】ので別にする */
  /* ⚠️ 版下になっていない間は、つまみを触っても何も起きない＝薄くして触れなくする */
  body:not(.has-tilt) .tilt-only{opacity:.32;pointer-events:none;}
  .note{font-size:10px;line-height:1.7;opacity:.7;margin:8px 0 2px;min-height:14px;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}

  /* ⭐⭐⭐ タイムライン ── 下に固定して、Premiere と同じ思想でいく（木下 2026-08-02）。
     🔴 前は「クリップの四角（#track）」と「尺の帯（#tl）」が右パネルに【別々に】あり、
        時間軸が繋がっていなかった＝木下「CLIPSは下にタイムラインとして。わかりにくい」。
     ⭐ 直し方＝両方をやめて【下に1本の時間軸】にする。レーンを縦に積み、
        再生ヘッドが全レーンを貫く。参考＝木下自身の Karuma（kamera_tk）の .timeline/.lane/.playhead。
     ⚠️ 以前のノートには「Premiere に近づけない／多段レイヤーにしない」と書いてあったが、
        2026-08-02 に木下が方針変更＝「このあたりは Premiere と同じ思想でいこう」。
     ⭐ 見た目は SwiftUI 準拠（白いカード・角丸・すりガラス・ヘアライン）。⚠️ 絵文字は使わない。 */
  :root{ --tlh:212px; --gut:56px; }   /* gut＝レーン名の幅＝時間軸の原点 */

  #tlwrap{position:fixed;left:0;right:0;bottom:0;height:var(--tlh);z-index:12;
    background:var(--glass);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
    border-top:1px solid var(--line);display:flex;flex-direction:column;}
  #tlbar{display:flex;align-items:center;gap:6px;padding:0 12px;height:42px;flex:none;
    border-bottom:1px solid var(--line);}
  #tlbar button{background:var(--capsule);border:none;border-radius:8px;padding:7px 12px;
    font-family:"Space Mono",monospace;font-size:10px;letter-spacing:.08em;cursor:pointer;
    color:var(--ink);touch-action:manipulation;box-shadow:0 1px 3px rgba(0,0,0,.08),0 0 0 .5px rgba(0,0,0,.05);}
  #tlbar button.on{background:#0a0a0a;color:#f4f2ee;}
  #tlbar .sp{flex:1;}
  #tclock{font-family:"Space Mono",monospace;font-size:10.5px;opacity:.55;
    font-variant-numeric:tabular-nums;letter-spacing:.04em;}
  #zLbl{font-family:"Space Mono",monospace;font-size:9.5px;opacity:.45;width:26px;text-align:center;}

  #lanes{flex:1;overflow-x:auto;overflow-y:hidden;position:relative;padding:8px 16px 12px;
    touch-action:pan-x;}
  #tlcontent{position:relative;min-width:100%;height:100%;}
  /* 目盛り＝クリックでその時間へ飛ぶ */
  #ruler{position:relative;height:15px;margin-left:var(--gut);cursor:pointer;}
  #ruler span{position:absolute;top:0;transform:translateX(-50%);font-size:9px;opacity:.42;
    font-family:"Space Mono",monospace;font-variant-numeric:tabular-nums;pointer-events:none;}
  #ruler i{position:absolute;top:11px;width:1px;height:4px;background:currentColor;opacity:.2;}

  .lane{display:flex;align-items:stretch;margin-top:7px;}
  .laneLabel{width:var(--gut);flex:none;display:flex;align-items:center;font-size:10px;opacity:.45;
    letter-spacing:.06em;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  .laneBody{position:relative;flex:1;}
  #clipLane{position:relative;height:58px;background:var(--fill2);border-radius:9px;}
  #sndLane{position:relative;height:46px;background:var(--fill2);border-radius:9px;overflow:hidden;}
  #clipLane.empty::after{content:'ここに画像や動画を放り込む';position:absolute;left:12px;top:0;bottom:0;
    display:flex;align-items:center;opacity:.38;font-size:10.5px;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  #sndLane.empty::after{content:'ここに音源を放り込む';position:absolute;left:12px;top:0;bottom:0;
    display:flex;align-items:center;opacity:.38;font-size:10.5px;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  #wave{position:absolute;left:0;top:0;height:100%;display:block;}

  /* クリップ＝尺の長さの帯。⭐ 幅がそのまま秒数＝どれが長いか目で分かる
     ⚠️ クラス名は .clipseg。.seg は【ラックのセグメンテッドコントロールが先に使っている】ので、
        同じ名前にすると後勝ちで版面の切替が壊れる（Karuma も .clipseg と呼んでいる） */
  .clipseg{position:absolute;top:0;bottom:0;border-radius:7px;overflow:hidden;background:#000;
    cursor:grab;box-shadow:0 0 0 .5px rgba(0,0,0,.18);}
  .clipseg.sel{box-shadow:0 0 0 2px var(--ink);}
  .clipseg img,.clipseg video{width:100%;height:100%;object-fit:cover;opacity:.86;pointer-events:none;}
  .clipseg .n{position:absolute;left:5px;top:3px;font-size:8.5px;color:#fff;
    text-shadow:0 1px 2px #000;pointer-events:none;font-family:"Space Mono",monospace;}
  .clipseg .t{position:absolute;left:5px;bottom:3px;font-size:8.5px;color:#fff;
    text-shadow:0 1px 2px #000;pointer-events:none;font-family:"Space Mono",monospace;}
  .clipseg .x{position:absolute;right:3px;top:2px;width:17px;height:17px;border:none;
    background:rgba(0,0,0,.5);color:#fff;border-radius:50%;font-size:11px;line-height:1;cursor:pointer;}
  .clipseg .h{position:absolute;top:0;bottom:0;right:0;width:10px;cursor:ew-resize;z-index:2;
    background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.28));}
  /* ⚠️ 左のトリムは動画だけ出す（画像は素材の中に時間が無いので出さない） */
  .clipseg .h.l{left:0;right:auto;background:linear-gradient(270deg,rgba(255,255,255,0),rgba(255,255,255,.28));}
  .clipseg .h::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:2px;height:38%;background:rgba(255,255,255,.65);border-radius:1px;}

  /* 再生ヘッド＝全レーンを縦に貫く（Karuma と同じ） */
  #playhead{position:absolute;top:0;bottom:0;width:1.5px;background:#e0322a;z-index:5;
    pointer-events:none;left:var(--gut);}
  #phgrab{position:absolute;top:-3px;left:-7px;width:16px;height:16px;border-radius:50%;
    background:#e0322a;pointer-events:auto;cursor:grab;box-shadow:0 1px 4px rgba(0,0,0,.3);}
  #phgrab:active{cursor:grabbing;}

  #drop{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;
    background:rgba(10,10,10,.7);color:#f4f2ee;font-size:15px;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  #drop.on{display:flex;}

  #title{position:fixed;left:22px;top:18px;z-index:11;mix-blend-mode:difference;color:#fff;pointer-events:none;}
  #title h1{font-family:"Zen Kaku Gothic New",sans-serif;font-weight:900;font-size:24px;line-height:1;}
  #title p{font-size:8.5px;letter-spacing:.16em;opacity:.5;margin-top:5px;}

  #helpBtn{position:fixed;top:14px;right:14px;z-index:30;width:30px;height:30px;
    border-radius:50%;border:1px solid var(--line);background:var(--glass);
    -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
    color:var(--ink);cursor:pointer;font-size:13px;line-height:1;}
  body.help #helpBtn{background:var(--ink);color:var(--paper);}
  #manual{position:fixed;inset:0;z-index:40;display:none;background:rgba(0,0,0,.45);
    padding:24px;overflow-y:auto;}
  #manual.on{display:block;}
  #manual .sheet{max-width:560px;margin:0 auto;background:var(--capsule);border-radius:16px;
    padding:22px 22px 28px;position:relative;
    font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif;}
  #manual h2{font-size:16px;margin-bottom:10px;}
  #manual h3{font-size:12px;margin:16px 0 4px;letter-spacing:.06em;}
  #manual p{font-size:12px;line-height:1.85;opacity:.78;}
  #manual .x{position:absolute;top:12px;right:14px;border:none;background:none;
    font-size:20px;cursor:pointer;color:var(--ink);line-height:1;}

  @media(max-width:760px){
    /* ⚠️ 縦に3段（画面／タイムライン／設定）。タイムラインは真ん中に置く＝
       画を見ながら尺を触れる。⚠️ ここは @media を1ブロックだけにする（後勝ちで壊れるため） */
    :root{ --tlh:168px; --gut:44px; }
    #stage{right:0;top:0;height:34dvh;bottom:auto;padding:12px;}
    #tlwrap{top:34dvh;bottom:auto;}
    #rack{top:calc(34dvh + var(--tlh));bottom:0;left:0;right:auto;width:100vw;max-width:100vw;
      border-left:none;border-top:1px solid var(--line);}
    #rack *{max-width:100%;}
    #clipLane{height:48px;} #sndLane{height:38px;}
    input[type=range]{height:42px;}
    input[type=range]::-webkit-slider-thumb{width:22px;height:22px;margin-top:-9.5px;}
    button,.btn,.seg button{min-height:38px;}
    #tlbar button{padding:9px 12px;min-height:34px;font-size:10px;}
    #helpBtn{top:10px;right:10px;}
    #manual{padding:12px;}
  }
</style>

<div id="title"><h1>連</h1><p>REN / KINOSHITA STUDIO</p></div>
<button id="helpBtn" title="使い方">?</button>
<div id="drop">ここに落とす</div>

<div id="manual"><div class="sheet">
  <button class="x" id="manualX">×</button>
  <h2>連 REN の使い方</h2>
  <p><b>作った画像や動画を放り込んで、1本の動画にする道具。</b>
     Premiere を立ち上げずに、SNS に上げるところまでを1画面で終わらせる。</p>
  <h3>入れる</h3>
  <p>画面のどこにでも <b>ドラッグ＆ドロップ</b>（PNG / JPG / WebP / mp4 / webm）。
     並びは<b>クリップをドラッグ</b>して入れ替え。<b>×</b>で外す。</p>
  <h3>繋ぐ</h3>
  <p><b>1枚の尺</b>＝画像1枚を何秒映すか。動画はその長さのまま流れる。
     <b>済し</b>＝カットの間をどれだけ溶かすか（0 でパッと切り替え）。</p>
  <h3>版面</h3>
  <p>出る大きさ。<b>たて 9:16</b>＝リール／<b>正方形</b>＝フィード／<b>よこ 16:9</b>。
     素材は版面に<b>収める</b>か<b>埋める</b>かを選べる。</p>
  <h3>出す</h3>
  <p><b>動画</b>＝mp4（使えないブラウザは webm）。<b>GIF</b>＝軽いが色数が減る。
     ⚠️ 書き出しは<b>実時間かかる</b>（10秒の動画なら10秒）。</p>
</div></div>

<div id="stage"><canvas id="view"></canvas></div>

<div id="rack">
  <div class="unit" data-unit="src">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">01</span>
      <span class="unit-name">CLIPS</span><span class="unit-jp">素材</span></div>
    <div class="unit-body">
      <div class="mod">⭐ 画面のどこにでも<b>ドラッグ＆ドロップ</b>（画像・動画・音源）。
        並びと尺は<b>下のタイムライン</b>で触る＝掴んで入れ替え／右端で伸縮／<b>×</b>で外す</div>
      <button class="btn" id="bAdd">素材を選ぶ</button>
      <input type="file" id="file" accept="image/*,video/*" multiple style="display:none">
      <div class="mod" id="srcNote"></div>
    </div>
  </div>

  <div class="unit" data-unit="snd">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">02</span>
      <span class="unit-name">SOUND</span><span class="unit-jp">音</span></div>
    <div class="unit-body">
      <div class="mod">⭐ 音源を入れると<b>下のタイムラインに波形</b>が出る。映像と<b>同じ時間軸</b>なので、
        音の切れ目に合わせて尺を伸縮できる<br>
        ⚠️ 書き出した動画に<b>音は入らない</b>（canvas を録っているため）。合わせるための目印</div>
      <button class="btn" id="bSnd">音源を入れる</button>
      <input type="file" id="sfile" accept="audio/*" style="display:none">
      <div class="mod" id="sndNote"></div>
    </div>
  </div>

  <div class="unit" data-unit="cut">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">03</span>
      <span class="unit-name">CUT</span><span class="unit-jp">繋ぐ</span></div>
    <div class="unit-body">
      <div class="row"><label>HOLD<i>1枚の尺</i></label><input type="range" data-p="hold" min="2" max="60" step="1" value="12"><span class="val"></span></div>
      <div class="row"><label>FADE<i>済し</i></label><input type="range" data-p="fade" min="0" max="20" step="1" value="0"><span class="val"></span></div>
      <div class="mod">⭐ <b>1枚の尺</b>＝画像1枚を何秒映すか（動画はその長さのまま流れる）<br>
        <b>済し</b>＝カットの間をどれだけ溶かすか。<b>0 でパッと切り替え</b></div>
    </div>
  </div>

  <div class="unit" data-unit="frame">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">04</span>
      <span class="unit-name">FRAME</span><span class="unit-jp">版面</span></div>
    <div class="unit-body">
      <div class="seg" data-seg="shape">
        <button data-v="1" class="on">たて 9:16</button>
        <button data-v="0">正方形</button>
        <button data-v="2">よこ 16:9</button>
      </div>
      <div class="seg" data-seg="fitMode">
        <button data-v="0" class="on">収める</button>
        <button data-v="1">埋める</button>
      </div>
      <div class="row"><label>LONG<i>長辺</i></label><input type="range" data-p="long" min="480" max="1920" step="40" value="1280"><span class="val"></span></div>
      <div class="row"><label>BG<i>地の色</i></label><input type="color" id="bg" value="#0a0a0a"></div>
      <div class="mod" id="frameOut"></div>
    </div>
  </div>

  <!-- ⭐⭐ 傾け（TILT）── 1枚の絵を、そのまま回して奥へ倒す。
       🔴 最初は「同じ絵を何枚も撒く」ものを作ったが【やりたいことが違った】。
          木下＝「二枚に増やしたいわけではなく、その一枚の画像を角度を変えたり
          奥ゆきをつけたりしたい。散らばらせるつもりはない。
          俺が他ツールで作成して一枚の画像として作成した意味がなくなるじゃん」。
       ⭐ つまり【完成した1枚を壊さずに、置き方だけ変える】。増やさない。 -->
  <div class="unit" data-unit="tilt">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">05</span>
      <span class="unit-name">TILT</span><span class="unit-jp">傾け</span></div>
    <div class="unit-body">
      <div class="mod">⭐ 選んだ画像を<b>1枚のまま</b>、回して奥へ倒す。増やさない<br>
        ⭐ <b>ステージの上でドラッグ</b>すると位置を動かせる</div>
      <button class="btn" id="bTilt">傾ける</button>
      <div class="row tilt-only"><label>TURN<i>回す</i></label><input type="range" id="tlRz" min="-180" max="180" step="1" value="-8"><span class="val"></span></div>
      <div class="row tilt-only"><label>PITCH<i>上下に倒す</i></label><input type="range" id="tlRx" min="-70" max="70" step="1" value="24"><span class="val"></span></div>
      <div class="row tilt-only"><label>YAW<i>左右に倒す</i></label><input type="range" id="tlRy" min="-70" max="70" step="1" value="-18"><span class="val"></span></div>
      <div class="row tilt-only"><label>DEPTH<i>奥ゆき</i></label><input type="range" id="tlPs" min="0" max="100" step="1" value="55"><span class="val"></span></div>
      <div class="row tilt-only"><label>SIZE<i>大きさ</i></label><input type="range" id="tlSc" min="10" max="200" step="1" value="80"><span class="val"></span></div>
      <button class="btn tilt-only" id="bTiltReset">まっすぐに戻す</button>
      <div class="mod">⭐ <b>奥ゆき</b>＝0 で平面のまま傾く（歪まない）／上げるほど<b>紙が奥へ倒れて台形になる</b>。
        参照の版下はここが効いている</div>
      <div class="note" id="tlNote"></div>
    </div>
  </div>

  <div class="unit" data-unit="out">
    <div class="unit-head"><span class="led"></span><span class="unit-idx">06</span>
      <span class="unit-name">EXPORT</span><span class="unit-jp">出す</span></div>
    <div class="unit-body">
      <div class="row"><label>FPS<i>こま</i></label><input type="range" data-p="fps" min="12" max="30" step="1" value="30"><span class="val"></span></div>
      <div class="grid2">
        <button class="btn" id="bMovie">動画で出す</button>
        <button class="btn" id="bGif">GIF で出す</button>
      </div>
      <div class="mod">⚠️ 書き出しは<b>実時間かかる</b>（10秒の動画なら10秒）<br>
        ⭐ 動画＝mp4（使えないブラウザは webm）／GIF＝軽いが色数が減る</div>
      <div class="mod" id="outNote"></div>
