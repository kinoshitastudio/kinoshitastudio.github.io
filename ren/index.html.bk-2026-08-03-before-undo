/* ══ 音 ══════════════════════════════════════════════════
   ⭐ 木下＝「音源が可視化して見えるように波形は出しておいて」。
     ⚠️ 書き出した動画に音は入らない（canvas を録っているので）。
        ここは【尺を音に合わせるための目印】として出す。
   ⚠️ 波形は毎フレーム描かない＝読み込んだときに一度だけ描く（重いので）。 */
let snd = null, sndBuf = null;
const waveCv = document.getElementById('wave');
function drawWave(){
  /* ⭐⭐ 音は【映像と同じ時間軸】で描く。ここが揃っていないと、音の切れ目に尺を合わせられない。
     ⚠️ 音が映像より長ければ、その分だけ右にはみ出す＝どれだけ余っているかが目で分かる。
     ⚠️ 毎フレームは描かない（重い）。尺・拡大・読み込みが変わったときだけ。 */
  const c = waveCv, g2 = c.getContext('2d');
  if(!g2) return;
  sndLane.classList.toggle('empty', !sndBuf);
  const p = pps();
  const w = Math.max(1, Math.round(span() * p));
  const h = sndLane.clientHeight || 46;
  c.style.width = w + 'px'; c.style.height = h + 'px';
  if(c.width !== w*2 || c.height !== h*2){ c.width = w*2; c.height = h*2; }
  g2.setTransform(2,0,0,2,0,0);
  g2.clearRect(0,0,w,h);
  if(!sndBuf) return;
  const aw = Math.max(1, Math.round(sndBuf.duration * p));   // 音そのものが占める幅
  const d = sndBuf.getChannelData(0), step = Math.max(1, Math.floor(d.length / aw));
  g2.strokeStyle = getComputedStyle(document.body).color; g2.globalAlpha = .5;
  g2.beginPath();
  for(let x = 0; x < aw; x++){
    let mn = 1, mx = -1;
    for(let i = 0; i < step; i++){ const v = d[x*step+i] || 0; if(v<mn)mn=v; if(v>mx)mx=v; }
    g2.moveTo(x+.5, h/2 + mn*h/2*.92);
    g2.lineTo(x+.5, h/2 + mx*h/2*.92);
  }
  g2.stroke(); g2.globalAlpha = 1;
  /* ⭐ 映像の終わりから先＝音が余っている所を沈める（どこまで届いているかが見える） */
  const T = total();
  if(sndBuf.duration > T){
    g2.fillStyle = getComputedStyle(document.body).backgroundColor;
    g2.globalAlpha = .55; g2.fillRect(T*p, 0, w - T*p, h); g2.globalAlpha = 1;
  }
}
/* 音源を読む（ボタンからでもドロップからでも同じ道を通す） */
async function loadSound(f){
  const url = URL.createObjectURL(f);
  snd = new Audio(url); snd.loop = false;
  try{
    const ac = new (window.AudioContext || window.webkitAudioContext)();
    sndBuf = await ac.decodeAudioData(await f.arrayBuffer());
    const n = document.getElementById('sndNote');
    if(n) n.innerHTML = `${f.name} ／ <b>${sndBuf.duration.toFixed(1)}秒</b>`;
  }catch(err){
    const n = document.getElementById('sndNote');
    if(n) n.textContent = '波形が読めなかった（再生はできる）';
  }
  layout();
}
document.getElementById('bSnd').onclick = () => document.getElementById('sfile').click();
document.getElementById('sfile').addEventListener('change', e => {
  const f = e.target.files[0]; e.target.value = '';
  if(f) loadSound(f);
});

/* ── 再生 ── */
document.getElementById('bPlay').onclick = e => {
  if(!clips.length) return;
  playing = !playing;
  if(playing){ t0 = performance.now(); clips.forEach(c => c.type==='vid' && c.el.play().catch(()=>{}));
    if(snd){ snd.currentTime = 0; snd.play().catch(()=>{}); } }
  else { clips.forEach(c => c.type==='vid' && c.el.pause()); if(snd) snd.pause(); }
  e.target.textContent = playing ? '‖ 止める' : '▶ 再生';
};
