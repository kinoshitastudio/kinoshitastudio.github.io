/* ══ 出す ══════════════════════════════════════════════════
   ⚠️ 書き出しは【実時間かかる】＝10秒の動画なら10秒。
      canvas を録るしかないので、早送りできない（そこは正直に出す）。 */
const dl = (blob, name) => {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  if(/iP(hone|ad|od)/.test(navigator.userAgent)) window.open(url, '_blank');
  setTimeout(() => URL.revokeObjectURL(url), 8000);
};
const outNote = t => { const n=document.getElementById('outNote'); if(n) n.textContent = t; };

document.getElementById('bMovie').onclick = () => {
  const T = total();
  if(!clips.length || T <= 0) return;
  /* ⭐ mp4 が使えるなら mp4（SNS にそのまま上げられる）。駄目なら webm */
  const types = ['video/mp4;codecs=avc1','video/mp4','video/webm;codecs=vp9','video/webm'];
  const mime = types.find(t => window.MediaRecorder && MediaRecorder.isTypeSupported(t)) || 'video/webm';
  const rec = new MediaRecorder(cv.captureStream(P.fps), { mimeType: mime });
  const chunks = [];
  rec.ondataavailable = e => e.data.size && chunks.push(e.data);
  rec.onstop = () => {
    dl(new Blob(chunks, {type:mime}), 'ren_' + Date.now() + (mime.includes('mp4') ? '.mp4' : '.webm'));
    outNote('出した（' + (mime.includes('mp4') ? 'mp4' : 'webm') + '）');
  };
  outNote('書き出し中… ' + T.toFixed(1) + '秒');
  playing = true; t0 = performance.now();
  clips.forEach(c => c.type==='vid' && c.el.play().catch(()=>{}));
  rec.start();
  setTimeout(() => { rec.stop(); playing = false;
    document.getElementById('bPlay').textContent = '▶ 再生'; }, T*1000 + 120);
};

/* ⭐ GIF ── 外の道具を使わずに自分で作る（1ファイルで完結させるため）。
   ⚠️ GIF は256色まで。⭐ 色は毎回【その絵から作る】（固定パレットだと濁る）。 */
document.getElementById('bGif').onclick = async () => {
  const T = total();
  if(!clips.length || T <= 0) return;
  const fps = Math.min(P.fps, 20);            // ⚠️ GIF は重いのでこま数を抑える
  const n = Math.max(2, Math.round(T * fps));
  outNote('GIF を作っている… 0/' + n);
  const was = playing; playing = false;
  const frames = [];
  for(let i = 0; i < n; i++){
    frameAt(T * i / n);
    frames.push(g.getImageData(0,0,cv.width,cv.height));
    if(i % 5 === 0){ outNote('GIF を作っている… ' + i + '/' + n); await new Promise(r => setTimeout(r)); }
  }
  outNote('まとめている…');
  await new Promise(r => setTimeout(r, 30));
  const blob = encodeGif(frames, cv.width, cv.height, Math.round(100/fps));
  dl(blob, 'ren_' + Date.now() + '.gif');
  outNote('出した（GIF）');
  playing = was;
};

/* ── GIF を書く（GIF89a・フレームごとに色を作る） ── */
function encodeGif(frames, W, H, delay){
  const out = [];
  const b  = v => out.push(v & 255);
  const s  = v => { b(v); b(v >> 8); };
  const str = t => { for(const ch of t) b(ch.charCodeAt(0)); };
  str('GIF89a'); s(W); s(H); b(0x70); b(0); b(0);      // 全体パレットは持たない
  str('!'); b(255); b(11); str('NETSCAPE2.0'); b(3); b(1); s(0); b(0);   // 無限ループ
  frames.forEach(f => {
    const { pal, idx } = quantize(f.data, W*H);
    str('!'); b(0xF9); b(4); b(0x04); s(delay); b(0); b(0);              // 待ち時間
    str(','); s(0); s(0); s(W); s(H); b(0x87);                           // 局所パレット 256
    for(let i = 0; i < 256; i++){ const c = pal[i] || [0,0,0]; b(c[0]); b(c[1]); b(c[2]); }
    lzw(idx, 8, out);
  });
  b(0x3B);
  return new Blob([new Uint8Array(out)], { type:'image/gif' });
}
/* ⚠️ 中央値分割まではやらない。⭐ よく出る色を数えて上位256色（8bitの発想と同じ） */
function quantize(d, n){
  const cnt = new Map();
  for(let i = 0; i < n; i++){
    const k = ((d[i*4] >> 3) << 10) | ((d[i*4+1] >> 3) << 5) | (d[i*4+2] >> 3);
    cnt.set(k, (cnt.get(k) || 0) + 1);
  }
  const top = [...cnt.entries()].sort((a,x) => x[1]-a[1]).slice(0,256).map(e => e[0]);
  const pal = top.map(k => [((k>>10)&31)<<3, ((k>>5)&31)<<3, (k&31)<<3]);
  const map = new Map(); top.forEach((k,i) => map.set(k,i));
  const idx = new Uint8Array(n);
  for(let i = 0; i < n; i++){
    const k = ((d[i*4] >> 3) << 10) | ((d[i*4+1] >> 3) << 5) | (d[i*4+2] >> 3);
    let v = map.get(k);
    if(v === undefined){                                  // 無い色は一番近いものへ
      const r=(k>>10)&31, gg=(k>>5)&31, bb=k&31;
      let best=0, bd=1e9;
      for(let j=0;j<pal.length;j++){
        const dr=(pal[j][0]>>3)-r, dg=(pal[j][1]>>3)-gg, db=(pal[j][2]>>3)-bb;
        const q=dr*dr+dg*dg+db*db; if(q<bd){bd=q;best=j;}
      }
      v = best; map.set(k, v);
    }
    idx[i] = v;
  }
  return { pal, idx };
}
function lzw(idx, minCode, out){
  const clear = 1 << minCode, eoi = clear + 1;
  let size = minCode + 1, next = eoi + 1;
  let dict = new Map(), cur = -1, bits = 0, acc = 0;
  const buf = [];
  const flush = () => { while(buf.length){ const n = Math.min(255, buf.length); out.push(n); for(let i=0;i<n;i++) out.push(buf.shift()); } };
  const put = code => {
    acc |= code << bits; bits += size;
    while(bits >= 8){ buf.push(acc & 255); acc >>= 8; bits -= 8; }
    if(buf.length >= 255){ out.push(255); for(let i=0;i<255;i++) out.push(buf.shift()); }
  };
  out.push(minCode);
  put(clear);
  for(let i = 0; i < idx.length; i++){
    const k = idx[i];
    if(cur < 0){ cur = k; continue; }
    const key = cur * 4096 + k;
    if(dict.has(key)) cur = dict.get(key);
    else{
      put(cur);
      if(next < 4096){ dict.set(key, next++); if(next > (1<<size) && size < 12) size++; }
      else { put(clear); dict = new Map(); size = minCode+1; next = eoi+1; }
      cur = k;
    }
  }
  if(cur >= 0) put(cur);
  put(eoi);
  if(bits > 0) buf.push(acc & 255);
  flush();
  out.push(0);
}

