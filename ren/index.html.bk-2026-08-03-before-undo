</div>

<!-- ⭐⭐ 下のタイムライン。レーンを縦に積んで、再生ヘッドが全部を貫く -->
<div id="tlwrap">
  <div id="tlbar">
    <button id="bPlay">▶ 再生</button>
    <button id="bLoop" class="on">↻ ループ</button>
