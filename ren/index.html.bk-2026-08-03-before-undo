/* ══ キーボード ═══════════════════════════════════════════
   ⭐ 木下＝「エンターで再生とかではないの？」。編集ソフトはスペースが標準なので【両方】効かせる。
   ⚠️ 入力欄に触っている時は横取りしない（数値を打てなくなる）。 */
addEventListener('keydown', e => {
  const t = e.target;
  if(t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
  if(e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); document.getElementById('bPlay').click(); }
  else if(e.key === 's' || e.key === 'S'){ e.preventDefault(); splitAt(cur); }
  else if(e.key === 'ArrowRight'){ e.preventDefault(); seekTo(cur + (e.shiftKey ? 1 : 0.1)); }
  else if(e.key === 'ArrowLeft'){  e.preventDefault(); seekTo(cur - (e.shiftKey ? 1 : 0.1)); }
  else if(e.key === 'Home'){ e.preventDefault(); seekTo(0); }
});

/* ══ 控える（設定を覚えておく）═══════════════════════════
   ⭐ 木下＝「ローカルにメモリーは入れておいて。リロードで毎回消えるのだるい」。
   ⚠️ 覚えるのは【設定だけ】。素材（画像・動画・音源）は Blob の URL なので
      リロードで寿命が切れる＝残すには IndexedDB に中身ごと入れる必要がある（別作業）。
      できないことを覚えたふりにしない＝開いた時に「素材はもう一度入れる」とだけ言う。 */
const MEM = 'ren_tk_v1';
let memT = 0;
function memSave(){
  clearTimeout(memT);
  memT = setTimeout(() => {
    try{
      const bd = {};
      Object.keys(TILT_IDS).forEach(id => { const e = document.getElementById(id); if(e) bd[id] = e.value; });
      localStorage.setItem(MEM, JSON.stringify({ P, bd, loop, zoom, help: document.body.classList.contains('help') }));
    }catch(_){}
  }, 250);
}
function memLoad(){
  let d = null;
  try{ d = JSON.parse(localStorage.getItem(MEM) || 'null'); }catch(_){}
  if(!d) return;
  Object.assign(P, d.P || {});
  /* つまみ・セグメント・色を、覚えている値に合わせ直す */
  document.querySelectorAll('input[type=range][data-p]').forEach(r => {
    if(P[r.dataset.p] == null) return;
    r.value = P[r.dataset.p];
    const v = r.parentElement.querySelector('.val'); if(v) v.textContent = r.value;
  });
  document.querySelectorAll('.seg[data-seg]').forEach(seg => {
    const k = seg.dataset.seg;
    seg.querySelectorAll('button').forEach(b => b.classList.toggle('on', +b.dataset.v === +P[k]));
  });
  const bgEl = document.getElementById('bg'); if(bgEl && P.bg) bgEl.value = P.bg;
  Object.entries(d.bd || {}).forEach(([id, v]) => {
    const e = document.getElementById(id); if(!e) return;
    e.value = v;
    const lab = e.parentElement.querySelector('.val'); if(lab) lab.textContent = v;
  });
  if(d.loop != null){
    loop = d.loop;
    document.getElementById('bLoop').classList.toggle('on', loop);
  }
  if(d.zoom) zoom = d.zoom;
  if(d.help) document.body.classList.add('help');
}
/* ⭐ 触ったものは全部おぼえる（1箇所にまとめる＝拾い漏れを作らない） */
addEventListener('input',  memSave, true);
addEventListener('change', memSave, true);
addEventListener('click',  memSave, true);
memLoad();

tiltNote();    /* ⚠️ 起動時にもボタンの状態を合わせる */
