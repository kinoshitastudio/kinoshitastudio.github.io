<script type="module">
/* ═══════════════════════════════════════════════════════════
   連 REN ── 作った画像や動画を放り込んで1本にする
   ⭐ 名前は木下が決定＝【連】。木下が SNS でやっている「連作」と同じ字。
      道具と発信が同じ名前で繋がる。⚠️「繋ぐ」は礫（粒を繋いで面にする）と被るのでやめた
   ⭐ 木下＝「出来上がった動画や画像を組み立てるツールが必要。
      これがあれば作品をひとつの動画やgifとして公開できる」
      「Premiere とか立ち上げるのめんどくさい」
   ⭐ 繋ぎ方と録画の考え方は siren/_lookbook/play.html から持ち出した
      （あちらは Siren 専用＝SVG を読んで繋ぐ。ここは【何でも入る】側）
   ⚠️ 凝らない。切り替えと尺だけ＝Premiere に近づけない（木下の指示）
   ═══════════════════════════════════════════════════════════ */
const P = { hold:12, fade:0, shape:1, fitMode:0, long:1280, fps:30, bg:'#0a0a0a' };
const clips = [];           // { type:'img'|'vid', el, name, url }
let sel = -1, playing = false, loop = true, t0 = 0, raf = 0;

const cv = document.getElementById('view');
const g  = cv.getContext('2d');

/* ── 版面 ── */
function frameSize(){
  const L = Math.round(P.long);
  if(P.shape === 0) return { w:L, h:L };
  if(P.shape === 2) return { w:L, h:Math.round(L*9/16) };
  return { w:Math.round(L*9/16), h:L };
}
function resize(){
  const f = frameSize();
  if(cv.width !== f.w || cv.height !== f.h){ cv.width = f.w; cv.height = f.h; }
  /* ⚠️ canvas の大きさは版面。画面に収めるのは CSS 側でやる（中身を触らない） */
  const st = document.getElementById('stage').getBoundingClientRect();
  const k = Math.min((st.width-24)/f.w, (st.height-24)/f.h);
  cv.style.width = Math.max(1, f.w*k) + 'px';
  cv.style.height = Math.max(1, f.h*k) + 'px';
  const n = document.getElementById('frameOut');
  if(n) n.innerHTML = `出る大きさ ＝ <b>${f.w} × ${f.h} px</b>`;
}
addEventListener('resize', resize);
visualViewport?.addEventListener('resize', resize);

/* ── 尺 ── */
/* ⭐ クリップごとの尺。⚠️ 個別に決めていなければ全体の「1枚の尺」を使う
   （前は全部同じだった＝木下がタイムラインを欲しがった理由のひとつ） */
/* ⭐⭐ トリム＝Karuma（kamera_tk）から持ってきた考え方。
   クリップは【素材のどこからどこまでを使うか】を in / out で持つ。
   ⚠️ 画像には素材の中の時間が無いので、in/out ではなく尺そのもの（dur）を持つ。
      ここを一緒くたにすると、画像の右端を引いたときに動画の式で壊れる。 */
const srcLen = c => c.type === 'vid' ? Math.max(0.1, c.el.duration || 2) : Infinity;
const inOf  = c => c.type === 'vid' ? (c.in || 0) : 0;
const outOf = c => c.type === 'vid' ? (c.out != null ? c.out : srcLen(c)) : 0;
const durOf = c => c.type === 'vid' ? Math.max(0.1, outOf(c) - inOf(c))
                                    : (c.dur != null ? c.dur : P.hold / 10);
const total = () => clips.reduce((s,c) => s + durOf(c), 0);
/* 音を含めた「タイムライン全体の長さ」＝映像と音の長い方。⭐ どこまで音が余っているかが見える */
const span  = () => Math.max(total(), sndBuf ? sndBuf.duration : 0, 1);
/* いま何秒目か（止まっている時も覚えておく＝ヘッドを掴んで動かせるように） */
let cur = 0;

/* ── 描く ── */
function drawOne(c, alpha){
  /* ⭐ 傾けている絵は、格子に割って貼り直す（遠近をつけるため）。
     ⚠️ 位置は【版面に対する割合】で持つ＝長辺を変えても書き出しても同じ絵になる */
  if(c.tilt){ drawTilt(c, alpha); return; }
  const el = c.el;
  const iw = c.type === 'vid' ? el.videoWidth : el.naturalWidth;
  const ih = c.type === 'vid' ? el.videoHeight : el.naturalHeight;
  if(!iw || !ih) return;
  /* ⭐ 収める＝全部入る／埋める＝版面いっぱい（はみ出しは切る） */
  const k = P.fitMode ? Math.max(cv.width/iw, cv.height/ih)
                      : Math.min(cv.width/iw, cv.height/ih);
  const w = iw*k, h = ih*k;
  g.globalAlpha = alpha;
  g.drawImage(el, (cv.width-w)/2, (cv.height-h)/2, w, h);
  g.globalAlpha = 1;
}
/* ══ 傾け TILT ═══════════════════════════════════════════
   ⭐ 1枚の絵を【増やさずに】回して奥へ倒す。完成した絵を壊さない＝置き方だけ変える。
   ⭐⭐ 遠近（台形の歪み）は canvas に直接は無いので、絵を細かい格子に割って
      1マスずつ三角形2枚で貼る＝【テクスチャを貼る】やり方で作る。
      ⚠️ 割りが粗いと歪みが折れ線になる。24分割で足りている。
   ⚠️ マス目の継ぎ目に髪の毛のような線が出るので、三角形を重心から少しだけ広げて貼る。 */
const TILT0 = { rz:-8, rx:24, ry:-18, ps:55, sc:80, x:0.5, y:0.5 };
const TILT_IDS = { tlRz:'rz', tlRx:'rx', tlRy:'ry', tlPs:'ps', tlSc:'sc' };

function tiltRead(){
  const t = {};
  Object.entries(TILT_IDS).forEach(([id,k]) => {
    const e = document.getElementById(id);
    t[k] = e ? +e.value : TILT0[k];
  });
  return t;
}
/* 絵の面の1点（u,v は -0.5〜0.5）を、回して倒して、遠近をかけて画面の座標にする */
function tiltProject(u, v, t, iw, ih){
  const W = cv.width, H = cv.height;
  const base = Math.min(W/iw, H/ih) * (t.sc/100);
  const rz = t.rz*Math.PI/180, rx = t.rx*Math.PI/180, ry = t.ry*Math.PI/180;
  let x = u*iw*base, y = v*ih*base, z = 0;
  const c1 = Math.cos(rz), s1 = Math.sin(rz);
  let X = x*c1 - y*s1, Y = x*s1 + y*c1, Z = z;
  const c2 = Math.cos(rx), s2 = Math.sin(rx);           // 上下に倒す
  let Y2 = Y*c2 - Z*s2, Z2 = Y*s2 + Z*c2;
  const c3 = Math.cos(ry), s3 = Math.sin(ry);           // 左右に倒す
  let X3 = X*c3 + Z2*s3, Z3 = -X*s3 + Z2*c3;
  /* ⭐ 奥ゆき0＝遠近なし（平面のまま傾くだけ）。上げるほど焦点が近づいて台形が強くなる */
  let k = 1;
  if(t.ps > 0){
    const f = Math.max(W,H) * (0.55 + (100 - t.ps)/100 * 6);
    k = f / Math.max(f*0.15, f - Z3);
  }
  return [ (t.x ?? 0.5)*W + X3*k, (t.y ?? 0.5)*H + Y2*k ];
}
/* 三角形1枚ぶん、元画像を貼る（アフィン変換を解いて置く） */
function tiltTri(img, s0,s1,s2, d0,d1,d2){
  /* 継ぎ目消し＝重心から 0.6px だけ外へ広げる */
  const cx = (d0[0]+d1[0]+d2[0])/3, cy = (d0[1]+d1[1]+d2[1])/3;
  const ex = pt => { const dx = pt[0]-cx, dy = pt[1]-cy, L = Math.hypot(dx,dy) || 1;
                     return [pt[0] + dx/L*0.6, pt[1] + dy/L*0.6]; };
  const e0 = ex(d0), e1 = ex(d1), e2 = ex(d2);
  g.save();
  g.beginPath(); g.moveTo(e0[0],e0[1]); g.lineTo(e1[0],e1[1]); g.lineTo(e2[0],e2[1]); g.closePath(); g.clip();
  const [x0,y0]=s0,[x1,y1]=s1,[x2,y2]=s2, [u0,v0]=d0,[u1,v1]=d1,[u2,v2]=d2;
  const det = (x1-x0)*(y2-y0) - (x2-x0)*(y1-y0);
  if(det){
    const a = ((u1-u0)*(y2-y0) - (u2-u0)*(y1-y0)) / det;
    const b = ((u2-u0)*(x1-x0) - (u1-u0)*(x2-x0)) / det;
    const c = ((v1-v0)*(y2-y0) - (v2-v0)*(y1-y0)) / det;
    const d = ((v2-v0)*(x1-x0) - (v1-v0)*(x2-x0)) / det;
    g.transform(a, c, b, d, u0 - a*x0 - b*y0, v0 - c*x0 - d*y0);
    g.drawImage(img, 0, 0);
  }
  g.restore();
}
function drawTilt(c, alpha){
  const el = c.el;
  const iw = el.naturalWidth || el.videoWidth, ih = el.naturalHeight || el.videoHeight;
  if(!iw || !ih) return;
  const t = c.tilt, N = 24;
  const pts = [];
  for(let j = 0; j <= N; j++){
    const row = [];
    for(let i = 0; i <= N; i++) row.push(tiltProject(i/N - 0.5, j/N - 0.5, t, iw, ih));
    pts.push(row);
  }
  g.globalAlpha = alpha;
  for(let j = 0; j < N; j++) for(let i = 0; i < N; i++){
    const su = i/N*iw, sv = j/N*ih, su2 = (i+1)/N*iw, sv2 = (j+1)/N*ih;
    const p00 = pts[j][i], p10 = pts[j][i+1], p01 = pts[j+1][i], p11 = pts[j+1][i+1];
    tiltTri(el, [su,sv],[su2,sv],[su,sv2],  p00,p10,p01);
    tiltTri(el, [su2,sv],[su2,sv2],[su,sv2], p10,p11,p01);
  }
  g.globalAlpha = 1;
}

function tiltNote(){
  const n = document.getElementById('tlNote'), b = document.getElementById('bTilt');
  const c = clips[sel], on = !!(c && c.tilt);
  document.body.classList.toggle('has-tilt', on);
  if(b){ b.classList.toggle('on', on); b.textContent = on ? '傾けをやめる' : '傾ける'; }
  if(!n) return;
  n.innerHTML = on ? '傾けている。<b>ステージの上でドラッグして動かせる</b>'
    : (clips.length ? 'クリップを選んで押す' : '素材を入れてから押す');
}
document.getElementById('bTilt').onclick = () => {
  let c = clips[sel];
  if(c && c.tilt){ c.tilt = null; tiltNote(); if(!playing) frameAt(cur); return; }
  if(!c){ if(!clips.length){ tiltNote(); return; } sel = 0; c = clips[0]; buildClips(); }
  const t = tiltRead(); t.x = 0.5; t.y = 0.5;
  c.tilt = t; tiltNote(); if(!playing) frameAt(cur);
};
document.getElementById('bTiltReset').onclick = () => {
  const c = clips[sel]; if(!c || !c.tilt) return;
  Object.entries(TILT_IDS).forEach(([id,k]) => {
    const e = document.getElementById(id); if(!e) return;
    e.value = (k === 'sc') ? 100 : 0;
    const v = e.parentElement.querySelector('.val'); if(v) v.textContent = e.value;
  });
  Object.assign(c.tilt, tiltRead(), { x:0.5, y:0.5 });
  if(!playing) frameAt(cur);
};
Object.keys(TILT_IDS).forEach(id => {
  const r = document.getElementById(id); if(!r) return;
  const v = r.parentElement.querySelector('.val');
  const sync = () => { if(v) v.textContent = r.value; };
  r.addEventListener('input', () => {
    sync();
    const c = clips[sel];
    if(c && c.tilt){ Object.assign(c.tilt, tiltRead()); if(!playing) frameAt(cur); }
  });
  sync();
});
/* ⭐ ステージの上でドラッグして位置を動かす。
   ⚠️ canvas は縮めて表示しているので、クリック座標を版面の割合に直してから使う */
cv.addEventListener('pointerdown', e => {
  const c = clips[sel];
  if(!c || !c.tilt) return;
  e.preventDefault();
  const r = cv.getBoundingClientRect();
  const ox = c.tilt.x - (e.clientX - r.left) / r.width;
  const oy = c.tilt.y - (e.clientY - r.top)  / r.height;
  const move = e2 => {
    c.tilt.x = (e2.clientX - r.left) / r.width + ox;
    c.tilt.y = (e2.clientY - r.top)  / r.height + oy;
    if(!playing) frameAt(cur);
  };
  const up = () => { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
  addEventListener('pointermove', move); addEventListener('pointerup', up);
});
cv.style.touchAction = 'none';

function frameAt(t){
  g.fillStyle = P.bg; g.fillRect(0,0,cv.width,cv.height);
  if(!clips.length) return;
  let acc = 0, i = 0;
  for(; i < clips.length; i++){
    const d = durOf(clips[i]);
    if(t < acc + d) break;
    acc += d;
  }
  if(i >= clips.length) i = clips.length - 1;
  const c = clips[i], local = t - acc, d = durOf(c);
  if(c.type === 'vid'){
    /* ⚠️ 動画は「いま何秒目か」を自分で合わせる（再生任せにすると繋ぎでずれる）
       ⭐ トリムしているので【素材の中の時刻＝in + local】を見る */
    const want = inOf(c) + Math.min(local, d - 0.02);
    if(Math.abs(c.el.currentTime - want) > 0.12) c.el.currentTime = want;
  }
  const fade = P.fade / 10;
  if(fade > 0 && i < clips.length-1 && local > d - fade){
    const u = (local - (d - fade)) / fade;
    drawOne(c, 1);
    const nx = clips[i+1];
    if(nx.type === 'vid' && Math.abs(nx.el.currentTime - inOf(nx)) > 0.12) nx.el.currentTime = inOf(nx);
    drawOne(nx, u);
  }else{
    drawOne(c, 1);
  }
}
function tick(){
  raf = requestAnimationFrame(tick);
  if(!playing) return;
  const T = total();
  if(T <= 0) return;
  let t = (performance.now() - t0) / 1000;
  if(t >= T){
    if(loop){ t0 = performance.now(); t = 0; }
    else { playing = false; document.getElementById('bPlay').textContent = '▶ 再生'; t = T - 0.001; }
  }
  cur = t;
  frameAt(t);
  setHead(t);          /* ⭐ 再生ヘッドが全レーンを貫いて動く */
}
requestAnimationFrame(tick);

/* ── 素材 ── */
function addFiles(list){
  /* ⭐ 落としたものを【種類で振り分ける】。木下＝「画像や音源はドラッグで入れれるように」。
     🔴 前は image/video だけ通していたので、音源を落としても【黙って捨てられていた】。 */
  const all = [...list];
  const au = all.find(f => f.type.startsWith('audio/'));
  if(au) loadSound(au);
  const files = all.filter(f => f.type.startsWith('image/') || f.type.startsWith('video/'));
  let left = files.length;
  if(!left){ if(au) afterAdd(); return; }
  files.forEach(f => {
    const url = URL.createObjectURL(f);
    if(f.type.startsWith('video/')){
      const v = document.createElement('video');
      v.src = url; v.muted = true; v.playsInline = true; v.preload = 'auto';
      v.onloadedmetadata = () => { clips.push({ type:'vid', el:v, name:f.name, url }); if(!--left) afterAdd(); };
      v.onerror = () => { if(!--left) afterAdd(); };
    }else{
      const im = new Image();
      im.onload = () => { clips.push({ type:'img', el:im, name:f.name, url }); if(!--left) afterAdd(); };
      im.onerror = () => { if(!--left) afterAdd(); };
      im.src = url;
    }
  });
}
function afterAdd(){ layout(); if(!playing) frameAt(cur); note(); }
function note(){
  const n = document.getElementById('srcNote');
  if(n) n.innerHTML = clips.length ? `${clips.length}本 ／ 全体 <b>${total().toFixed(1)}秒</b>` : '';
}
/* ══ タイムライン ═════════════════════════════════════════
   ⭐⭐ 下に固定した【1本の時間軸】。映像レーンと音レーンが同じ尺で並び、
      再生ヘッドが両方を貫く（木下 2026-08-02＝「Premiere と同じ思想でいこう」）。
   🔴 前は「クリップの四角」と「尺の帯」が右パネルに別々にあり、時間軸が繋がっていなかった。
   ⭐ トリム（左右で素材のどこを使うか）と分割は Karuma（kamera_tk）から考え方を持ってきた。 */
const lanesEl  = document.getElementById('lanes');
const contEl   = document.getElementById('tlcontent');
const rulerEl  = document.getElementById('ruler');
const clipLane = document.getElementById('clipLane');
const sndLane  = document.getElementById('sndLane');
const headEl   = document.getElementById('playhead');
let zoom = 1;
const GUT = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--gut')) || 56;

/* ⭐ 1秒が何px か。拡大1x＝【全体がちょうど収まる】を基準にする＝開いた瞬間に全部見える */
function pps(){
  const avail = Math.max(120, lanesEl.clientWidth - GUT() - 32);
  return avail / span() * zoom;
}
function fmt(t){ return t.toFixed(1); }
function setHead(t){
  headEl.style.left = (GUT() + t * pps()) + 'px';
  const cl = document.getElementById('tclock');
  if(cl) cl.textContent = fmt(t) + ' / ' + fmt(total()) + 's';
}
/* 目盛り。⭐ 1目盛りが50px以上になる刻みを選ぶ＝拡大しても混まない */
function buildRuler(){
  rulerEl.innerHTML = '';
  const p = pps(), S = span();
  const step = [0.5,1,2,5,10,15,30,60,120,300].find(v => v * p >= 50) || 600;
  for(let t = 0; t <= S + 1e-6; t += step){
    const x = t * p;
    const sp = document.createElement('span'); sp.style.left = x + 'px';
    sp.textContent = step < 1 ? t.toFixed(1) : String(Math.round(t)); rulerEl.append(sp);
    const ti = document.createElement('i'); ti.style.left = x + 'px'; rulerEl.append(ti);
  }
}
function layout(){
  contEl.style.width = (GUT() + span() * pps() + 16) + 'px';
  buildRuler(); buildClips(); drawWave(); setHead(cur);
  const z = document.getElementById('zLbl');
  if(z) z.textContent = (zoom < 10 ? zoom.toFixed(1).replace(/\.0$/,'') : String(Math.round(zoom))) + 'x';
}
addEventListener('resize', layout);

function buildClips(){
  clipLane.innerHTML = '';
  clipLane.classList.toggle('empty', !clips.length);
  const p = pps();
  let acc = 0;
  clips.forEach((c, i) => {
    const d = durOf(c);
    const el = document.createElement('div');
    el.className = 'clipseg' + (i === sel ? ' sel' : '');
    el.style.left = (acc * p) + 'px';
    el.style.width = Math.max(12, d * p) + 'px';
    el.draggable = true;
    const th = c.type === 'vid' ? document.createElement('video') : document.createElement('img');
    th.src = c.url; if(c.type === 'vid'){ th.muted = true; th.playsInline = true; }
    el.append(th);
    const n = document.createElement('span'); n.className = 'n'; n.textContent = i+1; el.append(n);
    const tt = document.createElement('span'); tt.className = 't'; tt.textContent = d.toFixed(1)+'s'; el.append(tt);
    const x = document.createElement('button'); x.className = 'x'; x.textContent = '×';
    x.onclick = e => { e.stopPropagation(); clips.splice(i,1); sel = -1; afterAdd(); };
    el.append(x);
    el.onclick = e => { e.stopPropagation(); sel = i; buildClips(); if(typeof tiltNote === 'function') tiltNote(); };
    /* 並び替え＝掴んで入れ替えるだけ（凝らない） */
    el.ondragstart = e => e.dataTransfer.setData('text/plain', String(i));
    el.ondragover  = e => e.preventDefault();
    el.ondrop = e => {
      e.preventDefault(); e.stopPropagation();
      const from = +e.dataTransfer.getData('text/plain');
      if(isNaN(from) || from === i) return;
      const [m] = clips.splice(from,1); clips.splice(i,0,m);
      sel = i; afterAdd();
    };
    /* ⭐ 端を掴んで伸縮。⚠️ 動画は【素材のどこまで使うか(out)】／画像は【尺そのもの】＝式が違う */
    const grab = (side) => ev => {
      ev.stopPropagation(); ev.preventDefault();
      const x0 = ev.clientX, pp = pps();
      const in0 = inOf(c), out0 = outOf(c), d0 = d;
      const move = e2 => {
        const dt = (e2.clientX - x0) / pp;
        if(c.type === 'vid'){
          if(side === 'l') c.in  = Math.max(0, Math.min(out0 - 0.1, in0 + dt));
          else             c.out = Math.min(srcLen(c), Math.max(in0 + 0.1, out0 + dt));
        }else{
          c.dur = Math.max(0.2, Math.round((d0 + (side === 'l' ? -dt : dt)) * 10) / 10);
        }
        layout(); note(); if(!playing) frameAt(cur);
      };
      const up = () => { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
      addEventListener('pointermove', move); addEventListener('pointerup', up);
    };
    /* ⚠️ 左のトリムは動画だけ（画像は素材の中に時間が無い） */
    if(c.type === 'vid'){
      const hl = document.createElement('div'); hl.className = 'h l';
      hl.onpointerdown = grab('l'); el.append(hl);
    }
    const hr = document.createElement('div'); hr.className = 'h'; hr.onpointerdown = grab('r'); el.append(hr);
    acc += d;
    clipLane.append(el);
  });
}

/* ⭐ 分割＝再生ヘッドの所で2つに切る（Karuma の splitClip と同じ考え方）。
   ⚠️ 端すぎる所では切らない＝長さ0のクリップを作らない */
function splitAt(t){
  if(!clips.length) return;
  let acc = 0, i = 0;
  for(; i < clips.length; i++){ const d = durOf(clips[i]); if(t < acc + d) break; acc += d; }
  if(i >= clips.length) return;
  const c = clips[i], local = t - acc, d = durOf(c);
  if(local < 0.1 || local > d - 0.1) return;
  if(c.type === 'vid'){
    const cut = inOf(c) + local;
    const v = document.createElement('video');
    v.src = c.url; v.muted = true; v.playsInline = true; v.preload = 'auto';
    clips.splice(i+1, 0, { type:'vid', el:v, name:c.name, url:c.url, in:cut, out:outOf(c) });
    c.out = cut;
  }else{
    const im = new Image(); im.src = c.url;
    clips.splice(i+1, 0, { type:'img', el:im, name:c.name, url:c.url, dur:Math.round((d-local)*10)/10 });
    c.dur = Math.round(local*10)/10;
  }
  sel = i + 1; afterAdd();
}

/* ── ヘッドを動かす（目盛り・レーンをクリック／掴んでスクラブ）── */
function seekTo(t){
  const S = span();
  cur = Math.max(0, Math.min(S, t));
  if(playing) t0 = performance.now() - cur * 1000;
  frameAt(cur); setHead(cur);
}
function tFromEvent(e){
  const r = contEl.getBoundingClientRect();
  return (e.clientX - r.left - GUT()) / pps();
}
function scrub(e){
  e.preventDefault();
  seekTo(tFromEvent(e));
  const move = e2 => seekTo(tFromEvent(e2));
  const up = () => { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
  addEventListener('pointermove', move); addEventListener('pointerup', up);
}
rulerEl.addEventListener('pointerdown', scrub);
document.getElementById('phgrab').addEventListener('pointerdown', e => { e.stopPropagation(); scrub(e); });
/* ⚠️ レーンの地（クリップの無い所）を押したときもシークする。クリップ自体は選択が優先 */
[clipLane, sndLane].forEach(el => el.addEventListener('pointerdown', e => { if(e.target === el) scrub(e); }));

document.getElementById('zIn').onclick  = () => { zoom = Math.min(24, zoom * 1.6); layout(); };
document.getElementById('zOut').onclick = () => { zoom = Math.max(1, zoom / 1.6); layout(); };
