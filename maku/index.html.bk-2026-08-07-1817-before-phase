/* ══ 刷り（字のインク）══ 見えが「刷り」のときだけ字の色を出す。
   ⚠️ 密度は縞（金属・線）のつまみ＝墨と刷りでは何も起きないので同時に畳む。 */
function syncInk(){
  const metal = P.look === 0;
  /* ⭐ 見ている色数は「いま何を刷っているか」で変わる＝金属なら縞の色数・刷りなら字の色数。
     ⚠️ 色も色数も【選んでいる版】の持ち物（2026-08-07）。 */
  const sh = S_();
  const inkN   = (sh && sh.inkN   != null) ? sh.inkN   : 3;
  const stInkN = (sh && sh.stInkN != null) ? sh.stInkN : 1;
  const n = Math.max(1, Math.round(metal ? stInkN : inkN));
  document.body.classList.toggle('look-ink', P.look === 3);
  document.body.classList.toggle('look-stripe', metal || P.look === 2);
  document.body.classList.toggle('look-metal', metal);
  // 色見本は【刷り】と【縞に色をつけたとき】に出す
  document.body.classList.toggle('look-color', P.look === 3 || (metal && stInkN >= 2));
  for(let k=2;k<=6;k++) document.body.classList.toggle('ink-'+k, n >= k);
}
/* ══ 色のプリセット ══ 粒 TSUBU と同じ色群を持ってきた＝道具のあいだで色が揃う。
   ⚠️ 変えるのは【字の色】だけ。地（紙）は別に持つので、押しても地は動かない
      （同じ色を字と地に入れると字が地に沈む）。
   ⚠️ 色数は変えない＝いま出している絵の構造を勝手に変えない。
      色数1のままだと白黒なので、色数を上げてから押す。 */
const PALS = [
  { name:'墨',     ink:['#0a0a0a','#4a4a46','#8f8d86','#c9c6bd','#f4f2ee','#ffffff'] },
  { name:'琵琶湖', ink:['#0d1417','#1b3a42','#2f6b6b','#7fae9e','#dfe7e2','#ffffff'] },
  { name:'熱',     ink:['#0d0000','#ff3c00','#ff7a00','#ffb400','#ffe64d','#fff7cc'] },
  { name:'赤青',   ink:['#000010','#e01e14','#ff5a3c','#5a4cff','#2020e0','#ffffff'] },
  { name:'奇抜',   ink:['#ff2d6f','#ffd400','#00e5ff','#7cff3f','#8a2be2','#ffffff'] },
  { name:'毒',     ink:['#001005','#7cff3f','#00e5a0','#40b0ff','#9628ff','#ffffff'] },
];
function applyPal(i){
  const p = PALS[i]; if(!p) return;
  const sh = S_(); if(!sh) return;
  sh.inkc = p.ink.slice();                 // ⭐ 色は版の持ち物＝選んでいる版だけ変わる
  syncInkUI();
  syncInk();
}
/* ⭐ 色見本と色数のつまみを【選んでいる版】の値に合わせる（版を押したら入れ替わる） */
function syncInkUI(){
  const sh = S_(); if(!sh) return;
