/* ⭐ 画像は【新しい版】として足す。字の版はそのまま残る＝重ねられる */
function addImageSheet(img){
  const s = inheritWarp(newSheet('image'));         // ⭐ 歪みは今の版から受け継ぐ
  s.img = img; s.asp = img.width / img.height;
  gl.bindTexture(gl.TEXTURE_2D, s.tex);
  gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);     // ⚠️ canvas と WebGL で上下が逆
