  s.chars = []; s.ctype = [];
  cells.forEach(({ch,col,row})=>{ const gi = row*cols + col; s.chars.push({ ch, gi }); s.ctype[gi] = classify(ch); });
  const keep = (s.cscale||[]).slice(), keepR = (s.crot||[]).slice();
  s.cscale = []; s.crot = [];
  for(let i=0;i<Math.min(cols*rows,32);i++){ s.cscale.push(keep[i] || [1,1]); s.crot.push(keepR[i] || 0); }
  selChar = -1;
  // 字間・行間＝セルの寸法そのものを伸縮する（字の大きさは変えない）
  // 横組みは 字間→横／行間→縦、縦組みは逆にかかる
  const tk = s.track/100, ld = s.leading/100;
  const cw = S * (1 + (s.dir === 0 ? tk : ld));    // セル幅
  const chh= S * (1 + (s.dir === 0 ? ld : tk));    // セル高
  tc.width  = Math.max(Math.round(cols * cw), 8);
  tc.height = Math.max(Math.round(rows * chh), 8);
  tg.fillStyle = '#000'; tg.fillRect(0,0,tc.width,tc.height);
  tg.fillStyle = '#fff';
  tg.textAlign = 'center'; tg.textBaseline = 'middle';
  const fam = s.font ? '"Zen Old Mincho"' : '"Zen Kaku Gothic New"';
  tg.font = `900 ${S*0.86}px ${fam}, sans-serif`;
  cells.forEach(({ch,col,row}) => tg.fillText(ch, col*cw + cw/2, row*chh + chh/2 + S*0.02));
  s.asp = tc.width / tc.height;
