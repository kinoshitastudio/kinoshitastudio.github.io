/* ══ 控え（保存・読み込み）＋ 戻す（⌘Z）══════════════════════════
   ⭐ 道具の状態はコミットでは守れない。【戻す】と【持ち出す】は道具の側に要る。
   ⚠️ 戻す用のスナップショットに画像は入れない（重いうえ、戻しても画像そのものは変わらないから）。
      保存する JSON には入れる＝そのまま開き直せる。 */
const stat = m => { const s = document.getElementById('stat'); if(s) s.textContent = m; };
/* ⭐ 版1枚ぶんを控えにする。⚠️ 画像は重いので、戻す用（withImage=false）には入れない
   ── そのぶんは Image オブジェクトを別に持ち回して引き継ぐ。 */
function sheetToJSON(s, withImage){
  const o = { kind:s.kind, text:s.text, font:s.font, dir:s.dir, track:s.track, leading:s.leading,
              x:s.x, y:s.y, scale:s.scale, rot:s.rot, asp:s.asp,
              cscale:(s.cscale||[]).map(a=>[a[0], a[1]]), crot:[...(s.crot||[])],
              /* ⭐ 歪みと色は版の持ち物＝控えも版の中に入る（2026-08-06／07） */
              warp:{ ...(s.warp || WARP_DEF) }, layers:(s.layers || newLayers()).map(L=>({ ...L })),
              inkc:[...(s.inkc || INKC_DEF)], inkN:(s.inkN != null ? s.inkN : 3),
              stInkN:(s.stInkN != null ? s.stInkN : 1) };
  if(withImage && s.kind === 'image' && s.img){
    const c = document.createElement('canvas');
    c.width  = s.img.naturalWidth  || s.img.width;
    c.height = s.img.naturalHeight || s.img.height;
    c.getContext('2d').drawImage(s.img, 0, 0);
    o.image = c.toDataURL('image/png');   // ⚠️ PNG＝透明を保つ（JPEG にすると透明が黒くなる）
  }
  return o;
}
function stateToJSON(withImage){
  return {
    /* v3＝歪み（ワープ・辺ごと・3層）が版の中に入った形。v2 以前は面にひとつだった＝読むときに全版へ配る */
    v: 3,
    P: { ...P },
    PAPC: [...PAPC],
    ANCHORS: ANCHORS.map(a=>({ ...a })),
    VIEW: { ...VIEW },
    cur: curSheet,
    sheets: SHEETS.map(s=>sheetToJSON(s, withImage)),
  };
}
/* 画像を版のテクスチャに載せる（読み込みと控えの復元で同じ道を通す） */
function uploadImg(s, img){
  s.img = img; s.asp = img.width / img.height;
  gl.bindTexture(gl.TEXTURE_2D, s.tex);
  gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
}
function applyState(o, done, imgs){
  if(!o) return;
  Object.assign(P, o.P || {});
  /* ⚠️ 古い控え（v2まで）は歪みが P の中にある。⭐ 版に配ったうえで P からは落とす
     ＝「歪みは版の持ち物」という規則をひとつに保つ（P と版の二重管理をしない）。 */
  const oldWarp = {};
  WARP_KEYS.forEach(k=>{ if(P[k] !== undefined){ oldWarp[k] = P[k]; delete P[k]; } });
  const oldLayers = o.LAYERS ? o.LAYERS.map(L=>({ ...L })) : null;
  /* ⚠️ 古い控えは字の色が面にひとつ（o.INKC / P.inkN / P.stInkN）。版に配ってから P から落とす。 */
  const oldInk    = o.INKC ? [...o.INKC] : INKC_DEF.slice();
  const oldInkN   = (P.inkN   != null) ? P.inkN   : 3;
  const oldStInkN = (P.stInkN != null) ? P.stInkN : 1;
  delete P.inkN; delete P.stInkN;
  if(o.PAPC) PAPC = [...o.PAPC];
  ANCHORS.length = 0; (o.ANCHORS||[]).forEach(a=>ANCHORS.push({ ...a }));
  Object.assign(VIEW, o.VIEW || {});
  // つまみ・切替・色の見た目を実体に合わせる（数字と実体をズラさない）
  document.querySelectorAll('#panel input[type=range]').forEach(r=>{
    if(r.id.startsWith('L_')) return;                 // 層のつまみは syncLayerUI で入れ直す
    if(WARP_KEYS.indexOf(r.id) >= 0) return;          // ワープ・辺ごとは syncWarpUI で入れ直す（版の持ち物）
    if(r.id === 'grain') return;                      // 粒は syncGrainUI で入れ直す
    if(P[r.id] !== undefined) r.value = P[r.id];
    const v = r.parentElement.querySelector('.val'); if(v) v.textContent = r.value;
  });
  document.querySelectorAll('#panel .seg').forEach(seg=>{
    seg.querySelectorAll('button').forEach(b=>{
      if(b.dataset.v === undefined) return;
      b.classList.toggle('on', +b.dataset.v === P[seg.id]);
    });
  });
  document.querySelectorAll('input[type=color][data-pc]').forEach(c=>{ if(PAPC[+c.dataset.pc]) c.value = PAPC[+c.dataset.pc]; });
  selChar = -1;
  syncLayerUI(); syncGrad(); syncInk(); syncViewUI(); syncGrainUI(); buildMesh(); layoutCanvas();

  /* ⭐ 版を作り直す。⚠️ 古い控え（v1＝版が無かった頃）も読めるようにしておく */
  const list = o.sheets || [{
    kind: o.img ? 'image' : 'text', text: o.text, font: (o.P&&o.P.font)||0, dir: (o.P&&o.P.dir)||0,
    track: (o.P&&o.P.track)||0, leading: (o.P&&o.P.leading)||0,
    x:0, y:0, scale:1, rot:0, cscale:o.cscale, crot:o.crot, image:o.image,
  }];
  SHEETS.forEach(s=>{ if(s.tex) gl.deleteTexture(s.tex); });
  SHEETS = [];
  let pending = 0, called = false;
  const finish = ()=>{
    if(pending > 0 || called) return;
    called = true;
    curSheet = Math.max(0, Math.min(o.cur||0, SHEETS.length-1));
    if(!o.sheets) fitFirstSheet();                   // ⚠️ 古い控えは面の規則が違うので合わせ直す
    refreshSheets();
    if(typeof done === 'function') done();
  };
  list.forEach((d, i)=>{
    const s = newSheet(d.kind || 'text', d.text);
    Object.assign(s, {
      font:d.font||0, dir:d.dir||0, track:d.track||0, leading:d.leading||0,
      x:d.x||0, y:d.y||0, scale:(d.scale != null ? d.scale : 1), rot:d.rot||0,
      cscale:(d.cscale||[]).map(a=>[a[0], a[1]]), crot:[...(d.crot||[])],
    });
    /* ⭐ 色：新しい控えは版の中から。古い控えは【面にひとつだった色】を全版に配る
       ＝開き直しても見え方が変わらない。 */
    s.inkc   = [...(d.inkc || oldInk)];
    s.inkN   = (d.inkN   != null) ? d.inkN   : oldInkN;
    s.stInkN = (d.stInkN != null) ? d.stInkN : oldStInkN;
    /* ⭐ 歪み：新しい控え（v3）は版の中から。古い控えは【面にひとつだった値】を全版に配る
       ＝開き直しても見え方が変わらない。以降は版ごとに別々に動かせる。 */
    s.warp   = { ...WARP_DEF, ...oldWarp, ...(d.warp || {}) };
    s.layers = d.layers ? d.layers.map(L=>({ ...L }))
             : (oldLayers ? oldLayers.map(L=>({ ...L })) : newLayers());
    SHEETS.push(s);
    if((d.kind||'text') === 'image'){
      const keep = imgs && imgs[i];
      if(d.image){
        pending++;
        const img = new Image();
        img.onload  = ()=>{ uploadImg(s, img); pending--; finish(); };
        img.onerror = ()=>{ pending--; finish(); };
        img.src = d.image;
      } else if(keep){ uploadImg(s, keep); }         // ⭐ 戻す（⌘Z）では画像そのものを引き継ぐ
      else if(d.asp) s.asp = d.asp;
    } else {
      bakeSheet(s);
    }
  });
  finish();
}
async function saveJSON(){
  const data = JSON.stringify(stateToJSON(true));
  const name = `maku_${Date.now()}.json`;
  try{
    if(window.showSaveFilePicker){
      const h = await showSaveFilePicker({ suggestedName:name,
        types:[{ description:'膜 MAKU の控え', accept:{ 'application/json':['.json'] } }] });
      const w = await h.createWritable(); await w.write(data); await w.close();
      stat('控えを保存した'); return;
    }
  }catch(err){ if(err && err.name === 'AbortError') return; }   // ⚠️ キャンセルは失敗ではない
  const blob = new Blob([data], { type:'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 8000);
  stat('控えを保存した');
}
function loadJSONFile(f){
  if(!f) return;
  const rd = new FileReader();
  rd.onload = ()=>{
    try{ snap(); applyState(JSON.parse(rd.result), ()=>stat('控えを読み込んだ')); }
    catch(err){ stat('この JSON は読めなかった'); }
  };
  rd.readAsText(f);
}
document.getElementById('saveJson').onclick = saveJSON;
document.getElementById('loadJson').onclick = ()=> document.getElementById('jsonFile').click();
document.getElementById('jsonFile').addEventListener('change', e=>{
  loadJSONFile(e.target.files[0]); e.target.value = '';
});

/* ── 戻す／やり直す ── */
const UNDO = [], REDO = [];
/* ⚠️ 控えの JSON には画像を入れない（重い）ので、戻すときのために
   Image オブジェクトそのものを一緒に持ち回す。 */
function snapObj(){ return { j: JSON.stringify(stateToJSON(false)), imgs: SHEETS.map(s=>s.img||null) }; }
function snap(){
  const o = snapObj();
  if(UNDO.length && UNDO[UNDO.length-1].j === o.j) return;   // 変わっていないなら積まない
  UNDO.push(o); if(UNDO.length > 40) UNDO.shift();
  REDO.length = 0;
}
let lastSnap = 0;
function snapThrottled(){                                 // 打ち込み中に積み過ぎない
  const n = performance.now(); if(n - lastSnap < 600) return; lastSnap = n; snap();
}
function undo(){
  if(!UNDO.length){ stat('これ以上は戻れない'); return; }
  REDO.push(snapObj());
  const o = UNDO.pop();
  applyState(JSON.parse(o.j), ()=>stat('戻した'), o.imgs);
}
function redo(){
  if(!REDO.length){ stat('やり直すものが無い'); return; }
  UNDO.push(snapObj());
  const o = REDO.pop();
  applyState(JSON.parse(o.j), ()=>stat('やり直した'), o.imgs);
}
/* ⚠️ スナップショットは【操作の直前】に取る。capture フェーズで拾えば、
   実際の処理より先に必ず走る（＝押した瞬間の状態が残る）。 */
document.getElementById('panel').addEventListener('pointerdown', e=>{
  if(e.target.closest('button, input[type=range], input[type=color]')) snap();
}, true);
document.getElementById('panel').addEventListener('keydown', e=>{
  /* 🔴 ⌘/Ctrl つきのキーでは積まない。つまみにフォーカスがあるまま ⌘Z を押すと、
     ここで【いまの状態】が積まれ、そのすぐ後の undo がそれを取り出す＝何も戻らない
     （HUD だけ「戻した」と出る。2026-08-07 木下「コマンドzが効かない」の正体）。 */
  if(e.metaKey || e.ctrlKey) return;
  if(e.target.matches('input[type=range]')) snap();
}, true);
canvas.addEventListener('pointerdown', snap, true);       // アンカーを置く/引っぱる前
document.getElementById('txt').addEventListener('beforeinput', snapThrottled);
window.addEventListener('keydown', e=>{
  if(!(e.metaKey || e.ctrlKey) || (e.key||'').toLowerCase() !== 'z') return;
  /* ⚠️ 打ち込み欄の中は、ブラウザの取り消しに任せる（横取りすると文字が戻せなくなる）。
     🔴 ただし【文字を打つ欄だけ】。つまみ（input[type=range]）や色見本まで除くと、
        つまみを触った直後はそこにフォーカスが残っているので ⌘Z が丸ごと効かなくなる
        （2026-08-07 木下「コマンドzとかキーはできるようにしておいて」）。 */
  if(isTyping(e.target)) return;
  e.preventDefault();
  if(e.shiftKey) redo(); else undo();
});

function resize(){ const dpr=Math.min(devicePixelRatio,2);
  // 描画バッファは canvas の実表示サイズ（CSSの二分割）に合わせる＝歪み/座標ズレを防ぐ
  canvas.width  = Math.round((canvas.clientWidth  || innerWidth ) * dpr);
  canvas.height = Math.round((canvas.clientHeight || innerHeight) * dpr); }
addEventListener('resize', ()=>layoutCanvas());
addEventListener('orientationchange', ()=>setTimeout(layoutCanvas,120));

