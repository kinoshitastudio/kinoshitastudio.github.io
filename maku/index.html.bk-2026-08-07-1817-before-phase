  });
  document.querySelectorAll('#panel .seg').forEach(seg=>{
    seg.querySelectorAll('button').forEach(b=>b.classList.toggle('on', +b.dataset.v === P[seg.id]));
  });
  syncLayerUI(); syncWarpUI(); syncGrainUI(); syncInkUI();
  syncGrad(); syncInk();                            // 地は色数1（単色）に戻る。⚠️選んだ色は残す
  P.fitz = 100; P.fitx = 0; P.fity = 0; syncViewUI();   // 絵の大きさ・位置も戻す（VIEW を戻したので合わせる）
  buildMesh();
