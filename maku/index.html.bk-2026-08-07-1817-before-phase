    cols = Math.max(...lines.map(l=>[...l].length), 1);
    rows = lines.length;
    lines.forEach((line,r)=>{ [...line].forEach((ch,c)=> cells.push({ch, col:c, row:r})); });
  } else {                                         // 縦組み：字が上→下、行が右→左
    rows = Math.max(...lines.map(l=>[...l].length), 1);
    cols = lines.length;
    lines.forEach((line,li)=>{ const col = cols-1-li; [...line].forEach((ch,ci)=> cells.push({ch, col, row:ci})); });
  }
  s.cols = cols; s.rows = rows;
  const tkS = 1 + Math.max(0, s.track/100), ldS = 1 + Math.max(0, s.leading/100);
