function syncSheetUI(){
  const s = S_(); if(!s) return;
  document.body.classList.toggle('sheet-image', s.kind === 'image');
  const set = (id,v)=>{ const el=document.getElementById(id); if(!el) return;
    el.value = v; const t = el.parentElement.querySelector('.val'); if(t) t.textContent = el.value; };
  set('sx', s.x); set('sy', s.y); set('ss', Math.round(s.scale*100)); set('sr', s.rot);
  /* ⭐ 歪み（ワープ・辺ごと・3層）と色も版の持ち物＝版を押したらつまみをその版の値に入れ替える */
  syncWarpUI(); syncLayerUI(); syncInkUI(); syncInk();
  if(s.kind === 'text'){
    document.getElementById('txt').value = s.text;
    set('track', s.track); set('leading', s.leading);
