function syncGrabUI(){
  const sh = S_(); if(!sh) return;
  [['sx', sh.x], ['sy', sh.y]].forEach(([id, v])=>{
    const el = document.getElementById(id); if(!el) return;
    el.value = Math.max(+el.min, Math.min(+el.max, v));
    const t = el.parentElement.querySelector('.val'); if(t) t.textContent = v;
  });
