  SHEETS.push(s); curSheet = SHEETS.length-1; selChar = -1;
  refreshSheets();
  const st = document.getElementById('stat');
  if(st) st.textContent = `IMAGE ${img.width}×${img.height}`;
}
function loadImageFile(f){
