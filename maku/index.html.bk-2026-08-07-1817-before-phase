/* ⭐ この版を複製 ── 【別レイヤー】として増やす（重なった状態で増える＝Figma の ⌘D と同じ考え）。
   🔴 テクスチャは必ず新しく作る。使い回すと「この版を消す」の deleteTexture で
      片方を消したときに、残った双子の絵まで白く飛ぶ。 */
document.getElementById('dupSheet').onclick = ()=>{
  const src = SHEETS[curSheet]; if(!src) return;
  const s = newSheet(src.kind, src.text);
  Object.assign(s, {
    font:src.font, dir:src.dir, track:src.track, leading:src.leading,
    x:src.x, y:src.y, scale:src.scale, rot:src.rot, asp:src.asp, img:src.img,
    cscale:(src.cscale||[]).map(a=>[a[0], a[1]]), crot:[...(src.crot||[])],
  });
  inheritWarp(s, src);          // ⭐ 歪み（ワープ・辺ごと・3層）もそのまま複製＝重なって同じ形で出る
  if(src.kind === 'image' && src.img){
    gl.bindTexture(gl.TEXTURE_2D, s.tex);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);   // ⚠️ 画像の版と同じ手順で焼き直す
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, src.img);
  } else {
    bakeSheet(s);                                    // 字の版はテクスチャを焼き直す
  }
  SHEETS.push(s); curSheet = SHEETS.length-1; selChar = -1;
  refreshSheets();
  stat('版を複製した（重なっている＝位置や大きさで動かす）');
};
document.getElementById('delSheet').onclick = ()=>{
  if(SHEETS.length <= 1) return;
  gl.deleteTexture(SHEETS[curSheet].tex);
  SHEETS.splice(curSheet, 1);
  curSheet = Math.min(curSheet, SHEETS.length-1);
  selChar = -1;
  refreshSheets();
};

/* ── 全リセット：全パラメータ＋アンカー＋文字ごと伸縮を初期値へ（字はそのまま）── */
function resetAll(){
