}
document.getElementById('resetAll').onclick = resetAll;
document.getElementById('reset').onclick=()=>ANCHORS.length=0;
/* ══ 版面（書き出す大きさ）══ 礫 TSUBUTE の「FRAME」と同じ型を持ってきた。
   ⭐ ここは【画面の canvas そのものを版面の形にする】＝見えているものがそのまま出る。
      枠だけ描いて中身は画面のまま、にすると「見えている絵」と「出る絵」がズレる。 */
const FSHAPE = [[1,1],[4,5],[16,9],[9,16]];
function frameRatio(){ return FSHAPE[P.fshape|0] || FSHAPE[0]; }
function frameSize(){
  const [rw,rh] = frameRatio();
  const L = Math.round(P.flong);
  let w, h;
  if(rw >= rh){ w = L; h = Math.round(L*rh/rw); } else { h = L; w = Math.round(L*rw/rh); }
  /* ⚠️ 端末の上限を超えると【何も出ない】。黙って壊れず、上限まで下げて、当たったことを出す */
  const lim = Math.min(gl.getParameter(gl.MAX_RENDERBUFFER_SIZE) || 4096, 8192);
  let cap = false;
  if(w > lim || h > lim){ const k = Math.min(lim/w, lim/h); w = Math.floor(w*k); h = Math.floor(h*k); cap = true; }
  return { w, h, cap };
}
function layoutCanvas(){
  const on = P.frameOn === 1;
  document.body.classList.toggle('framed', on);
  if(!on){ canvas.removeAttribute('style'); resize(); updateOut(); return; }
  const mobile = innerWidth <= 760;
  const availW = mobile ? innerWidth : Math.max(innerWidth - 262, 200);   // 右のパネルを避ける
  const availH = mobile ? innerHeight*0.58 : innerHeight;
  const [rw,rh] = frameRatio();
  const k = Math.min(availW*0.9/rw, availH*0.9/rh);
  const w = Math.round(rw*k), h = Math.round(rh*k);
  canvas.style.width = w+'px'; canvas.style.height = h+'px';
  canvas.style.left  = Math.round((availW-w)/2)+'px';
  canvas.style.top   = Math.round((availH-h)/2)+'px';
  canvas.style.right = 'auto'; canvas.style.bottom = 'auto';
  resize(); updateOut();
}
function updateOut(){
  const n = document.getElementById('fout'); if(!n) return;
  if(P.frameOn !== 1){ n.innerHTML = `画面のまま ＝ <b>${canvas.width} × ${canvas.height} px</b>`; return; }
  const f = frameSize();
  n.innerHTML = `出る大きさ ＝ <b>${f.w} × ${f.h} px</b>`
    + (f.cap ? '<br>⚠️ この端末の上限に当たったので下げた' : '');
}
/* ⭐ 版面の大きさで刷る。⚠️ 終わったら必ず元へ戻す */
/* ⭐ 地なしは【絵のあるところだけ】に切り詰めて出す。2026-08-07
   ⚠️ 透明の余白がついたままだと、貼 HARI や Illustrator で選んだときに
      画面いっぱいの箱になって、絵そのものの大きさ・位置が掴めない。
   ⚠️ WebGL の y は下から数える。drawImage は上から。切るときに上下を入れ替える。 */
function cropToBlob(cb){
  const w = canvas.width, h = canvas.height;
  const px = new Uint8Array(w * h * 4);
  gl.readPixels(0, 0, w, h, gl.RGBA, gl.UNSIGNED_BYTE, px);
  let x0 = w, y0 = h, x1 = -1, y1 = -1;
  for(let y = 0; y < h; y++){
    const row = y * w * 4;
    for(let x = 0; x < w; x++){
      if(px[row + x*4 + 3] > 2){                    // 透明でない画素
        if(x < x0) x0 = x;
        if(x > x1) x1 = x;
        if(y < y0) y0 = y;
        if(y > y1) y1 = y;
      }
    }
  }
  if(x1 < 0){ canvas.toBlob(cb, 'image/png'); return; }   // 何も写っていなければそのまま
  const cw = x1 - x0 + 1, ch = y1 - y0 + 1;
  const out = document.createElement('canvas');
  out.width = cw; out.height = ch;
  out.getContext('2d').drawImage(canvas, x0, h - 1 - y1, cw, ch, 0, 0, cw, ch);
  out.toBlob(cb, 'image/png');
}
function renderToBlob(cb, noBg){
  /* ⚠️ 地なしのときも【一度描き直してから】撮る。撮ってから消しても手遅れ */
  if(P.frameOn !== 1){
    if(noBg){
      noBgOnce = true; render(lastT);
      cropToBlob(b => { noBgOnce = false; render(lastT); cb(b); });
      return;
    }
    canvas.toBlob(b => { noBgOnce = false; render(lastT); cb(b); }, 'image/png');
    return;
  }
  const f = frameSize();
  const kw = canvas.width, kh = canvas.height;
  try{
    canvas.width = f.w; canvas.height = f.h;
    noBgOnce = !!noBg; render(lastT);
    if(noBg) cropToBlob(b => { noBgOnce = false; cb(b); });
    else canvas.toBlob(b => { noBgOnce = false; cb(b); }, 'image/png');
  } finally {
    noBgOnce = false;
    canvas.width = kw; canvas.height = kh;
    render(lastT);
  }
}
/* ⚠️ iOS は DOM に入れていない <a> の click を無視する／巨大な dataURL で落ちる（礫と同じ作法） */
function savePNG(noBg){ renderToBlob(blob=>{
  if(!blob) return;
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `maku_${Date.now()}.png`;
  document.body.appendChild(a); a.click(); a.remove();
  if(/iP(hone|ad|od)/.test(navigator.userAgent)) window.open(url, '_blank');
  setTimeout(()=>URL.revokeObjectURL(url), 8000);
}, noBg); }
document.getElementById('png').onclick     = ()=> savePNG(false);
document.getElementById('pngA').onclick    = ()=> { savePNG(true); stat('地なしで出した（重ねられる）'); };

/* ══ 地のグラデ ── 使う色数のぶんだけ出す（触れるのに何も起きないつまみを残さない）══ */
function syncGrad(){
  const n = Math.max(1, Math.round(P.papN));
  document.body.classList.toggle('grad', n > 1);
  for(let k=3;k<=6;k++) document.body.classList.toggle('grad-'+k, n >= k);
}
/* ⚠️⚠️ 色は data-pc で持つ。既存の input[data-p]/id のループは `+r.value` で数値にするので、
