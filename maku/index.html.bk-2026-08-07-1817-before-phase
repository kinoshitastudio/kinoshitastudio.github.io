<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>膜 MAKU — 連続面メッシュ変形 / 木下スタジオ</title>
<meta name="description" content="膜 MAKU は、文字を一枚の連続した面として掴んで流体のように変形させるブラウザの道具。金属光沢をまとった面が結び目のようにねじれ、書き出しはそのまま作字の素材になる。木下スタジオ（滋賀・木下貴博）制作。">
<link rel="canonical" href="https://kinoshita.studio/maku/">
<meta property="og:title" content="膜 MAKU — 連続面メッシュ変形">
<meta property="og:description" content="文字を一枚の連続した面として掴み、流体のように変形させる。金属光沢の面がねじれ、そのまま作字の素材になる。">
<meta property="og:image" content="https://kinoshita.studio/assets/img/img-ui-maku.jpg">
<meta property="og:url" content="https://kinoshita.studio/maku/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="木下スタジオ">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://kinoshita.studio/assets/img/img-ui-maku.jpg">
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Zen+Old+Mincho:wght@600;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{--ink:#0a0a0a;--paper:#f4f2ee;--line:rgba(10,10,10,.14);}
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;overflow:hidden;background:#111;}
  body{font-family:"Zen Kaku Gothic New",sans-serif;font-weight:300;color:var(--ink);
    -webkit-font-smoothing:antialiased;}
  /* touch-action:none はキャンバスだけ＝描画/アンカー用。パネルのスライダーやスクロールは殺さない */
  #gl{display:block;position:fixed;inset:0;width:100%;height:100%;touch-action:none;}

  #panel{position:fixed;top:16px;right:16px;z-index:20;width:230px;
    background:rgba(244,242,238,.9);backdrop-filter:blur(12px);border:1px solid var(--line);
    max-height:calc(100vh - 32px);overflow-y:auto;padding:12px;}
  h2{font-family:"Space Mono",monospace;font-size:9px;letter-spacing:.24em;opacity:.45;margin:12px 0 6px;}
  h2:first-child{margin-top:0;}
  textarea{width:100%;height:48px;background:rgba(255,255,255,.5);border:1px solid var(--line);
    padding:6px;font-family:"Zen Kaku Gothic New",sans-serif;font-size:11px;outline:none;resize:none;}
  .seg{display:flex;border:1px solid var(--line);margin:5px 0;}
  .seg button{flex:1;background:none;border:none;cursor:pointer;padding:6px 0;
    font-family:"Space Mono",monospace;font-size:8px;letter-spacing:.08em;color:var(--ink);
    opacity:.4;border-right:1px solid var(--line);}
  .seg button:last-child{border-right:none;}
  .seg button.on{opacity:1;background:var(--ink);color:var(--paper);}
  .row{display:flex;align-items:center;gap:8px;padding:2px 0;}
  .row label{font-family:"Space Mono",monospace;font-size:8px;opacity:.5;width:52px;flex:none;letter-spacing:.06em;}
  .row input[type=range]{-webkit-appearance:none;flex:1;height:1px;background:var(--line);outline:none;cursor:pointer;}
  .row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:9px;height:9px;border-radius:50%;background:var(--ink);cursor:pointer;}
  .val{font-family:"Space Mono",monospace;font-size:8px;opacity:.4;width:26px;text-align:right;flex:none;}
  /* ⭐ 説明は既定で畳む＝つまみだけの見た目にする。右上の ? で出す（TSUBU・TSUBUTE と同じ作法） */
  .note{font-family:"Space Mono",monospace;font-size:7px;line-height:1.8;opacity:.32;margin-top:6px;display:none;}
  body.help .note{display:block;}
  #helpBtn{position:absolute;top:8px;right:42px;width:17px;height:17px;padding:0;line-height:1;
    background:rgba(255,255,255,.5);border:1px solid var(--line);color:var(--ink);
    font-family:"Space Mono",monospace;font-size:9px;cursor:pointer;opacity:.6;z-index:3;}
  #helpBtn:hover{opacity:.9;}
  @media(max-width:760px){ #helpBtn{width:26px;height:26px;font-size:11px;right:56px;} }
  .chips{display:flex;flex-wrap:wrap;gap:4px;margin:5px 0;}
  .chips button{min-width:22px;height:24px;padding:0 5px;background:rgba(255,255,255,.5);
    border:1px solid var(--line);font-family:"Zen Kaku Gothic New",sans-serif;font-size:13px;
    cursor:pointer;color:var(--ink);opacity:.55;}
  .chips button.on{opacity:1;background:var(--ink);color:var(--paper);}
  input[type=range]:disabled{opacity:.3;cursor:not-allowed;}
  .big{width:100%;padding:8px 0;margin-top:8px;background:none;color:var(--ink);border:1px solid var(--line);
    cursor:pointer;font-family:"Space Mono",monospace;font-size:8.5px;letter-spacing:.18em;}
  #hud{position:fixed;left:16px;top:16px;z-index:20;font-family:"Space Mono",monospace;
    font-size:8.5px;letter-spacing:.14em;color:#fff;opacity:.5;line-height:2;}

  /* ── モバイル：二分割（canvas上58dvh / パネル下42dvh 全幅）＝HORI/KUMI/TSUBUと統一 ── */
  @media(max-width:760px){
    #gl{ top:0; height:58vh; height:58dvh; bottom:auto; }
    #panel{ top:58vh; top:58dvh; left:0; right:0; bottom:0; width:auto;
      max-height:42vh; max-height:42dvh; overflow-y:auto;
      border:none; border-top:1px solid var(--line);
      background:rgba(244,242,238,.97); backdrop-filter:none;
      padding:12px 14px calc(12px + env(safe-area-inset-bottom)); }
    #hud{ top:10px; left:12px; }
    /* 指で掴めるようスライダーのタッチ標的を拡大（見た目の細線は runnable-track で維持） */
    .row{ padding:5px 0; }
    .row input[type=range]{ height:26px; background:transparent; touch-action:pan-x; }
    .row input[type=range]::-webkit-slider-runnable-track{ height:1px; background:var(--line); }
    .row input[type=range]::-webkit-slider-thumb{ width:18px; height:18px; margin-top:-8.5px; }
    .seg button{ padding:10px 0; }
  }

  /* ⭐ モバイル ── 見た目の大きさより「掴める領域」を先に確保する。
     ⚠️ range は入力欄そのものの高さが 1px 前後だと、線のどこを押しても効かず
     点（つまみ）にしか当たらない。要素に高さを持たせ、線は track として細く描く。 */
  @media(max-width:760px){
    input[type=range]{ -webkit-appearance:none; height:40px; background:none; margin:0; }
    input[type=range]::-webkit-slider-runnable-track{ height:3px; background:currentColor; opacity:.28; border-radius:2px; }
    input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:22px; height:22px;
      margin-top:-9.5px; border-radius:50%; background:currentColor; }
    input[type=range]::-moz-range-track{ height:3px; background:currentColor; opacity:.28; }
    input[type=range]::-moz-range-thumb{ width:22px; height:22px; border:none; border-radius:50%; background:currentColor; }
    button, .btn, .seg button{ min-height:38px; }
    select{ min-height:36px; }
    input[type=color]{ min-height:32px; }
    label{ font-size:10.5px; }
  }
  /* ⚠️ ドラッグする要素はスクロールに取られないようにする */
  canvas{ touch-action:none; }
  /* ⓜモバイル調整済 */
  #langBtn{position:absolute;top:8px;right:10px;height:17px;padding:0 6px;line-height:1;
    border:1px solid var(--line);background:none;cursor:pointer;border-radius:9px;
    font-family:ui-monospace,Menlo,monospace;font-size:8.5px;color:inherit;opacity:.4;z-index:5;}
  #langBtn:hover{opacity:.9;}
  @media(max-width:760px){ #langBtn{height:26px;font-size:10px;padding:0 10px;} }

  /* ══════════════════════════════════════════════════════════════
     見た目 ── SwiftUI（Apple）の作法に寄せる          2026-07-31
     木下＝「MAKU も SAKUJI に合わせて同じように swift ui 統一は可能？」

     ⭐ ここは【いちばん最後に書いた上書きブロック】。上のCSSは1行も触っていない。
        気に入らなければ、このブロックごと消せば完全に元へ戻る。
     ⭐ HTML の構造・並び・id も触っていない＝機能は同じ。見た目だけ。
     ⚠️ SAKUJI のブロックをそのまま移すことはできない（MAKU は --btn / ui-light を持たず、
        ボタンが .btn でなく .big、独自に .chips と textarea がある）。
        【同じ設計方針で、MAKU のクラス名に合わせて書き直したもの】。
     ⚠️ モバイルの「掴める領域」（入力欄そのものに高さ・つまみ22px）は上の @media で
        確保してある。ここでも同じ大きさを守ること（書かないと上書きして点に戻る）。
     ── 方針（SAKUJI と同じ）──
     材質（半透明＋背面ぼかし）／fill 階調で階層／角丸を大きく／
     セグメンテッドは選んだところに白いカプセルが浮く／太いトラックと大きな白いつまみ／
     見出しは SF・小さいグレー／色は白黒のまま（Apple 青は入れない）
     ══════════════════════════════════════════════════════════════ */
  :root{
    --line:rgba(60,60,67,.16);           /* separator */
    --fill:rgba(120,120,128,.13);        /* systemFill */
    --fill2:rgba(120,120,128,.10);       /* セグメンテッドの受け皿 */
    --capsule:#ffffff;                   /* 選択カプセル */
    --glass:rgba(242,242,247,.82);       /* パネル */
    --dim:rgba(60,60,67,.62);            /* secondaryLabel */
    --shadow:0 10px 30px rgba(0,0,0,.13), 0 1px 2px rgba(0,0,0,.07);
    --r:10px;
  }
  body{ font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Hiragino Sans",
    "Zen Kaku Gothic New",sans-serif; font-weight:400; }

  #panel{
    background:var(--glass); border:.5px solid var(--line); border-radius:16px;
    box-shadow:var(--shadow); padding:14px 14px 18px;
    -webkit-backdrop-filter:blur(30px) saturate(180%);
            backdrop-filter:blur(30px) saturate(180%);
  }
  /* 見出し＝帯にせず、小さいグレー。sticky でスクロールしても居場所が分かる */
  #panel h2{
    position:sticky; top:-14px; z-index:3;
    margin:20px -14px 8px; padding:7px 14px 6px;
    background:var(--glass);
    -webkit-backdrop-filter:blur(30px) saturate(180%);
            backdrop-filter:blur(30px) saturate(180%);
    border-bottom:.5px solid var(--line);
    font-family:inherit; font-size:11px; font-weight:590;
    letter-spacing:.06em; opacity:1; color:var(--dim);
  }
  #panel h2:first-child{ margin-top:-14px }

  /* 行・ラベル・数値 */
  .row{ gap:10px; padding:3px 0 }
  .row label{ font-family:inherit; font-size:11.5px; opacity:1; color:var(--ink);
    letter-spacing:0; width:58px }
  /* 🔴 数字はつまみの右に【必ず収まる】こと。つまみに幅を渡さないと、
     ラベル58＋つまみ＋数字30＋隙間 がパネルの内側幅を超えて、数字が画面の外に出る
     （2026-08-07 木下「パネルに数字がない」＝出ていたが 22px はみ出していた）。 */
  .val{ font-family:ui-monospace,"SF Mono",Menlo,monospace; font-size:11px;
    opacity:1; color:var(--dim); width:30px; flex:0 0 30px; text-align:right;
    font-variant-numeric:tabular-nums }
  .row input[type=range]{ flex:1 1 auto; min-width:0 }

  /* スライダー＝太いトラック＋大きな白いつまみ */
  .row input[type=range], input[type=range]{
    -webkit-appearance:none; appearance:none; background:none; height:26px;
  }
  .row input[type=range]::-webkit-slider-runnable-track,
  input[type=range]::-webkit-slider-runnable-track{
    height:4px; border-radius:2px; background:var(--fill); opacity:1;
  }
  .row input[type=range]::-webkit-slider-thumb,
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; appearance:none; width:20px; height:20px; margin-top:-8px;
    border-radius:50%; background:var(--ink); border:none; cursor:pointer;
    box-shadow:0 1px 3px rgba(0,0,0,.32), 0 0 0 .5px rgba(0,0,0,.05);
  }
  input[type=range]::-moz-range-track{ height:4px; border-radius:2px; background:var(--fill); opacity:1 }
  input[type=range]::-moz-range-thumb{ width:20px; height:20px; border:none; border-radius:50%;
    background:var(--ink); box-shadow:0 1px 3px rgba(0,0,0,.32) }

  /* セグメンテッド＝選んだところに白いカプセルが浮く */
  .seg{ background:var(--fill2); border:none; border-radius:9px; padding:2px; gap:2px; margin:6px 0 10px }
  .seg button{ border:none; border-right:none; border-radius:7px; background:none;
    font-family:inherit; font-size:11.5px; letter-spacing:0; font-weight:450;
    color:var(--ink); opacity:.72; padding:6px 0; transition:.16s }
  .seg button:hover{ opacity:1; background:rgba(120,120,128,.10) }
  .seg button.on{ opacity:1; background:var(--capsule); color:var(--ink); font-weight:590;
    box-shadow:0 1px 3px rgba(0,0,0,.16), 0 0 0 .5px rgba(0,0,0,.04) }

  /* ボタン */
  .big{ background:var(--fill); border:none; border-radius:var(--r); color:var(--ink);
    font-family:inherit; font-size:12px; font-weight:500; letter-spacing:.02em;
    padding:11px 0; transition:.14s }
  .big:hover{ background:rgba(120,120,128,.22) }
  .big:active{ transform:scale(.985); opacity:.8 }

  /* 字のチップ */
  .chips button{ background:var(--fill); border:none; border-radius:8px; opacity:.8;
    min-width:30px; height:30px; transition:.14s }
  .chips button:hover{ opacity:1; background:rgba(120,120,128,.22) }
  .chips button.on{ opacity:1; background:var(--ink); color:var(--paper) }

  /* 打ち込み欄 */
  textarea{ background:var(--fill); border:none; border-radius:var(--r);
    font-family:inherit; font-size:12.5px; padding:9px 10px; }
  textarea:focus{ box-shadow:0 0 0 3px rgba(120,120,128,.22) }

  /* 説明・HUD・言語切替 */
  .note{ font-family:inherit; font-size:10.5px; line-height:1.65; opacity:.55; color:var(--ink) }
  #hud{ font-family:ui-monospace,"SF Mono",Menlo,monospace; opacity:.55 }
  #langBtn, #helpBtn{ border:.5px solid var(--line); border-radius:9px; background:rgba(255,255,255,.6);
    font-family:inherit; font-size:9.5px; font-weight:500; opacity:.6;
    -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px) }
  #langBtn:hover, #helpBtn:hover{ opacity:1 }
  /* ⭐ 説明は既定で畳む。? を押したときだけ出す（粒 TSUBU・礫 TSUBUTE と同じ作法）
     ＝つまみだけの見た目にして、要るときに読む。 */
  body.help #helpBtn{ background:var(--ink); color:var(--paper); opacity:1; border-color:var(--ink) }

  /* ⚠️ モバイル＝上の @media と同じだけ「掴める領域」を確保し直す。
     書かないと、この上書きブロックが勝ってつまみが小さいまま＝点にしか当たらない。 */
  @media(max-width:760px){
    #panel{ border-radius:16px 16px 0 0; border:none; border-top:.5px solid var(--line);
      background:rgba(242,242,247,.94) }
    #panel h2{ top:-12px; margin:18px -14px 8px }
    .row{ padding:5px 0 }
    input[type=range]{ height:40px }
    input[type=range]::-webkit-slider-runnable-track{ height:4px }
    input[type=range]::-webkit-slider-thumb{ width:24px; height:24px; margin-top:-10px }
    input[type=range]::-moz-range-thumb{ width:24px; height:24px }
    .seg button{ padding:11px 0; min-height:38px }
    .big{ padding:13px 0; min-height:38px }
    input[type=color]{ height:34px }
    .chips button{ min-width:36px; height:36px }
  }

  /* ══════════════════════════════════════════════════════════════
     地のグラデ／画像を元にする                        2026-08-03
     ⭐ ここも【いちばん最後に足したブロック】。消せば元の見た目に戻る。
     ⭐ 使わないつまみは出さない（色数 1 のときグラデの設定は畳む）。
     ══════════════════════════════════════════════════════════════ */
  input[type=color]{ -webkit-appearance:none; appearance:none; flex:1; height:26px;
    background:none; border:none; border-radius:8px; padding:0; cursor:pointer; }
  input[type=color]::-webkit-color-swatch-wrapper{ padding:0 }
  input[type=color]::-webkit-color-swatch{ border:.5px solid var(--line); border-radius:8px }

  .only-grad{ display:none }
  body.grad .only-grad{ display:block }
  .grad3,.grad4,.grad5,.grad6{ display:none }
  body.grad-3 .grad3{ display:block }
  body.grad-4 .grad4{ display:block }
  body.grad-5 .grad5{ display:block }
  body.grad-6 .grad6{ display:block }

  /* ⚠️ 画像のときは「見え（縞）」が効かない＝触れるのに何も起きない範囲を残さない */
  body.img-mode .only-text{ display:none }
  #imgBtn{ margin-top:0 }

  /* ⚠️ 地が明るいと、白い HUD が地に溶けて読めなくなる（地のグラデを入れて起きた）。
     ⭐ 差分合成＝地が暗ければ白く、明るければ暗く出る＝どんな地でも必ず読める。 */
  #hud{ color:#fff; opacity:1; mix-blend-mode:difference; }

  /* 刷り ── 字のインク。使う色数のぶんだけ出す */
  .only-ink{ display:none }
  body.look-ink .only-ink{ display:block }
  /* ⭐ 色見本は【刷り】と【縞に色をつけたとき】で共有する＝色は1組しか持たない */
  .only-color{ display:none }
  body.look-color .only-color{ display:block }
  /* ⭐ 段・隙間・縞の色数は【金属】だけのつまみ（線には効かない） */
  .only-metal{ display:none }
  body.look-metal .only-metal{ display:block }
  .ink2,.ink3,.ink4,.ink5,.ink6{ display:none }
  body.ink-2 .ink2{ display:block }
  body.ink-3 .ink3{ display:block }
  body.ink-4 .ink4{ display:block }
  body.ink-5 .ink5{ display:block }
  body.ink-6 .ink6{ display:block }
  /* ⚠️ 密度は縞（金属・線）のつまみ。墨と刷りでは何も起きないので出さない */
  .only-stripe{ display:none }
  body.look-stripe .only-stripe{ display:block }

  /* 版面 ── 「画面のまま」のときは形と長辺のつまみを出さない */
  .only-frame{ display:none }
  body.framed .only-frame{ display:block }
  /* ⭐ 版面のときは canvas が紙そのもの＝外に地が続かないよう、まわりを暗く落として境を見せる */
  body.framed #gl{ box-shadow:0 0 0 1px rgba(255,255,255,.16), 0 24px 60px rgba(0,0,0,.5) }
</style>
</head>
<body>
<canvas id="gl"></canvas>
<div id="hud">膜 MAKU / KINOSHITA STUDIO<br><span id="stat"></span></div>

<div id="panel"><button id="helpBtn" title="説明の表示／非表示">?</button><button id="langBtn" title="日本語 / English">JP</button>
  <!-- ⭐ 版（重ねる）── 1枚の膜の上に、字や画像を何枚でも重ねる。
       ⭐ 2026-08-06 ワープ・3層・変形（辺ごと）は【版ごと】にした（それまでは面にひとつ）。
       アンカー・地・版面・絵の大きさは面のもの＝どの版にも同じくかかる。 -->
  <h2>版（重ねる）</h2>
  <div class="chips" id="sheets"></div>
  <div class="seg" id="addSeg"><button data-add="text">＋ 字</button><button data-add="image">＋ 画像</button></div>
  <input type="file" id="imgFile" accept="image/*" hidden>
  <!-- ⭐ 2026-08-06 可動域を広げた。位置は ±100（＝版1枚ぶん）だと画面の外まで押し出せず、
       大きさも 300% で頭打ちだった。値の意味は変えていない（x/y は /100・大きさは倍率）ので
       古い控えはそのまま読める。 -->
  <!-- ⭐ 2026-08-07 つまみでなく【画面で直接つかんで動かす】。既存のアンカー（面を押す）は
       そのまま残し、モードで切り替える＝今までの操作を奪わない。 -->
  <div class="seg" id="grab"><button data-v="0" class="on">面を押す</button><button data-v="1">版をつかむ</button></div>
  <div class="row"><label>横位置</label><input type="range" id="sx" min="-300" max="300" value="0"><span class="val"></span></div>
  <div class="row"><label>縦位置</label><input type="range" id="sy" min="-300" max="300" value="0"><span class="val"></span></div>
  <div class="row"><label>大きさ</label><input type="range" id="ss" min="1" max="800" value="100"><span class="val"></span></div>
  <div class="row"><label>角度</label><input type="range" id="sr" min="-180" max="180" value="0"><span class="val"></span></div>
  <button class="big" id="dupSheet">この版を複製</button>
  <button class="big" id="delSheet">この版を消す</button>
