  }
  /* ⭐ ワープ（連続面）・変形（辺ごと）も【選んでいる版】に書く。P には入れない
     ＝版Aは砂時計・版Bはまっすぐ、が作れる（2026-08-06） */
  if(WARP_KEYS.indexOf(r.id) >= 0){
    r.addEventListener('input', ()=>{
      const s = S_(); if(!s || !s.warp) return;
      s.warp[r.id] = +r.value; if(val) val.textContent = r.value; });
    return;
  }
  /* ⭐ 版のつまみ（位置・大きさ・角度・字間・行間）は【選んでいる版】に書く。P には入れない */
  const SHEETKEY = { sx:'x', sy:'y', ss:'scale', sr:'rot', track:'track', leading:'leading' };
  if(SHEETKEY[r.id]){
    r.addEventListener('input', ()=>{
      const s = S_(); if(!s) return;
      s[SHEETKEY[r.id]] = (r.id === 'ss') ? +r.value/100 : +r.value;
      if(val) val.textContent = r.value;
      if(r.id === 'track' || r.id === 'leading') bakeSheet(s);   // セルの寸法が変わる＝焼き直す
    });
    return;
  }
  const sync=()=>{ P[r.id]=+r.value; if(val) val.textContent=r.value;
    if(r.id==='mesh') buildMesh();
    if(r.id==='papN') syncGrad();
    if(r.id==='inkN' || r.id==='stInkN') syncInk();   // ⭐ 縞の色数でも色見本の出し方が変わる
    // ⭐ 絵（膜）だけを大小・移動。地（紙）は動かない＝版面の中で絵を置き直せる
    if(r.id==='fitz') VIEW.zoom = +r.value/100;
    if(r.id==='fitx') VIEW.panx = +r.value/100;
    if(r.id==='fity') VIEW.pany = +r.value/100;
    if(r.id==='flong' && typeof updateOut === 'function') updateOut(); };
  // 字間・行間はテクスチャを焼き直す（初期化中に呼ぶと参照順で落ちるので input 時だけ）
  r.addEventListener('input', sync);
  sync();
});
/* ⭐ ドラッグ／ホイール／ピンチで動かしても、パネルの「絵の大きさ・よこ・たて」を実体に合わせる
      （数字と実体をズラさない）。
   ⚠️ ホイールは 30倍まで寄れる＝つまみの幅（20〜300%）を超える。そのときは
      つまみだけ端に張り付き、右の数字には【実際の値】を出す＝嘘をつかない。 */
function syncViewUI(){
  const put = (id, real, lo, hi)=>{
    const el = document.getElementById(id); if(!el) return;
    el.value = Math.max(lo, Math.min(hi, real));
    const s = el.parentElement.querySelector('.val'); if(s) s.textContent = real;
  };
  put('fitz', Math.round(VIEW.zoom * 100), 20, 300);
  put('fitx', Math.round(VIEW.panx * 100), -150, 150);
  put('fity', Math.round(VIEW.pany * 100), -150, 150);
}
function syncLayerUI(){                             // 層／版を選び直したらスライダー表示をその値へ
