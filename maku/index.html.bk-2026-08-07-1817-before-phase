  document.querySelectorAll('#panel input[type=range]').forEach(r=>{
    if(r.id.startsWith('L_')) return;              // 層スライダーは syncLayerUI で戻す
    if(WARP_KEYS.indexOf(r.id) >= 0) return;       // ワープ・辺ごとは syncWarpUI で戻す（版の持ち物）
    if(r.id === 'grain') return;                   // 粒は syncGrainUI で戻す（目盛りと実マス数が別）
