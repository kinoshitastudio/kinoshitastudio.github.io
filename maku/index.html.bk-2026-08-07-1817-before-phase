 'uGridCols','uGridRows','uCharN','uZoom','uRotX','uRotY','uThick',
 'uRes','uInkN','uPapMode','uPapAng','uPapSteps','uPapCx','uPapCy','uStSteps','uStGap','uStInkN','uStRound','uStFit','uStAng','uStMix','uStGloss','uCut','uGrain','uGrainInk','uGrainJit','uGrainAng',
 'uSheetSize','uSheetPos','uSheetScale','uSheetRot'].forEach(n=>loc[n]=gl.getUniformLocation(prog,n));
for(let i=0;i<6;i++) loc['uInk'+i] = gl.getUniformLocation(prog,'uInk'+i);
loc.uPan = gl.getUniformLocation(prog,'uPan');
loc.aUV = gl.getAttribLocation(prog,'aUV');
loc.uAnchorUV = gl.getUniformLocation(prog,'uAnchorUV');
loc.uAnchorD  = gl.getUniformLocation(prog,'uAnchorD');
loc.uCharScale = gl.getUniformLocation(prog,'uCharScale');
loc.uCharRot   = gl.getUniformLocation(prog,'uCharRot');
loc.uCharType  = gl.getUniformLocation(prog,'uCharType');
['uLW','uLH','uLRot','uLWarp','uLDens','uLSAng','uLSOff'].forEach(n=>loc[n]=gl.getUniformLocation(prog,n));

/* ⭐ 版ごとの歪みを GL に入れる ── ワープ（連続面）・変形（辺ごと）・3層。
   ⚠️ 2026-08-06 まではこれを版ループの外で1回だけ入れていた＝どの版も同じに歪んだ。
   ⚠️ 生値→実効レンジの掛け算はここ【1箇所だけ】に書く（版ごとに書き分けない）。
   ⚠️ 配列は使い回す＝毎フレーム・毎版で作らない。 */
const L4 = { w:new Float32Array(4), h:new Float32Array(4), rot:new Float32Array(4),
             warp:new Float32Array(4), dens:new Float32Array(4), sang:new Float32Array(4), soff:new Float32Array(4) };
function putWarp(W){
  W = W || WARP_DEF;
  const v = k => (W[k] || 0);
  gl.uniform1f(loc.uThick,  v('thick')/100*0.6);
  gl.uniform1f(loc.uVWarp,  v('vwarp')/100*0.42);
  gl.uniform1f(loc.uHWarp,  v('hwarp')/100*0.42);
  gl.uniform1f(loc.uFreq,   W.freq != null ? W.freq : WARP_DEF.freq);
  gl.uniform1f(loc.uWTop,   v('wtop')/100*0.8);
  gl.uniform1f(loc.uWBot,   v('wbot')/100*0.8);
  gl.uniform1f(loc.uHLeft,  v('hleft')/100*0.8);
  gl.uniform1f(loc.uHRight, v('hright')/100*0.8);
  gl.uniform1f(loc.uWMid,   v('wmid')/100*0.8);
  gl.uniform1f(loc.uHMid,   v('hmid')/100*0.8);
  gl.uniform1f(loc.uShearX, v('shearx')/100*1.0);
  gl.uniform1f(loc.uShearY, v('sheary')/100*1.0);
  gl.uniform1f(loc.uTwTop,  v('twtop')/100*1.6);
  gl.uniform1f(loc.uTwBot,  v('twbot')/100*1.6);
}
function putLayers(LS){
  for(let i=0;i<4;i++){ const L = (LS && LS[i]) || {};
    L4.w[i]=(L.w||0)/100*0.6; L4.h[i]=(L.h||0)/100*0.6; L4.rot[i]=(L.rot||0)/100*0.6;
    L4.warp[i]=(L.warp||0)/100*0.15; L4.dens[i]=(L.dens||0)/100*2;
    L4.sang[i]=(L.sang||0)/100*1.5707963;                  // ±90°
    L4.soff[i]=(L.soff||0)/100*1.0;                        // 縞を流す位置
  }
  gl.uniform1fv(loc.uLW,L4.w); gl.uniform1fv(loc.uLH,L4.h); gl.uniform1fv(loc.uLRot,L4.rot);
  gl.uniform1fv(loc.uLWarp,L4.warp); gl.uniform1fv(loc.uLDens,L4.dens);
  gl.uniform1fv(loc.uLSAng,L4.sang); gl.uniform1fv(loc.uLSOff,L4.soff);
}

/* ⭐ 面が画面のどれだけを占めるか。⚠️ この式は【1箇所だけ】に書く
   ── 描くときと「版をつかんで動かす」ときで別々に書くと、掴んだ点と絵がズレる。 */
function faceScale(){
  const view = canvas.width / Math.max(canvas.height, 1);
  return { x: 0.8 * (view > 1 ? 1/view : 1), y: 0.8 * (view > 1 ? 1 : view) };
}

/* ⚠️ 描くのとループを分けてある＝書き出しのときだけ【版面の大きさで1回だけ描く】ため */
let lastT = 0;
function draw(t){ requestAnimationFrame(draw); lastT = t; render(t); }
/* ⭐ 地なし（透明）で描く。⚠️ 貼 HARI など【他の道具に持ち込むため】。
   地が入っていると、重ねたときに四角い板になって下が隠れる。 */
let noBgOnce = false;
function render(t){
  const w = canvas.width, h = canvas.height;
  gl.viewport(0,0,w,h);
  const bg = P.look===2 ? [0.04,0.04,0.05,1] : (P.look===1 ? [0.957,0.949,0.933,1] : [0.03,0.03,0.04,1]);
  if(noBgOnce) gl.clearColor(0,0,0,0); else gl.clearColor(...bg);
  gl.clear(gl.COLOR_BUFFER_BIT);

  /* ⭐ 地（紙）── clear の後・膜の前に、画面いっぱいの紙を刷る。
     色数 1 なら uBase をそのまま返すので、これまでと同じ単色の地になる。 */
  if(!noBgOnce){
  gl.useProgram(bgProg);
  gl.uniform2f(bgLoc.uRes, w, h);
  gl.uniform3f(bgLoc.uBase, bg[0], bg[1], bg[2]);
  gl.uniform1f(bgLoc.uPapN,     Math.max(1, Math.round(P.papN)));
  gl.uniform1f(bgLoc.uPapMode,  P.papMode);
  gl.uniform1f(bgLoc.uPapAng,   P.papAng);
  gl.uniform1f(bgLoc.uPapSteps, P.papSteps);
  gl.uniform1f(bgLoc.uPapCx,    P.papCx/100);
  gl.uniform1f(bgLoc.uPapCy,    P.papCy/100);
  for(let i=0;i<6;i++) gl.uniform3fv(bgLoc['uPap'+i], hex2rgb(PAPC[i]));
  gl.bindBuffer(gl.ARRAY_BUFFER, bgBuf);
  gl.enableVertexAttribArray(bgLoc.aP);
  gl.vertexAttribPointer(bgLoc.aP, 2, gl.FLOAT, false, 0, 0);
  gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
  }
  gl.useProgram(prog);                       // ⚠️ 以降の uniform は膜のプログラムに当てる

  /* ⭐ 面は【常に正方】。版がそれぞれ自分の形の矩形を面の中に占める。
     ⚠️ 「版1枚のときだけ面を版の形にする」分岐にすると、2枚目を足した瞬間に
        1枚目の見え方（大きさもうねりの掛かり方も）が変わる。規則は1つにする。
     ⚠️ 開幕の絵は起動時に1枚目の大きさを合わせて、これまでと同じ見え方にしてある。 */
  const fs = faceScale();
  const sx = fs.x, sy = fs.y;

  gl.uniform2f(loc.uScale, sx, sy);
  gl.uniform1f(loc.uZoom, VIEW.zoom);
  gl.uniform2f(loc.uPan, VIEW.panx, VIEW.pany);
  gl.uniform1f(loc.uRotX, VIEW.rotx);
  gl.uniform1f(loc.uRotY, VIEW.roty);
  /* ⚠️ ワープ（連続面）と変形（辺ごと）は【版ごと】＝下の版ループの中で入れる。
     ここに残すと版を重ねたとき全部が同じに歪む（2026-08-06 まではそうだった）。 */
  gl.uniform1f(loc.uTime, t*0.001);
  gl.uniform1f(loc.uAnchorR, P.radius/100);
  gl.uniform1i(loc.uAnchorN, ANCHORS.length);
  gl.uniform1i(loc.uLook, P.look);
  gl.uniform1f(loc.uDensity, P.density);
  /* 刷り（字のインク）── 形は地と同じ版を渡す。色数と色だけ字用 */
  gl.uniform2f(loc.uRes, w, h);
  /* ⚠️ 字の色と色数は【版ごと】＝下の版ループの中で入れる（ここで入れると全版が同じ色になる） */
  /* ⭐ 縞（金属）── 段・隙間・色数。0／1 が既定＝これまでと同じなめらかな金属 */
  gl.uniform1f(loc.uStSteps,  P.stSteps);
  gl.uniform1f(loc.uStGap,    P.stGap/100);           // つまみは 0〜90 ＝ 谷を抜く高さ

  gl.uniform1f(loc.uStRound,  P.stRound/100);
  gl.uniform1f(loc.uStFit,    P.stFit);
  gl.uniform1f(loc.uStAng,    P.stAng/100*1.5707963);   // ±90°
  gl.uniform1f(loc.uStMix,    P.stMix/100);
  gl.uniform1f(loc.uStGloss,  P.stGloss/100);
  gl.uniform1f(loc.uCut,      P.cut);
  /* ⭐ 粒 ── 0＝なし。字も画像も、面のマス目に落ちる */
  gl.uniform1f(loc.uGrain,    P.grain);
  gl.uniform1f(loc.uGrainInk, P.grainInk);
  gl.uniform1f(loc.uGrainJit, P.grainJit/100);
  gl.uniform1f(loc.uGrainAng, P.grainAng/100);
  gl.uniform1f(loc.uPapMode,  P.papMode);
  gl.uniform1f(loc.uPapAng,   P.papAng);
  gl.uniform1f(loc.uPapSteps, P.papSteps);
  gl.uniform1f(loc.uPapCx,    P.papCx/100);
  gl.uniform1f(loc.uPapCy,    P.papCy/100);

  gl.uniform1i(loc.uTex, 0);
  if(ANCHORS.length){
    const uv = new Float32Array(48), dd = new Float32Array(48);
    ANCHORS.forEach((a,i)=>{ uv[i*2]=a.u; uv[i*2+1]=a.v; dd[i*2]=a.du; dd[i*2+1]=a.dv; });
    gl.uniform2fv(loc.uAnchorUV, uv);
    gl.uniform2fv(loc.uAnchorD, dd);
  }

  gl.activeTexture(gl.TEXTURE0);
  gl.bindBuffer(gl.ARRAY_BUFFER, vbuf);
  gl.enableVertexAttribArray(loc.aUV);
  gl.vertexAttribPointer(loc.aUV, 2, gl.FLOAT, false, 0, 0);
  gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibuf);

  /* ⭐ 版を下から順に刷る。⚠️ 面の設定（アンカー・ビュー・地・版面）は上で1回だけ入れてある。
     ⭐ ここで版ごとに変えるのは【何を・どこに】＋【どう歪むか】（ワープ・辺ごと・3層）。 */
  SHEETS.forEach(s=>{
    putWarp(s.warp);                       // ⭐ この版のワープ・辺ごと
    putLayers(s.layers);                   // ⭐ この版の3層
    /* ⭐ この版の色 ── 参考は上が青黄・下が赤＝版ごとに違う色で刷る。
       ⚠️ 地（紙）は1枚のままなので面に置いてある（刷りの形も地と共有）。 */
    const ic = s.inkc || INKC_DEF;
    for(let i=0;i<6;i++) gl.uniform3fv(loc['uInk'+i], hex2rgb(ic[i] || INKC_DEF[i]));
    gl.uniform1f(loc.uInkN,   Math.max(1, Math.round(s.inkN   != null ? s.inkN   : 3)));
    gl.uniform1f(loc.uStInkN, Math.max(1, Math.round(s.stInkN != null ? s.stInkN : 1)));
    // 版の矩形＝長辺を面の 1.0 に合わせる（枚数によらず同じ規則）
    const size = s.asp >= 1 ? [1, 1/s.asp] : [s.asp, 1];
    gl.uniform2f(loc.uSheetSize, size[0], size[1]);
    gl.uniform2f(loc.uSheetPos, s.x/100, s.y/100);
    gl.uniform1f(loc.uSheetScale, s.scale);
    gl.uniform1f(loc.uSheetRot, s.rot*Math.PI/180);
    const isImg = s.kind === 'image';
    gl.uniform1i(loc.uSrc, isImg ? 1 : 0);
    // ⚠️ 画像には「セル（1文字）」が無い。1×1 にして層のエンジンを噛ませない
    gl.uniform1f(loc.uGridCols, isImg ? 1 : s.cols);
    gl.uniform1f(loc.uGridRows, isImg ? 1 : s.rows);
    gl.uniform1i(loc.uCharN, isImg ? 0 : Math.min(s.cols*s.rows, 32));
    const cs = new Float32Array(64), cr = new Float32Array(32), ct = new Float32Array(32);
    for(let i=0;i<32;i++){
      const sc = (s.cscale && s.cscale[i]) || [1,1]; cs[i*2]=sc[0]; cs[i*2+1]=sc[1];
      cr[i] = ((s.crot && s.crot[i]) || 0) * Math.PI/180;          // 度 → rad
      ct[i] = (s.ctype && s.ctype[i] !== undefined) ? s.ctype[i] : 3;
    }
    gl.uniform2fv(loc.uCharScale, cs);
    gl.uniform1fv(loc.uCharRot, cr);
    gl.uniform1fv(loc.uCharType, ct);
    gl.bindTexture(gl.TEXTURE_2D, s.tex);
    gl.drawElements(gl.TRIANGLES, idxCount, gl.UNSIGNED_INT, 0);
  });
}

/* ── アンカー操作＋ビュー（ズーム/パン/傾き） ──
   ⚠️ 座標系：テクスチャは UNPACK_FLIP_Y で焼くので、メッシュ aUV.y=1 が画面上・
      aUV.y=0 が画面下。ポインタ y は上が0なので v=1-y に反転して合わせる。
      ビュー（ズーム/パン/正投影の傾き）を掛けた後にクリックが来るので、toUV では
      逆順に外して面座標へ戻してから UV にする（既存アンカーの噛み合いを保つ）。 */
function toUV(e){ const r=canvas.getBoundingClientRect();
  const nx=((e.clientX-r.left)/r.width)*2-1, ny=(1-(e.clientY-r.top)/r.height)*2-1;
  const mx=(nx-VIEW.panx)/VIEW.zoom, my=(ny-VIEW.pany)/VIEW.zoom;          // 回転後 q.xy
  const rcx=Math.cos(VIEW.rotx), rsx=Math.sin(VIEW.rotx),
        rcy=Math.cos(VIEW.roty), rsy=Math.sin(VIEW.roty);
  const a=mx/(rcy||1e-4);                                                  // q.x = rcy*a
  const b=(my - rsx*rsy*a)/(rcx||1e-4);                                    // q.y = rsx*rsy*a + rcx*b
  return { u:(a+1)/2, v:(b+1)/2 };
}
function ndc(e){ const r=canvas.getBoundingClientRect();
  return { x:((e.clientX-r.left)/r.width)*2-1, y:(1-(e.clientY-r.top)/r.height)*2-1 }; }
let dragA=-1;
let grabS = null;                 // ⭐ 版をつかんで動かしている最中の控え（掴んだ場所と版の位置）
const pointers=new Map();
let viewMode=null, rotStart=null, panStart=null, pinch0=null;
let spaceDown=false, handMode=false;             // Space長押し／手のひらモード＝ボードを掴んで動かす
function applyCursor(){ canvas.style.cursor = (spaceDown||handMode) ? 'grab' : 'default'; }
/* ⭐ キー操作を横取りしてはいけない場所＝【文字を打つ欄】だけ。
   🔴 つまみ（input[type=range]）や色見本まで含めると、つまみを触った直後は
      そこにフォーカスが残っているので ⌘Z も H も丸ごと効かなくなる。
   ⚠️ この判定は1箇所だけに書く（2箇所に書くと必ず片方だけ直す）。 */
function isTyping(t){
  if(!t) return false;
  if(t.tagName === 'TEXTAREA') return true;
  return t.tagName === 'INPUT' && /^(|text|search|url|email|number|tel|password)$/.test(t.type);
}
window.addEventListener('keydown', e=>{
  if(isTyping(e.target)) return;
  if(e.code === 'Space'){ if(!spaceDown){ spaceDown=true; applyCursor(); } e.preventDefault(); }
  if(e.key === 'h' || e.key === 'H'){ handMode = !handMode; applyCursor(); }
});
window.addEventListener('keyup', e=>{
  if(e.code === 'Space'){ spaceDown=false; applyCursor(); }
});
window.addEventListener('blur', ()=>{ spaceDown=false; applyCursor(); });
canvas.addEventListener('contextmenu', e=>e.preventDefault());
canvas.addEventListener('pointerdown', e=>{
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  canvas.setPointerCapture(e.pointerId);
  if(pointers.size===2){                         // 指2本＝ピンチ（ズーム＋パン）
    dragA=-1; viewMode='pinch';
    const p=[...pointers.values()];
    pinch0={ d:Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y),
             cx:(p[0].x+p[1].x)/2, cy:(p[0].y+p[1].y)/2,
             zoom:VIEW.zoom, panx:VIEW.panx, pany:VIEW.pany };
    return;
  }
  if(e.button===2){                              // 右ドラッグ＝傾ける
    viewMode='rot'; rotStart={x:e.clientX,y:e.clientY, rx:VIEW.rotx, ry:VIEW.roty}; return;
  }
  if(e.shiftKey || e.button===1 || spaceDown || handMode){  // Shift/中ボタン/Space長押し/手のひらモード＝パン
    viewMode='pan'; panStart={x:e.clientX,y:e.clientY, px:VIEW.panx, py:VIEW.pany}; return;
  }
  viewMode=null;
  const { u,v }=toUV(e);
  /* ⭐ 版をつかむ ── 選んでいる版を画面の上で直接動かす。
     ⚠️ toUV はビュー（ズーム/パン/傾き）を外して面座標に戻すので、寄っていても正しくついてくる。
     ⚠️ 面座標 -1..1 に対して版の位置は /100 で入る＝面 UV の差を 200 倍して足す。 */
  if(P.grab === 1){
    const sh = S_();
    if(sh) grabS = { u, v, x:sh.x, y:sh.y };
    return;
  }
  if(e.altKey){                                  // Alt+クリック＝近くのアンカーを消す
    let bi=-1,bd=0.06; ANCHORS.forEach((a,i)=>{const d=Math.hypot(a.u-u,a.v-v); if(d<bd){bd=d;bi=i;}});
    if(bi>=0) ANCHORS.splice(bi,1); return;
  }
  let bi=-1,bd=0.06; ANCHORS.forEach((a,i)=>{const d=Math.hypot(a.u-u,a.v-v); if(d<bd){bd=d;bi=i;}});
  if(bi<0 && ANCHORS.length<24){ ANCHORS.push({u,v,du:0,dv:0}); bi=ANCHORS.length-1; }
  dragA=bi;
});
canvas.addEventListener('pointermove', e=>{
  if(pointers.has(e.pointerId)) pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(grabS){                                     // ⭐ 版をつかんで動かしている最中
    const sh = S_(); if(!sh){ grabS = null; return; }
    const q = toUV(e), fs = faceScale();
    /* 🔴 toUV は【面のスケールを外していない】（画面 NDC からビューだけを外した値）。
       面座標に直してから版の位置に足さないと、掴んだ点より絵が遅れてついてくる。
       ⚠️ 版の位置は /100 で面座標 -1..1 に入る＝UV差 ×2 ×100 ÷ 面スケール。 */
    sh.x = Math.round(grabS.x + (q.u - grabS.u) * 200 / Math.max(fs.x, 0.0001));
    sh.y = Math.round(grabS.y + (q.v - grabS.v) * 200 / Math.max(fs.y, 0.0001));
    syncGrabUI();                                // つまみの数字を実体に合わせる（ズラさない）
    return;
  }
  const r=canvas.getBoundingClientRect();
  if(viewMode==='pinch' && pinch0){
    const p=[...pointers.values()]; if(p.length<2) return;
    const d=Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y), cx=(p[0].x+p[1].x)/2, cy=(p[0].y+p[1].y)/2;
    VIEW.zoom=Math.max(0.3,Math.min(30, pinch0.zoom*d/pinch0.d));
    VIEW.panx=pinch0.panx + ((cx-pinch0.cx)/r.width)*2;
    VIEW.pany=pinch0.pany - ((cy-pinch0.cy)/r.height)*2; syncViewUI(); return;
  }
  if(viewMode==='rot' && rotStart){              // ±約63°に制限＝正投影でも読める範囲
    VIEW.roty=Math.max(-1.1,Math.min(1.1, rotStart.ry + (e.clientX-rotStart.x)/r.width*2.4));
    VIEW.rotx=Math.max(-1.1,Math.min(1.1, rotStart.rx - (e.clientY-rotStart.y)/r.height*2.4)); return;
  }
  if(viewMode==='pan' && panStart){
    VIEW.panx=panStart.px + ((e.clientX-panStart.x)/r.width)*2;
    VIEW.pany=panStart.py - ((e.clientY-panStart.y)/r.height)*2; syncViewUI(); return;
  }
  if(dragA<0) return;
  const p=toUV(e), a=ANCHORS[dragA];
  a.du=(p.u-a.u)*P.strength/100*2; a.dv=(p.v-a.v)*P.strength/100*2;
});
function endPtr(e){ pointers.delete(e.pointerId);
  grabS = null;
  if(pointers.size<2 && viewMode==='pinch'){ viewMode=null; pinch0=null; }
  if(pointers.size===0){ dragA=-1; viewMode=null; rotStart=panStart=null; } }
canvas.addEventListener('pointerup', endPtr);
canvas.addEventListener('pointercancel', endPtr);
canvas.addEventListener('wheel', e=>{ e.preventDefault();       // ホイール＝カーソル中心ズーム
  const f=e.deltaY<0?1.08:1/1.08, n=ndc(e), nz=Math.max(0.3,Math.min(30, VIEW.zoom*f));
  VIEW.panx=n.x-(n.x-VIEW.panx)*(nz/VIEW.zoom);
  VIEW.pany=n.y-(n.y-VIEW.pany)*(nz/VIEW.zoom);
  VIEW.zoom=nz; syncViewUI();
},{passive:false});
canvas.addEventListener('dblclick', ()=>{ VIEW.zoom=1; VIEW.panx=0; VIEW.pany=0; VIEW.rotx=0; VIEW.roty=0; syncViewUI(); });
// Safari：トラックパッドのピンチは wheel でなく gesture イベントで来る
let gScale=1;
canvas.addEventListener('gesturestart', e=>{ e.preventDefault(); gScale=VIEW.zoom; });
canvas.addEventListener('gesturechange', e=>{ e.preventDefault();
  VIEW.zoom=Math.max(0.3, Math.min(30, gScale*e.scale)); syncViewUI(); });
canvas.addEventListener('gestureend', e=>{ e.preventDefault(); });

/* ⭐ 粒の細かさ ── 【つまみの目盛り】と【実際のマス数】を分ける。
   ⚠️ 4〜200 をそのまま並べると、よく使う粗い側（4〜30）が左端の 15% に押し込まれて触れない。
   ⭐ 目盛り 0-100 を指数で写す＝粗い側が半分を占める。表示は必ず【実マス数】（数字は嘘をつかない）。
   ⚠️ 控え（JSON）に入るのは実マス数のまま＝古い控えもそのまま読める。 */
const grainFromSlider = t => t <= 0 ? 0 : Math.round(4 * Math.pow(50, t/100));
const grainToSlider   = g => (g < 4) ? 0 : Math.max(1, Math.min(100, Math.round(100 * Math.log(g/4) / Math.log(50))));
function syncGrainUI(){
  const el = document.getElementById('grain'); if(!el) return;
  el.value = grainToSlider(P.grain);
  const t = el.parentElement.querySelector('.val'); if(t) t.textContent = P.grain >= 4 ? P.grain : 'なし';
}

/* ── UI ── */
document.querySelectorAll('#panel input[type=range]').forEach(r=>{
  const val=r.parentElement.querySelector('.val');
  if(r.id.startsWith('L_')){                        // 3層スライダー＝【選んでいる版】の選択中の層に書く
    const key = r.id.slice(2);
    r.addEventListener('input', ()=>{
      const s = S_(); if(!s || !s.layers) return;
      s.layers[P.layer][key] = +r.value; if(val) val.textContent = r.value; });
    return;
  }
  /* ⭐ 色数は【選んでいる版】に書く（字の色も版の持ち物にしたので） */
  if(r.id === 'inkN' || r.id === 'stInkN'){
    r.addEventListener('input', ()=>{
      const sh = S_(); if(!sh) return;
      sh[r.id] = +r.value;
      if(val) val.textContent = r.value;
      syncInk();
    });
    return;
  }
  if(r.id === 'grain'){                             // ⭐ 目盛り→実マス数に写してから入れる
    r.addEventListener('input', ()=>{
      P.grain = grainFromSlider(+r.value);
      if(val) val.textContent = P.grain >= 4 ? P.grain : 'なし';
    });
