/* ⭐ 開幕の絵を、これまで（面が版の形だった頃）と同じ見え方に合わせる。
   ⚠️ 面を常に正方にしたので、放っておくと1枚目が小さく出る。起動のときだけ呼ぶ
     （あとで呼ぶと、木下が決めた大きさを勝手に上書きしてしまう）。 */
function fitFirstSheet(){
  const s = SHEETS[0]; if(!s) return;
  const view = canvas.width / Math.max(canvas.height, 1), A = s.asp || 1;
  const oldX  = (A > view) ? 0.8 : 0.8 * A / view;    // 従来の見え方
  const sxNow = 0.8 * (view > 1 ? 1/view : 1);
  const sizeX = A >= 1 ? 1 : A;
  const d = sxNow * sizeX;
  s.scale = d > 0.0001 ? oldX / d : 1;
}
document.querySelectorAll('#addSeg button').forEach(b=>{
  b.addEventListener('click', ()=>{
    if(b.dataset.add === 'text'){
      const s = newSheet('text', 'あたらしい');
      SHEETS.push(s); curSheet = SHEETS.length-1; selChar = -1;
