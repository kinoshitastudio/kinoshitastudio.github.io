(function(){
  const KEY='maku_lang'; const nodes=[], attrs=[];
  const walk = el => { for(const n of el.childNodes){
    if(n.nodeType===3){ const t=n.nodeValue.trim();
      if(t && I18N[t]!==undefined) nodes.push({n, jp:n.nodeValue, en:n.nodeValue.replace(t, I18N[t])}); }
    else if(n.nodeType===1 && !/^(SCRIPT|STYLE)$/.test(n.tagName)) walk(n); } };
  function collect(){ nodes.length=0; attrs.length=0;
    const pn=document.getElementById('panel'); if(pn) walk(pn);
    document.querySelectorAll('[title]').forEach(el=>{ const v=el.getAttribute('title');
      if(v && I18N[v.trim()]!==undefined) attrs.push({el, jp:v, en:I18N[v.trim()]}); }); }
  let cur='jp';
  function apply(l){ cur=l;
    nodes.forEach(o=>o.n.nodeValue = l==='en'?o.en:o.jp);
    attrs.forEach(o=>o.el.setAttribute('title', l==='en'?o.en:o.jp));
    const b=document.getElementById('langBtn'); if(b) b.textContent = l==='en'?'EN':'JP';
    try{ localStorage.setItem(KEY,l); }catch(e){} }
  collect();
  let saved='jp'; try{ saved=localStorage.getItem(KEY)||'jp'; }catch(e){}
  apply(saved);
  document.getElementById('langBtn')?.addEventListener('click', ()=>{
    const nx = cur==='en'?'jp':'en'; apply('jp'); collect(); apply(nx); });
})();

</script>
