/* ── 文字ごと（伸ばす/すぼめる）── */
const cwEl = document.getElementById('cw'), chEl = document.getElementById('ch'),
      crEl = document.getElementById('cr');
function refreshChars(){                       // bakeSheet のたびに呼ぶ
  const box = document.getElementById('chips');
  box.innerHTML = '';
  const S = S_(), CHARS = (S && S.kind === 'text') ? S.chars : [];
  CHARS.forEach(({ch,gi})=>{
    if(gi >= 32) return;                        // 上限32文字まで制御可
    const b = document.createElement('button');
    b.textContent = ch===' ' ? '␣' : (ch==='　' ? '□' : ch);
    b.onclick = ()=>selectChar(gi);
    if(gi===selChar) b.classList.add('on');
