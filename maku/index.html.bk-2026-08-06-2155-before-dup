  chEl.parentElement.querySelector('.val').textContent = '';
  crEl.parentElement.querySelector('.val').textContent = '';
}
function selectChar(gi){
  const S = S_(); if(!S || S.kind !== 'text') return;
  selChar = gi;
  const s = S.cscale[gi] || (S.cscale[gi]=[1,1]);
  if(S.crot[gi] === undefined) S.crot[gi] = 0;
