<script>
/* ═══════════════════════════════════════════════════════════
   膜 MAKU — 連続面メッシュ変形（研究サンドボックス）

   TSUBU のワープは「タイルごと」＝そのまま縦長になる。
   これは日本語を1枚のテクスチャに焼き、変形するグリッド面に貼る。
   → 面が連続して歪む（組んだタイポ全体を1枚の連続面として歪ませる仕組み）。

   ⭐ ここで「メッシュ変形」の技法を取りに行く。取れたらチェーンの
      1エンジンとして KUMI の3層や TSUBU の画の向きと干渉させる（＝先）。
   ═══════════════════════════════════════════════════════════ */

const DEFAULTS = { font:0, dir:0, layer:0, track:0, leading:0, vwarp:30, hwarp:0, freq:2, thick:0,
            wtop:0, wbot:0, hleft:0, hright:0,      // 辺ごとの 幅/高さ
            wmid:0, hmid:0,                         // 真ん中だけの 幅/高さ（つづみ・樽）
            shearx:0, sheary:0,                     // せん断
            twtop:0, twbot:0,                       // 上下で別のねじれ
            radius:30, strength:55, look:0, density:14, mesh:90, inkN:3,
            /* 地のグラデ ── 色数 1 ＝単色＝これまでと同じ地 */
            papN:1, papMode:0, papAng:90, papSteps:0, papCx:50, papCy:50 };
const P = { ...DEFAULTS };
/* ══ 版（重ねる）══════════════════════════════════════════════
   ⭐ 1枚の膜の上に、字や画像を何枚でも重ねる。
   ⭐ ワープ・アンカー・厚み・地・版面は【面のもの】＝どの版にも同じくかかる
      ＝重ねても「1枚の膜」であり続ける（版ごとに別の膜にはしない）。
   ⭐ 版が持つのは「何を」と「どこに・どの大きさ・どの角度で」だけ。
   ⚠️ 3層と文字ごとは【その版が字のとき】だけ効く（セル＝1文字が前提のため）。 */
let SHEETS = [];
let curSheet = 0;
const S_ = () => SHEETS[curSheet] || SHEETS[0];
/* 版面（書き出す大きさ）。⚠️ これも DEFAULTS に入れない＝全リセットで消さない（出力の設定だから） */
Object.assign(P, { frameOn:0, fshape:0, flong:2048 });
const ANCHORS = [];   // {u,v, du,dv} 面を押す点（面の座標と変位）
let selChar = -1;
const VIEW = { zoom:1, panx:0, pany:0, rotx:0, roty:0 };   // ビュー：ズーム＋パン＋傾き（正投影で3層を保つ）

/* ── 3層（漢字/かな/カナ/他）ごとのエンジン。値は UI 生値 -100..100 ── */
const LAYER_KEYS = ['w','h','rot','warp','dens','sang','soff'];
const newLayers = () => [0,1,2,3].map(()=>({w:0,h:0,rot:0,warp:0,dens:0,sang:0,soff:0}));
let LAYERS = newLayers();
// 開幕の絵：漢字は太く／かなは細くうねり／カナは傾ぐ（KUMI流＝開いた瞬間に3層が違って見える）
LAYERS[0].w = 14; LAYERS[0].h = 6;
LAYERS[1].w = -16; LAYERS[1].warp = 24;
LAYERS[2].rot = 16;
/* 字種を判定して層番号を返す */
function classify(ch){
  if(/[぀-ゟー]/.test(ch)) return 1;                     // ひらがな（長音符含む）
  if(/[゠-・ヽ-ヿｦ-ﾟ]/.test(ch)) return 2;  // カタカナ
  if(/[一-鿿㐀-䶿豈-﫿々〆〇ヶ]/.test(ch)) return 0; // 漢字
  return 3;                                                           // 英数・記号など
}

/* ── 字をテクスチャに焼く（版ごと）── */
const tc = document.createElement('canvas'), tg = tc.getContext('2d', { willReadFrequently:false });
function bakeSheet(s){
  if(!s || s.kind === 'image') return;
  const lines = (s.text || ' ').split('\n');
  // 1文字の基準px。字数が少ないほど高精細に焼く＝寄っても輪郭が壊れない
  // （GPUの最大テクスチャに収まる範囲で 1024→512→… と自動で落とす）
  const MAXT = gl ? gl.getParameter(gl.MAX_TEXTURE_SIZE) : 4096;
  // 組方向でグリッド配置を決める（gi = row*cols + col）
  let cols, rows; const cells = [];   // {ch, col, row}
  if(s.dir === 0){                                 // 横組み：行が上→下、字が左→右
    cols = Math.max(...lines.map(l=>[...l].length), 1);
    rows = lines.length;
    lines.forEach((line,r)=>{ [...line].forEach((ch,c)=> cells.push({ch, col:c, row:r})); });
  } else {                                         // 縦組み：字が上→下、行が右→左
    rows = Math.max(...lines.map(l=>[...l].length), 1);
    cols = lines.length;
    lines.forEach((line,li)=>{ const col = cols-1-li; [...line].forEach((ch,ci)=> cells.push({ch, col, row:ci})); });
  }
  s.cols = cols; s.rows = rows;
  const tkS = 1 + Math.max(0, s.track/100), ldS = 1 + Math.max(0, s.leading/100);
  let S = 1024;
  while((cols * S * tkS > MAXT || rows * S * ldS > MAXT) && S > 128) S /= 2;
  // 文字ごと制御用：グリッド・文字リスト・層を更新（既存の伸縮値は番号ごとに引き継ぐ）
  s.chars = []; s.ctype = [];
  cells.forEach(({ch,col,row})=>{ const gi = row*cols + col; s.chars.push({ ch, gi }); s.ctype[gi] = classify(ch); });
  const keep = (s.cscale||[]).slice(), keepR = (s.crot||[]).slice();
  s.cscale = []; s.crot = [];
  for(let i=0;i<Math.min(cols*rows,32);i++){ s.cscale.push(keep[i] || [1,1]); s.crot.push(keepR[i] || 0); }
  selChar = -1;
  // 字間・行間＝セルの寸法そのものを伸縮する（字の大きさは変えない）
  // 横組みは 字間→横／行間→縦、縦組みは逆にかかる
  const tk = s.track/100, ld = s.leading/100;
  const cw = S * (1 + (s.dir === 0 ? tk : ld));    // セル幅
  const chh= S * (1 + (s.dir === 0 ? ld : tk));    // セル高
  tc.width  = Math.max(Math.round(cols * cw), 8);
  tc.height = Math.max(Math.round(rows * chh), 8);
  tg.fillStyle = '#000'; tg.fillRect(0,0,tc.width,tc.height);
  tg.fillStyle = '#fff';
  tg.textAlign = 'center'; tg.textBaseline = 'middle';
  const fam = s.font ? '"Zen Old Mincho"' : '"Zen Kaku Gothic New"';
  tg.font = `900 ${S*0.86}px ${fam}, sans-serif`;
  cells.forEach(({ch,col,row}) => tg.fillText(ch, col*cw + cw/2, row*chh + chh/2 + S*0.02));
  s.asp = tc.width / tc.height;
  if(gl && s.tex){
    gl.bindTexture(gl.TEXTURE_2D, s.tex);
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);   // canvas と WebGL の上下を合わせる
    // ⭐ RGBA で焼く＝同じテクスチャに画像も通せる（字は黒地に白なので .r はこれまで通り読める）
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, tc);
  }
  if(s === S_()) refreshChars();
}

/* ── WebGL ── */
const canvas = document.getElementById('gl');
const gl = canvas.getContext('webgl', { antialias:true, preserveDrawingBuffer:true });
gl.getExtension('OES_standard_derivatives');      // fwidth＝輪郭を寄っても滑らかに保つ
gl.enable(gl.BLEND);
gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

/* ⭐ グラデの式は【ひとつだけ】書いて、地（紙）と字（インク）で使い回す。
   ⚠️ 別プログラムなので uniform は共有できないが、式が2本に割れると必ず片方だけ直す事故になる。
   ⭐ 形（流す/中心/渦/まわり・向き・版数・中心）は地と字で【同じ版】を使う＝刷りの考え方。
      色数と色だけ別に持つ（＝リソグラフの多色刷り）。 */
const PAPER_GLSL = (fn, c) => `
  vec3 ${fn}Pick(float i, vec3 c0){
    if(i < 0.5) return ${c}0;
    if(i < 1.5) return ${c}1;
    if(i < 2.5) return ${c}2;
    if(i < 3.5) return ${c}3;
    if(i < 4.5) return ${c}4;
    return ${c}5;
  }
  float ${fn}Bayer(vec2 p){
    vec2 cc = mod(floor(p), 4.0);
    float i = cc.y * 4.0 + cc.x;
    float b = 0.0;
    if(i<0.5)b=0.0;      else if(i<1.5)b=8.0;  else if(i<2.5)b=2.0;  else if(i<3.5)b=10.0;
    else if(i<4.5)b=12.0;else if(i<5.5)b=4.0;  else if(i<6.5)b=14.0; else if(i<7.5)b=6.0;
    else if(i<8.5)b=3.0; else if(i<9.5)b=11.0; else if(i<10.5)b=1.0; else if(i<11.5)b=9.0;
    else if(i<12.5)b=15.0;else if(i<13.5)b=7.0;else if(i<14.5)b=13.0;else b=5.0;
    return b / 16.0;
  }
  vec3 ${fn}At(vec2 uv, vec3 c0, float n, float asp){
    if(n < 1.5) return c0;                                   // 1色＝今までと完全に同じ
    /* ⭐ 形＝別の模様を4つ作るのではなく、同じグラデを どの座標に流すか だけ差し替える */
    vec2  q   = (uv - vec2(uPapCx, uPapCy)) * vec2(asp, 1.0);
    float rad = length(q) / 0.72;
    float ang = atan(q.y, q.x) / 6.2831853;
    float t;
    if(uPapMode < 0.5){
      float a = radians(uPapAng);
      vec2  d = vec2(cos(a), sin(a));
      vec2  pp = (uv - 0.5) * vec2(asp, 1.0);
      float w = 0.5 * (abs(d.x) * asp + abs(d.y));
      t = dot(pp, d) / max(w, 0.0001) * 0.5 + 0.5;
    }else if(uPapMode < 1.5){
      t = rad;
    }else if(uPapMode < 2.5){
      t = fract(rad + ang * (uPapAng / 90.0));                // 渦（ねじれは向きのつまみを使い回す）
    }else{
      t = fract(ang + 0.5 + uPapAng / 360.0);                 // まわり
    }
    t = clamp(t, 0.0, 1.0);
    if(uPapSteps > 1.5){
      float st = floor(uPapSteps);
      t = clamp(floor(t * (st - 1.0) + (${fn}Bayer(uv * uRes) - 0.5) + 0.5) / (st - 1.0), 0.0, 1.0);
    }
    /* ⚠️ 渦・まわりは一周するので、色を環にしないと継ぎ目が1本出る */
    float ring = (uPapMode > 1.5) ? 1.0 : 0.0;
    float span = mix(n - 1.0, n, ring);
    float sc = t * span;
    float i  = floor(sc);
    float ia = mix(i,       mod(i,       n), ring);
    float ib = mix(i + 1.0, mod(i + 1.0, n), ring);
    return mix(${fn}Pick(ia, c0), ${fn}Pick(ib, c0), sc - i);
  }
`;

const VERT = `
  attribute vec2 aUV;
  uniform vec2 uScale;      // アスペクト補正
  uniform float uZoom;      // ビュー：ズーム
  uniform vec2 uPan;        // ビュー：パン（NDC単位）
  uniform float uRotX, uRotY; // ビュー：傾き（正投影）
  uniform float uThick;       // 面の厚み（z方向の起伏）
  uniform vec2 uSheetSize;    // 版（重ねる1枚）の矩形＝面座標での半サイズ
  uniform vec2 uSheetPos;     // 版の中心（面座標）
  uniform float uSheetScale, uSheetRot;
  uniform float uVWarp, uHWarp, uFreq, uTime;
  uniform float uWTop, uWBot, uHLeft, uHRight, uShearX, uShearY, uTwTop, uTwBot;
  uniform float uWMid, uHMid;         // 真ん中だけを膨らませる／くびれさせる
  uniform vec2 uAnchorUV[24];
  uniform vec2 uAnchorD[24];
  uniform float uAnchorR;
  uniform int uAnchorN;
  uniform vec2 uCharScale[32];        // 文字ごとの [sx, sy]
  uniform float uCharRot[32];         // 文字ごとの角度（rad・セル中心まわり）
  uniform float uCharType[32];        // 文字ごとの層（0漢字/1かな/2カナ/3他）
  uniform float uGridCols, uGridRows; // テクスチャの文字グリッド
  uniform int uCharN;
  uniform float uLW[4], uLH[4], uLRot[4], uLWarp[4], uLDens[4]; // 層ごとのエンジン
  uniform float uLSAng[4], uLSOff[4];          // 層ごとの縞：角度・位置
  varying vec2 vUV;
  varying float vDens;
  varying float vSAng, vSOff;                   // 縞の角度・位置を面に渡す
  void main(){
    vUV = aUV;

    // ⓪ 文字ごとの伸縮＋3層 — aUV からセル（1文字）を逆算。そのセルが
    //    どの字種（層）かで、別々のうねり/傾ぎ/太さをセル中心まわりに効かせる。
    //    セル内で完結するので連続面（膜全体のうねり）は壊れず、3層が別速度で流れる。
    float ccol  = floor(aUV.x * uGridCols);
    float crowB = floor(aUV.y * uGridRows);                        // 0=下
    int cidx = int((uGridRows - 1.0 - crowB) * uGridCols + ccol);  // 読み順（左上=0, 行優先）
    vec2 scl = vec2(1.0);
    float crot = 0.0;                                              // 文字ごとの角度
    int ctype = 3;
    for(int i=0;i<32;i++){ if(i>=uCharN) break; if(i==cidx){ scl = uCharScale[i]; crot = uCharRot[i]; ctype = int(uCharType[i]); break; } }
    // 層のエンジン値を取り出す
    float lw=0.0, lh=0.0, lrot=0.0, lwarp=0.0, ldens=0.0, lsang=0.0, lsoff=0.0;
    for(int i=0;i<4;i++){ if(i==ctype){ lw=uLW[i]; lh=uLH[i]; lrot=uLRot[i]; lwarp=uLWarp[i]; ldens=uLDens[i]; lsang=uLSAng[i]; lsoff=uLSOff[i]; break; } }
    vDens = 1.0 + ldens;
    vSAng = lsang; vSOff = lsoff;

    vec2 cc  = (vec2(ccol, crowB) + 0.5) / vec2(uGridCols, uGridRows);
    vec2 rel = (aUV - cc) * scl * vec2(1.0 + lw, 1.0 + lh);   // 文字ごと伸縮 × 層の太らせ/縦のび
    float fy = (aUV.y - cc.y) * uGridRows;                    // セル内 縦位置 -0.5..0.5
    rel.x += cos(fy * 6.2831853) * lwarp;                     // 層のうねり（字の中でS字に）
    // 層の傾ぎ ＋ その字だけの角度（どちらもセル中心まわり）
    // ⚠️ UV 空間のまま回すと、セルが正方でないぶん字が潰れる（1行6列なら 6:1 に歪む）。
    //    ⭐ セル内の正方座標に直してから回して、戻す＝その場でまっすぐ回る。
    float rc = cos(lrot + crot), rs = sin(lrot + crot);
    vec2 cn = vec2(uGridCols, uGridRows);
    vec2 rn = rel * cn;
    rn  = vec2(rn.x*rc - rn.y*rs, rn.x*rs + rn.y*rc);
    rel = rn / cn;
    vec2 puv = cc + rel;

    vec2 p = puv * 2.0 - 1.0;             // -1..1

    /* ⭐ 版（重ねる）── この版を面のどこに、どの大きさ・角度で置くか。 */
    p *= uSheetSize * uSheetScale;
    float shc = cos(uSheetRot), shs = sin(uSheetRot);
    p = vec2(p.x*shc - p.y*shs, p.x*shs + p.y*shc);
    p += uSheetPos;

    /* ⭐⭐ 座標の使い分け ── ここが要。
       ・うねり／アンカー＝【面の座標 t2】＝どの版も同じ波に乗る＝重ねても1枚の膜
       ・辺ごと（上幅・中幅…）／せん断／ねじれ＝【版の座標 lx,ly】＝その版の形を整える
       🔴 全部を面の座標にしたら、字は面の中の薄い帯なので
         「上下が広がる」が字に出ない（木下＝2026-08-03「中が細くなり上と下が広くなる」）。 */
    vec2 t2 = p * 0.5 + 0.5;
    float tx = t2.x, ty = t2.y;   // 面の座標（0..1）
    float lx = aUV.x, ly = aUV.y; // 版の座標（0..1・tyは下0上1）

    // ① うねり（左右対称の波）— 砂時計はここ
    p.x *= 1.0 + cos(ty * 6.2831853 * uFreq) * uVWarp;
    p.y *= 1.0 + cos(tx * 6.2831853 * uFreq) * uHWarp;

    // ② 辺ごとの幅/高さ — 上下・左右を独立して広げる/すぼめる（⚠️ 版の座標で効かせる）
    /* ⭐ 中幅・中高 ── 木下＝「中が細くなり、上と下が広くなるのができないか」。
       ⭐ 中央と端を【逆に】動かす＝−でつづみ（中がくびれて上下が広がる）／＋で樽。
         中央だけ動かす式にすると、上下は動かないので「つづみ」に見えない。
       ⚠️ 中0なら 0 が掛かるだけ＝これまでと完全に同じ。 */
    float bumpY = 2.0 * (4.0 * ly * (1.0 - ly)) - 1.0;   // 端 -1 → 中央 +1
    float bumpX = 2.0 * (4.0 * lx * (1.0 - lx)) - 1.0;
    p.x *= mix(1.0 + uWBot, 1.0 + uWTop, ly) + uWMid * bumpY;    // 上幅 / 中幅 / 下幅
    p.y *= mix(1.0 + uHLeft, 1.0 + uHRight, lx) + uHMid * bumpX; // 左高 / 中高 / 右高

    // ③ せん断（傾け）
    p.x += (ly - 0.5) * uShearX;
    p.y += (lx - 0.5) * uShearY;

    // ④ ねじれ — 上と下で別の角度、縦に沿って補間
    float ang = mix(uTwBot, uTwTop, ly);
    float c = cos(ang), s = sin(ang);
    p = vec2(p.x*c - p.y*s, p.x*s + p.y*c);

    // アンカー — 面を局所的に引っぱる（連続的に減衰）
    for(int i=0;i<24;i++){
      if(i>=uAnchorN) break;
      float d = distance(t2, uAnchorUV[i]);      // ⚠️ 面座標で測る（版ごとでなく面を押す）
      float w = exp(-d*d/(uAnchorR*uAnchorR));
      p += uAnchorD[i] * w * 2.0;
    }

    // 厚み：面を z 方向に起伏させる（傾けると奥行きが見える＝連続面が空間で波打つ）
    float relief = (cos(ty*6.2831853*uFreq) + cos(tx*6.2831853*uFreq)) * 0.5;
    // ビュー：正投影のまま傾ける（遠近なし＝3層が読めたまま角度がつく）＋ズーム＋パン
    vec3 q = vec3(p * uScale, relief * uThick);
    float rcx = cos(uRotX), rsx = sin(uRotX), rcy = cos(uRotY), rsy = sin(uRotY);
    q = vec3(rcy*q.x + rsy*q.z, q.y, -rsy*q.x + rcy*q.z);   // Y軸まわり
    q = vec3(q.x, rcx*q.y - rsx*q.z, rsx*q.y + rcx*q.z);    // X軸まわり
    gl_Position = vec4(q.xy * uZoom + uPan, 0.0, 1.0);
  }
`;
const FRAG = `
  #extension GL_OES_standard_derivatives : enable
  precision highp float;
  uniform sampler2D uTex;
  uniform int uLook;
  uniform int uSrc;                             // 0=字（形のマスク）／1=画像（色もそのまま）
  uniform float uDensity;
  uniform vec2 uRes;
  /* ⭐ 字のインク＝地とまったく同じグラデの式。色数と色だけ字用に持ち、
     形（流す/渦・向き・版数・中心）は地と【同じ版】を共有する＝多色刷り。 */
  uniform vec3 uInk0, uInk1, uInk2, uInk3, uInk4, uInk5;
  uniform float uInkN, uPapMode, uPapAng, uPapSteps, uPapCx, uPapCy;
  varying vec2 vUV;
  varying float vDens;                          // 層ごとの縞密度倍率
  varying float vSAng, vSOff;                   // 層ごとの縞：角度・位置
  ${PAPER_GLSL('ink','uInk')}
  void main(){
    vec4 t4 = texture2D(uTex, vUV);
    // ⭐ 画像を読み込んだときは、色をそのまま出して【連続面の変形だけ】をかける。
    //    粒 TSUBU・礫 TSUBUTE・彫 HORI で作った絵を、ここで歪ませるための道。
    if(uSrc == 1){
      if(t4.a < 0.004) discard;                 // 透明PNGは透明のまま（地が透ける）
      gl_FragColor = t4;
      return;
    }
    float m = t4.r;                             // 字の内側=1
    // 輪郭のアンチエイリアス — 画面上の傾きから境界の幅を求めるので、
    // 寄っても（ズームしても）常に 1px 相当の滑らかさになる
    float w = fwidth(m);
    float a = smoothstep(0.5 - w, 0.5 + w, m);
    if(a < 0.004) discard;                      // 完全に外側だけ捨てる
    float dens = uDensity * vDens;

    // 縞の走る向きを面の中心まわりで回す（角度0＝従来どおり水平／±90°で垂直）
    float ca = cos(vSAng), sa = sin(vSAng);
    vec2 q = vUV - 0.5;
    float dY = (q.x * sa + q.y * ca) + 0.5 + vSOff;   // 角度0 → vUV.y と一致
    float dX = (q.x * ca - q.y * sa) + 0.5 + vSOff;   // 角度0 → vUV.x と一致

    vec3 col;
    if(uLook == 0){
      // 金属 — 縞は面（vUV）に沿って流れる＝メッシュを歪めると縞も一緒にうねる
      float g = 0.5 + 0.5 * sin(dY * dens * 6.2831853);
      g = pow(g, 0.6);
      col = vec3(g);
    } else if(uLook == 1){
      col = vec3(0.04);                         // 墨
    } else if(uLook == 2){
      float g = step(0.5, fract(dX * dens));     // 線も面に沿う
      col = vec3(g);
    } else {
      /* ⭐ 刷り ── 字の中を、地と同じ版のグラデで塗る。色数 1 なら墨のまま。
         ⚠️ 字の濃さ（m）でグラデを引くと、字の内側はほぼ一定なのでベタ塗りになる。
            【位置で引く】のが正しい（組 KUMI で分かったこと）。
         ⭐ 面の UV で引く＝膜が歪むとグラデも一緒に歪む＝字そのものに色が乗る。 */
      col = inkAt(vUV, vec3(0.04), uInkN, 1.0);
    }
    gl_FragColor = vec4(col, a);
  }
`;
