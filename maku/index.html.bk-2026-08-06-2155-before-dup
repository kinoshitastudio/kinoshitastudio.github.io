};

/* ── 全リセット：全パラメータ＋アンカー＋文字ごと伸縮を初期値へ（字はそのまま）── */
function resetAll(){
  Object.assign(P, DEFAULTS);
  ANCHORS.length = 0;
  // 文字ごとの伸縮・角度は全部の版で戻す。
  // ⚠️ 版そのもの・置き場所・読み込んだ画像は消さない（素材だから＝字を消さないのと同じ）
  SHEETS.forEach(s=>{
    for(let i=0;i<s.cscale.length;i++) s.cscale[i] = [1,1];
    for(let i=0;i<s.crot.length;i++) s.crot[i] = 0;
  });
  LAYERS = newLayers();
  VIEW.zoom=1; VIEW.panx=0; VIEW.pany=0; VIEW.rotx=0; VIEW.roty=0;
  selChar = -1;
  document.querySelectorAll('#panel input[type=range]').forEach(r=>{
    if(r.id.startsWith('L_')) return;              // 層スライダーは syncLayerUI で戻す
    if(P[r.id] !== undefined) r.value = P[r.id];
    const v = r.parentElement.querySelector('.val'); if(v) v.textContent = r.value;
  });
  document.querySelectorAll('#panel .seg').forEach(seg=>{
    seg.querySelectorAll('button').forEach(b=>b.classList.toggle('on', +b.dataset.v === P[seg.id]));
  });
  syncLayerUI();
  syncGrad(); syncInk();                            // 地は色数1（単色）に戻る。⚠️選んだ色は残す
  P.fitz = 100; P.fitx = 0; P.fity = 0; syncViewUI();   // 絵の大きさ・位置も戻す（VIEW を戻したので合わせる）
  buildMesh();
  refreshSheets();                                  // 版のつまみ表示も選んでいる版に合わせ直す
}
document.getElementById('resetAll').onclick = resetAll;
document.getElementById('reset').onclick=()=>ANCHORS.length=0;
/* ══ 版面（書き出す大きさ）══ 礫 TSUBUTE の「FRAME」と同じ型を持ってきた。
   ⭐ ここは【画面の canvas そのものを版面の形にする】＝見えているものがそのまま出る。
      枠だけ描いて中身は画面のまま、にすると「見えている絵」と「出る絵」がズレる。 */
const FSHAPE = [[1,1],[4,5],[16,9],[9,16]];
function frameRatio(){ return FSHAPE[P.fshape|0] || FSHAPE[0]; }
function frameSize(){
  const [rw,rh] = frameRatio();
  const L = Math.round(P.flong);
  let w, h;
  if(rw >= rh){ w = L; h = Math.round(L*rh/rw); } else { h = L; w = Math.round(L*rw/rh); }
  /* ⚠️ 端末の上限を超えると【何も出ない】。黙って壊れず、上限まで下げて、当たったことを出す */
  const lim = Math.min(gl.getParameter(gl.MAX_RENDERBUFFER_SIZE) || 4096, 8192);
  let cap = false;
  if(w > lim || h > lim){ const k = Math.min(lim/w, lim/h); w = Math.floor(w*k); h = Math.floor(h*k); cap = true; }
  return { w, h, cap };
}
function layoutCanvas(){
  const on = P.frameOn === 1;
  document.body.classList.toggle('framed', on);
  if(!on){ canvas.removeAttribute('style'); resize(); updateOut(); return; }
  const mobile = innerWidth <= 760;
  const availW = mobile ? innerWidth : Math.max(innerWidth - 262, 200);   // 右のパネルを避ける
  const availH = mobile ? innerHeight*0.58 : innerHeight;
  const [rw,rh] = frameRatio();
  const k = Math.min(availW*0.9/rw, availH*0.9/rh);
  const w = Math.round(rw*k), h = Math.round(rh*k);
  canvas.style.width = w+'px'; canvas.style.height = h+'px';
  canvas.style.left  = Math.round((availW-w)/2)+'px';
  canvas.style.top   = Math.round((availH-h)/2)+'px';
  canvas.style.right = 'auto'; canvas.style.bottom = 'auto';
  resize(); updateOut();
}
function updateOut(){
  const n = document.getElementById('fout'); if(!n) return;
  if(P.frameOn !== 1){ n.innerHTML = `画面のまま ＝ <b>${canvas.width} × ${canvas.height} px</b>`; return; }
  const f = frameSize();
  n.innerHTML = `出る大きさ ＝ <b>${f.w} × ${f.h} px</b>`
    + (f.cap ? '<br>⚠️ この端末の上限に当たったので下げた' : '');
}
/* ⭐ 版面の大きさで刷る。⚠️ 終わったら必ず元へ戻す */
function renderToBlob(cb, noBg){
  /* ⚠️ 地なしのときも【一度描き直してから】撮る。撮ってから消しても手遅れ */
  if(P.frameOn !== 1){
    if(noBg){ noBgOnce = true; render(lastT); }
    canvas.toBlob(b => { noBgOnce = false; render(lastT); cb(b); }, 'image/png');
    return;
  }
  const f = frameSize();
  const kw = canvas.width, kh = canvas.height;
  try{
    canvas.width = f.w; canvas.height = f.h;
    noBgOnce = !!noBg; render(lastT);
    canvas.toBlob(b => { noBgOnce = false; cb(b); }, 'image/png');
  } finally {
    noBgOnce = false;
    canvas.width = kw; canvas.height = kh;
    render(lastT);
  }
}
/* ⚠️ iOS は DOM に入れていない <a> の click を無視する／巨大な dataURL で落ちる（礫と同じ作法） */
function savePNG(noBg){ renderToBlob(blob=>{
  if(!blob) return;
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `maku_${Date.now()}.png`;
  document.body.appendChild(a); a.click(); a.remove();
  if(/iP(hone|ad|od)/.test(navigator.userAgent)) window.open(url, '_blank');
  setTimeout(()=>URL.revokeObjectURL(url), 8000);
}, noBg); }
document.getElementById('png').onclick     = ()=> savePNG(false);
document.getElementById('pngA').onclick    = ()=> { savePNG(true); stat('地なしで出した（重ねられる）'); };

/* ══ 地のグラデ ── 使う色数のぶんだけ出す（触れるのに何も起きないつまみを残さない）══ */
function syncGrad(){
  const n = Math.max(1, Math.round(P.papN));
  document.body.classList.toggle('grad', n > 1);
  for(let k=3;k<=6;k++) document.body.classList.toggle('grad-'+k, n >= k);
}
/* ⚠️⚠️ 色は data-pc で持つ。既存の input[data-p]/id のループは `+r.value` で数値にするので、
   色ピッカーに id を付けると "#f2d16b" が NaN になって壊れる。 */
document.querySelectorAll('input[type=color][data-pc]').forEach(c=>{
  c.addEventListener('input', ()=>{ PAPC[+c.dataset.pc] = c.value; });
});
syncGrad();

/* ══ 刷り（字のインク）══ 見えが「刷り」のときだけ字の色を出す。
   ⚠️ 密度は縞（金属・線）のつまみ＝墨と刷りでは何も起きないので同時に畳む。 */
function syncInk(){
  const n = Math.max(1, Math.round(P.inkN));
  document.body.classList.toggle('look-ink', P.look === 3);
  document.body.classList.toggle('look-stripe', P.look === 0 || P.look === 2);
  for(let k=2;k<=6;k++) document.body.classList.toggle('ink-'+k, n >= k);
}
document.querySelectorAll('input[type=color][data-ic]').forEach(c=>{
  c.addEventListener('input', ()=>{ INKC[+c.dataset.ic] = c.value; });
});
syncInk();

/* ══ 元 ── 画像を読み込んで、色はそのままに【連続面の変形だけ】をかける ══
   ⭐ 粒 TSUBU・礫 TSUBUTE・彫 HORI で出した絵を、ここで歪ませる＝チェーンが繋がる。 */
const imgFile = document.getElementById('imgFile');
/* パネルを見出し（h2）で節に切っておく＝節ごと出し入れするため。
   ⚠️ 見出しのテキストで引く。日本語/English の切替は要素の中身を書き換えるだけなので、
      ここで作った参照（キーは日本語）はそのまま使える。 */
const SECT = {};
(function(){ let cur=null;
  [...document.getElementById('panel').children].forEach(el=>{
    if(el.tagName === 'H2'){ cur = el.textContent.trim(); SECT[cur] = [el]; }
    else if(cur) SECT[cur].push(el);
  });
})();
/* ⚠️ 画像の版では効かない節を畳む（3層・文字ごとは「セル＝1文字」が前提） */
function foldForKind(kind){
  ['字','3層（漢字・かな・カナ）','文字ごと（伸ばす／すぼめる）'].forEach(name=>{
    (SECT[name]||[]).forEach(el=> el.style.display = (kind === 'image' ? 'none' : ''));
  });
}
/* ⭐ 画像は【新しい版】として足す。字の版はそのまま残る＝重ねられる */
function addImageSheet(img){
  const s = newSheet('image');
  s.img = img; s.asp = img.width / img.height;
  gl.bindTexture(gl.TEXTURE_2D, s.tex);
  gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);     // ⚠️ canvas と WebGL で上下が逆
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
  SHEETS.push(s); curSheet = SHEETS.length-1; selChar = -1;
  refreshSheets();
  const st = document.getElementById('stat');
  if(st) st.textContent = `IMAGE ${img.width}×${img.height}`;
}
function loadImageFile(f){
  if(!f) return;
  const img = new Image();
  img.onload = ()=> addImageSheet(img);
  img.onerror = ()=>{ const st=document.getElementById('stat'); if(st) st.textContent='画像を読めなかった'; };
  img.src = URL.createObjectURL(f);
}
imgFile.addEventListener('change', e=>{ loadImageFile(e.target.files[0]); imgFile.value=''; });

/* 画像も控え（JSON）もドラッグ＆ドロップで読める */
addEventListener('dragover', e=> e.preventDefault());
addEventListener('drop', e=>{
  e.preventDefault();
  const files = [...(e.dataTransfer?.files||[])];
  const j = files.find(x=>/\.json$/i.test(x.name) || x.type === 'application/json');
  if(j){ loadJSONFile(j); return; }
  const f = files.find(x=>/^image\//.test(x.type));
  if(f) loadImageFile(f);
});

/* ══ 控え（保存・読み込み）＋ 戻す（⌘Z）══════════════════════════
   ⭐ 道具の状態はコミットでは守れない。【戻す】と【持ち出す】は道具の側に要る。
   ⚠️ 戻す用のスナップショットに画像は入れない（重いうえ、戻しても画像そのものは変わらないから）。
      保存する JSON には入れる＝そのまま開き直せる。 */
const stat = m => { const s = document.getElementById('stat'); if(s) s.textContent = m; };
/* ⭐ 版1枚ぶんを控えにする。⚠️ 画像は重いので、戻す用（withImage=false）には入れない
   ── そのぶんは Image オブジェクトを別に持ち回して引き継ぐ。 */
function sheetToJSON(s, withImage){
  const o = { kind:s.kind, text:s.text, font:s.font, dir:s.dir, track:s.track, leading:s.leading,
              x:s.x, y:s.y, scale:s.scale, rot:s.rot, asp:s.asp,
              cscale:(s.cscale||[]).map(a=>[a[0], a[1]]), crot:[...(s.crot||[])] };
  if(withImage && s.kind === 'image' && s.img){
    const c = document.createElement('canvas');
    c.width  = s.img.naturalWidth  || s.img.width;
    c.height = s.img.naturalHeight || s.img.height;
    c.getContext('2d').drawImage(s.img, 0, 0);
    o.image = c.toDataURL('image/png');   // ⚠️ PNG＝透明を保つ（JPEG にすると透明が黒くなる）
  }
  return o;
}
function stateToJSON(withImage){
  return {
    v: 2,
    P: { ...P },
    PAPC: [...PAPC], INKC: [...INKC],
    LAYERS: LAYERS.map(L=>({ ...L })),
    ANCHORS: ANCHORS.map(a=>({ ...a })),
    VIEW: { ...VIEW },
    cur: curSheet,
    sheets: SHEETS.map(s=>sheetToJSON(s, withImage)),
  };
}
/* 画像を版のテクスチャに載せる（読み込みと控えの復元で同じ道を通す） */
function uploadImg(s, img){
  s.img = img; s.asp = img.width / img.height;
  gl.bindTexture(gl.TEXTURE_2D, s.tex);
  gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
}
function applyState(o, done, imgs){
  if(!o) return;
  Object.assign(P, o.P || {});
  if(o.PAPC) PAPC = [...o.PAPC];
  if(o.INKC) INKC = [...o.INKC];
  if(o.LAYERS) LAYERS = o.LAYERS.map(L=>({ ...L }));
  ANCHORS.length = 0; (o.ANCHORS||[]).forEach(a=>ANCHORS.push({ ...a }));
  Object.assign(VIEW, o.VIEW || {});
  // つまみ・切替・色の見た目を実体に合わせる（数字と実体をズラさない）
  document.querySelectorAll('#panel input[type=range]').forEach(r=>{
    if(r.id.startsWith('L_')) return;                 // 層のつまみは syncLayerUI で入れ直す
    if(P[r.id] !== undefined) r.value = P[r.id];
    const v = r.parentElement.querySelector('.val'); if(v) v.textContent = r.value;
  });
  document.querySelectorAll('#panel .seg').forEach(seg=>{
    seg.querySelectorAll('button').forEach(b=>{
      if(b.dataset.v === undefined) return;
      b.classList.toggle('on', +b.dataset.v === P[seg.id]);
    });
  });
  document.querySelectorAll('input[type=color][data-pc]').forEach(c=>{ if(PAPC[+c.dataset.pc]) c.value = PAPC[+c.dataset.pc]; });
  document.querySelectorAll('input[type=color][data-ic]').forEach(c=>{ if(INKC[+c.dataset.ic]) c.value = INKC[+c.dataset.ic]; });
  selChar = -1;
  syncLayerUI(); syncGrad(); syncInk(); syncViewUI(); buildMesh(); layoutCanvas();

  /* ⭐ 版を作り直す。⚠️ 古い控え（v1＝版が無かった頃）も読めるようにしておく */
  const list = o.sheets || [{
    kind: o.img ? 'image' : 'text', text: o.text, font: (o.P&&o.P.font)||0, dir: (o.P&&o.P.dir)||0,
    track: (o.P&&o.P.track)||0, leading: (o.P&&o.P.leading)||0,
    x:0, y:0, scale:1, rot:0, cscale:o.cscale, crot:o.crot, image:o.image,
  }];
  SHEETS.forEach(s=>{ if(s.tex) gl.deleteTexture(s.tex); });
  SHEETS = [];
  let pending = 0, called = false;
  const finish = ()=>{
    if(pending > 0 || called) return;
    called = true;
    curSheet = Math.max(0, Math.min(o.cur||0, SHEETS.length-1));
    if(!o.sheets) fitFirstSheet();                   // ⚠️ 古い控えは面の規則が違うので合わせ直す
    refreshSheets();
    if(typeof done === 'function') done();
  };
  list.forEach((d, i)=>{
    const s = newSheet(d.kind || 'text', d.text);
    Object.assign(s, {
      font:d.font||0, dir:d.dir||0, track:d.track||0, leading:d.leading||0,
      x:d.x||0, y:d.y||0, scale:(d.scale != null ? d.scale : 1), rot:d.rot||0,
      cscale:(d.cscale||[]).map(a=>[a[0], a[1]]), crot:[...(d.crot||[])],
    });
    SHEETS.push(s);
    if((d.kind||'text') === 'image'){
      const keep = imgs && imgs[i];
      if(d.image){
        pending++;
        const img = new Image();
        img.onload  = ()=>{ uploadImg(s, img); pending--; finish(); };
        img.onerror = ()=>{ pending--; finish(); };
        img.src = d.image;
      } else if(keep){ uploadImg(s, keep); }         // ⭐ 戻す（⌘Z）では画像そのものを引き継ぐ
      else if(d.asp) s.asp = d.asp;
    } else {
      bakeSheet(s);
    }
  });
  finish();
}
async function saveJSON(){
  const data = JSON.stringify(stateToJSON(true));
  const name = `maku_${Date.now()}.json`;
  try{
    if(window.showSaveFilePicker){
      const h = await showSaveFilePicker({ suggestedName:name,
        types:[{ description:'膜 MAKU の控え', accept:{ 'application/json':['.json'] } }] });
      const w = await h.createWritable(); await w.write(data); await w.close();
      stat('控えを保存した'); return;
    }
  }catch(err){ if(err && err.name === 'AbortError') return; }   // ⚠️ キャンセルは失敗ではない
  const blob = new Blob([data], { type:'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 8000);
  stat('控えを保存した');
}
function loadJSONFile(f){
  if(!f) return;
  const rd = new FileReader();
  rd.onload = ()=>{
    try{ snap(); applyState(JSON.parse(rd.result), ()=>stat('控えを読み込んだ')); }
    catch(err){ stat('この JSON は読めなかった'); }
  };
  rd.readAsText(f);
}
document.getElementById('saveJson').onclick = saveJSON;
document.getElementById('loadJson').onclick = ()=> document.getElementById('jsonFile').click();
document.getElementById('jsonFile').addEventListener('change', e=>{
  loadJSONFile(e.target.files[0]); e.target.value = '';
});

/* ── 戻す／やり直す ── */
const UNDO = [], REDO = [];
/* ⚠️ 控えの JSON には画像を入れない（重い）ので、戻すときのために
   Image オブジェクトそのものを一緒に持ち回す。 */
function snapObj(){ return { j: JSON.stringify(stateToJSON(false)), imgs: SHEETS.map(s=>s.img||null) }; }
function snap(){
  const o = snapObj();
  if(UNDO.length && UNDO[UNDO.length-1].j === o.j) return;   // 変わっていないなら積まない
  UNDO.push(o); if(UNDO.length > 40) UNDO.shift();
  REDO.length = 0;
}
let lastSnap = 0;
function snapThrottled(){                                 // 打ち込み中に積み過ぎない
  const n = performance.now(); if(n - lastSnap < 600) return; lastSnap = n; snap();
}
function undo(){
  if(!UNDO.length){ stat('これ以上は戻れない'); return; }
  REDO.push(snapObj());
  const o = UNDO.pop();
  applyState(JSON.parse(o.j), ()=>stat('戻した'), o.imgs);
}
function redo(){
  if(!REDO.length){ stat('やり直すものが無い'); return; }
  UNDO.push(snapObj());
  const o = REDO.pop();
  applyState(JSON.parse(o.j), ()=>stat('やり直した'), o.imgs);
}
/* ⚠️ スナップショットは【操作の直前】に取る。capture フェーズで拾えば、
   実際の処理より先に必ず走る（＝押した瞬間の状態が残る）。 */
document.getElementById('panel').addEventListener('pointerdown', e=>{
  if(e.target.closest('button, input[type=range], input[type=color]')) snap();
}, true);
document.getElementById('panel').addEventListener('keydown', e=>{
  if(e.target.matches('input[type=range]')) snap();
}, true);
canvas.addEventListener('pointerdown', snap, true);       // アンカーを置く/引っぱる前
document.getElementById('txt').addEventListener('beforeinput', snapThrottled);
window.addEventListener('keydown', e=>{
  if(!(e.metaKey || e.ctrlKey) || (e.key||'').toLowerCase() !== 'z') return;
  // ⚠️ 打ち込み欄の中は、ブラウザの取り消しに任せる（横取りすると文字が戻せなくなる）
  if(/^(TEXTAREA|INPUT)$/.test(e.target.tagName)) return;
  e.preventDefault();
  if(e.shiftKey) redo(); else undo();
});

function resize(){ const dpr=Math.min(devicePixelRatio,2);
  // 描画バッファは canvas の実表示サイズ（CSSの二分割）に合わせる＝歪み/座標ズレを防ぐ
  canvas.width  = Math.round((canvas.clientWidth  || innerWidth ) * dpr);
  canvas.height = Math.round((canvas.clientHeight || innerHeight) * dpr); }
addEventListener('resize', ()=>layoutCanvas());
addEventListener('orientationchange', ()=>setTimeout(layoutCanvas,120));

(async ()=>{
  try{ await Promise.all(['"Zen Kaku Gothic New"','"Zen Old Mincho"'].map(f=>document.fonts.load(`900 80px ${f}`,'なんだ組漢')));
       await document.fonts.ready; }catch(_){}
  resize(); buildMesh(); bakeSheet(SHEETS[0]); fitFirstSheet(); refreshSheets(); updateOut();
  document.getElementById('stat').textContent = gl ? 'WEBGL OK' : 'NO WEBGL';
  requestAnimationFrame(draw);
})();

/* ══ 日本語 / English ══ 画面のテキストを走査して辞書で入れ替える。無いものは日本語のまま残す。 */
const I18N = {
  '字':'Text','ワープ（連続面）':'Warp (continuous surface)','3層（漢字・かな・カナ）':'3 layers (Kanji/Hira/Kata)',
  '変形（辺ごと）':'Transform (per edge)','アンカー（面を押す）':'Anchors (push the surface)',
  '文字ごと（伸ばす／すぼめる）':'Per character (stretch / narrow)','見え':'Look',
  '角ゴ':'Gothic','明朝':'Mincho','横':'Horizontal','縦':'Vertical',
  '字送り':'Tracking','行間':'Leading','大きさ':'Size','折返し':'Wrap',
  '上幅':'Top width','下幅':'Bottom width','左高':'Left height','右高':'Right height',
  '中幅':'Mid width','中高':'Mid height',
  'せん断X':'Shear X','せん断Y':'Shear Y','上ねじれ':'Twist top','下ねじれ':'Twist bottom',
  '効き幅':'Radius','強さ':'Strength','幅':'Width','高さ':'Height',
