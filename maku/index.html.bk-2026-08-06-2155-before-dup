/* ══ 版のリスト ══ 押した版が「いま触っている版」。字の設定・3層・文字ごとはその版に効く */
function refreshSheets(){
  const box = document.getElementById('sheets');
  box.innerHTML = '';
  SHEETS.forEach((s,i)=>{
    const b = document.createElement('button');
    b.textContent = s.kind === 'image' ? '画' : (([...(s.text||'')][0]) || '字');
    b.title = s.kind === 'image' ? '画像の版' : (s.text || '');
    if(i === curSheet) b.classList.add('on');
    b.onclick = ()=>{ curSheet = i; selChar = -1; refreshSheets(); };
    box.appendChild(b);
  });
  syncSheetUI();
}
function syncSheetUI(){
  const s = S_(); if(!s) return;
  document.body.classList.toggle('sheet-image', s.kind === 'image');
  const set = (id,v)=>{ const el=document.getElementById(id); if(!el) return;
    el.value = v; const t = el.parentElement.querySelector('.val'); if(t) t.textContent = el.value; };
  set('sx', s.x); set('sy', s.y); set('ss', Math.round(s.scale*100)); set('sr', s.rot);
  if(s.kind === 'text'){
    document.getElementById('txt').value = s.text;
    set('track', s.track); set('leading', s.leading);
    ['font','dir'].forEach(k=>document.querySelectorAll('#'+k+' button')
      .forEach(b=>b.classList.toggle('on', +b.dataset.v === s[k])));
  }
  refreshChars();
  if(typeof foldForKind === 'function') foldForKind(s.kind);
  const del = document.getElementById('delSheet');
  if(del) del.disabled = SHEETS.length <= 1;         // ⚠️ 最後の1枚は消さない（空の画面を作らない）
